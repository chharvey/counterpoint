from "core/vm" import ('Value::hash'); % TODO: export `$Value.hash` from VM
from "./String" import (String);



public class abstract Object {
	%%%
	Return a string representation of this object.
	A hook used internally in the `String()` constructor.
	@return a string representation of this object
	%%%
	public open '%%toString%%'(): str {
		return """<Object instance {{String('Value::hash'(this), 16)}}>""";
	}
}
