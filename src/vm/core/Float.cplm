from "cplvm" import ('::op::toFloat');



%%% Wrapper class for type `float` values. %%%
public class Float {
	public new (private readonly data: float) {;}
	public new (arg: int | nat) {
		this('::op::toFloat'(arg) as :float:);
	}

	internal toString(radix?: nat = +10): Result[str, RangeException] {
		if radix < +2 || +36 < radix then {
			return Fail[str, RangeException](RangeException("""Invalid radix: {{ radix }}. Must be between 2 and 36 (inclusive)."""));
		};
		throw "TODO: not yet supported";
	}
}
