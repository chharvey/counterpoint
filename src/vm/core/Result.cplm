from "./Object" import await (Object);



public class abstract enum Result[out T, out E? narrows Exception = Exception] extends Object {}



public class Fail[out T, out E? narrows Exception = Exception] extends Result[T, E] {
	public new (public readonly reason: E) {
		super();
	}
}



public class Ok[out T, out E? narrows Exception = Exception] extends Result[T, E] {
	public new (public readonly value: T) {
		super();
	}
}
