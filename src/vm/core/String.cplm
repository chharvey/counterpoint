from "core/vm" import (
	'op::isTuple',
	'op::isRecord',
);
from "./Object" import type (Object);
from "./Exception" import (Exception);



%%% Wrapper class for type `str` values. %%%
public class String {
	public new (private readonly data?: str = "") {;}
	public new (value: null | bool | sym) {
		this(value.toString());
	}
	public new (value: int | nat | float, radix?: nat = +10) {
		this(value.toString(radix)~!);
	}
	public new (refobj: Object) {
		this(refobj.'%%toString%%'());
	}
	public new (arg: anything) {
		if 'op::isTuple'(arg) as :bool: then {
			% loop through tuple internal array and stringify each value
			panic Exception("TODO: not yet supported");
		} else if 'op::isRecord'(arg) as :bool: then {
			% loop through record internal array and stringify each property
			panic Exception("TODO: not yet supported");
		};
	}
}
