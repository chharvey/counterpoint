{
	"compilerOptions": {
		// Type Checking
		"exactOptionalPropertyTypes":         true,
		"noImplicitOverride":                 true,
		"noImplicitReturns":                  true,
		"noPropertyAccessFromIndexSignature": true,
		"noUnusedLocals":                     true,
		"noUnusedParameters":                 true,
		"strict":                             true,

		// Modules
		"module": "node16",

		// Emit
		"noEmitOnError": true,
		"outDir":        "./build/",

		// Interop Constraints
		"allowSyntheticDefaultImports": true,

		// Language and Environment
		"target": "es2022",

		// Completeness
		"skipLibCheck": true,
	},
	"include": ["./src/"],
}
