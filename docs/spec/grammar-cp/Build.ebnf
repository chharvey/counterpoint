Sequence<Instruction> Build(Null n) :=
	1. *Return:* ["Push `0` onto the operand stack."].
;

Sequence<Instruction> Build(Boolean b) :=
	1. *If* `b` is `true`:
		1. *Return:* ["Push `1` onto the operand stack."].
	2. *Assert:* `b` is `false`.
	3. *Return:* ["Push `0` onto the operand stack."].
;

Sequence<Instruction> Build(Symbol s) :=
	1. *Return:* ["Push `n.id` onto the operand stack."].
;

Sequence<Instruction> Build(Number n) :=
	1. *Return:* ["Push `n` onto the operand stack."].
;

Sequence<Instruction> Build(String s) :=
	// TO BE DETERMINED
;

Sequence<Instruction> Build(Collection c) :=
	// TO BE DETERMINED
;



Sequence<Instruction> Build(SemanticExpression expr) :=
	1. *Let* `folded` be `ValueOf(expr)`.
	2. *If* `folded` is an abrupt completion:
		1. *Return:* `BuildExpression(expr)`.
	3. *Assert:* `folded.value` is set.
	4. *Return:* `Build(folded.value)`.
;



Sequence<Instruction> Build(SemanticStatementExpression stmt) :=
	1. *If* `stmt.children.count` is greater than 0:
		1. *Return:* `Build(stmt.children.0)`.
	2. *Return:* [].
;



Sequence<Instruction> Build(SemanticStatementClaim claim) :=
	1. *Return:* [].
;



Sequence<Instruction> Build(SemanticStatementReassignment assign) :=
	1. *Assert:* `assign.children.count` is 2.
	2. *Let* `name` be the string-concatenation of "glb" and `assign.children.0.id`.
	3. *Let* `instrs` be *UnwrapAffirm:* `Build(assign.childen.1)`.
	4. *Return:* [
		...instrs,
		"SET the global variable `name`.",
	].
;



Sequence<Instruction> Build(SemanticStatementConditional stmt) :=
	1. *Assert:* `stmt.children.count` is greater than 1.
	2. *Let* `instrs0` be *UnwrapAffirm:* `Build(stmt.children.0)`.
	3. *If* `stmt.unless` is `true`:
		1. Append "NOT" to `instrs0`.
	4. *Let* `instrs1` be *UnwrapAffirm:* `Build(stmt.children.1)`.
	5. *If* `stmt.children.count` is 3:
		1. *Let* `instrs2` be *UnwrapAffirm:* `Build(expr.children.2)`.
	6. *Else:*
		1. *Let* `instrs2` be [].
	7. *Return:* [
		...instrs0,
		"IF",
		...instrs1,
		"ELSE",
		...instrs2,
		"END",
	].
;



Sequence<Instruction> Build(SemanticStatementLoop stmt) :=
	1. *Assert:* `stmt.children.count` is 2.
	2. *Let* `instrs0` be *UnwrapAffirm:* `Build(stmt.children.0)`.
	3. *If* `stmt.until` is `true`:
		1. Append "NOT" to `instrs0`.
	4. *Let* `instrs1` be *UnwrapAffirm:* `Build(stmt.children.1)`.
	5. *If* `stmt.doFirst` is `true`:
		1. *Return:* [
			"BLOCK",
			"LOOP",
			...instrs1,
			...instrs0,
			"NOT",
			"BRANCH_IF"(1),
			"BRANCH"(0),
			"END",
			"END",
		].
	6. *Else:*
		1. *Return:* [
			"BLOCK",
			"LOOP",
			...instrs0,
			"NOT",
			"BRANCH_IF"(1),
			...instrs1,
			"BRANCH"(0),
			"END",
			"END",
		].
;



