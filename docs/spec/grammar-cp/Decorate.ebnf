_KEYWORD_OTHER =:=
	// operator
		| "mut"
		| "as"
		| "is"
		| "if"
		| "then"
		| "else"
	// storage
		| "type"
		| "let"
		| "_"
	// modifier
		| "var"
;

Decorate(Word ::= _KEYWORD_OTHER) -> SemanticKey
	:= (SemanticKey[id=TokenWorth(_KEYWORD_OTHER)]);
Decorate(Word ::= IDENTIFIER) -> SemanticKey
	:= (SemanticKey[id=TokenWorth(IDENTIFIER)]);
Decorate(Word ::= KeywordType) -> SemanticKey
	:= (SemanticKey[id=TokenId(KeywordType)]);
Decorate(Word ::= KeywordValue) -> SemanticKey
	:= (SemanticKey[id=TokenId(KeywordValue)]);



Decorate(PrimitiveLiteral ::= INTEGER) -> SemanticConstant
	:= (SemanticConstant[value=Integer(TokenWorth(INTEGER))]);
Decorate(PrimitiveLiteral ::= NATURAL) -> SemanticConstant
	:= (SemanticConstant[value=Integer(TokenWorth(NATURAL))]);
Decorate(PrimitiveLiteral ::= FLOAT) -> SemanticConstant
	:= (SemanticConstant[value=Float(TokenWorth(FLOAT))]);
Decorate(PrimitiveLiteral ::= STRING) -> SemanticConstant
	:= (SemanticConstant[value=String(TokenWorth(STRING))]);
Decorate(PrimitiveLiteral ::= KeywordValue) -> SemanticConstant
	:= (SemanticConstant[value=KeywordValue(KeywordValue)]);
Decorate(PrimitiveLiteral ::= "@" Word) -> SemanticConstant
	:= (SemanticConstant[value=Symbol(Decorate(Word).id)]);



Decorate(EntryType<-Named><-Optional> ::= Type) -> SemanticItemType
	:= (SemanticItemType[optional=false] Decorate(Type));
Decorate(EntryType<-Named><+Optional> ::= "?:" Type) -> SemanticItemType
	:= (SemanticItemType[optional=true] Decorate(Type));
Decorate(EntryType<+Named><-Optional> ::= Word ":" Type) -> SemanticPropertyType
	:= (SemanticPropertyType[optional=false]
		Decorate(Word)
		Decorate(Type)
	);
Decorate(EntryType<+Named><+Optional> ::= Word "?:" Type) -> SemanticPropertyType
	:= (SemanticPropertyType[optional=true]
		Decorate(Word)
		Decorate(Type)
	);



Decorate(ItemsType ::= ","? EntryType<-Named><+Optional># ","?) -> Sequence<SemanticItemType>
	:= ParseList(EntryType<-Named><+Optional>, SemanticItemType);
Decorate(ItemsType ::= EntryType<-Named><-Optional> ",") -> Sequence<SemanticItemType>
	:= [Decorate(EntryType<-Named><-Optional>)];
Decorate(ItemsType ::= EntryType<-Named><-Optional> "," EntryType<-Named><+Optional># ","?) -> Sequence<SemanticItemType>
	:= [
		Decorate(EntryType<-Named><-Optional>),
		...ParseList(EntryType<-Named><+Optional>, SemanticItemType),
	];
Decorate(ItemsType ::= "," EntryType<-Named><-Optional># ","?) -> Sequence<SemanticItemType>
	:= ParseList(EntryType<-Named><-Optional>, SemanticItemType);
Decorate(ItemsType ::= "," EntryType<-Named><-Optional># "," EntryType<-Named><+Optional># ","?) -> Sequence<SemanticItemType>
	:= [
		...ParseList(EntryType<-Named><-Optional>, SemanticItemType),
		...ParseList(EntryType<-Named><+Optional>, SemanticItemType),
	];
Decorate(ItemsType ::= EntryType<-Named><-Optional>__0 "," EntryType<-Named><-Optional>__1# ","?) -> Sequence<SemanticItemType>
	:= [
		Decorate(EntryType<-Named><-Optional>__0),
		...ParseList(EntryType<-Named><-Optional>__1, SemanticItemType),
	];
Decorate(ItemsType ::= EntryType<-Named><-Optional>__0 "," EntryType<-Named><-Optional>__1# "," EntryType<-Named><+Optional># ","?) -> Sequence<SemanticItemType>
	:= [
		Decorate(EntryType<-Named><-Optional>__0),
		...ParseList(EntryType<-Named><-Optional>__1, SemanticItemType),
		...ParseList(EntryType<-Named><+Optional>,    SemanticItemType),
	];



Decorate(PropertiesType ::= ","? EntryType<+Named><-Optional># ","?) -> Sequence<SemanticPropertyType>
	:= ParseList(EntryType<+Named><-Optional>, SemanticPropertyType);
Decorate(PropertiesType ::= ","? EntryType<+Named><+Optional># ","?) -> Sequence<SemanticPropertyType>
	:= ParseList(EntryType<+Named><+Optional>, SemanticPropertyType);



Decorate(PropertyAccessorType ::= INTEGER) -> SemanticIndex
	:= (SemanticIndex[index=TokenWorth(INTEGER)]);
Decorate(PropertyAccessorType ::= NATURAL) -> SemanticIndex
	:= (SemanticIndex[index=TokenWorth(NATURAL)]);
Decorate(PropertyAccessorType ::= Word) -> SemanticKey
	:= Decorate(Word);



Decorate(TypeGrouped ::= "(" Type ")") -> SemanticType
	:= Decorate(Type);

Decorate(TypeTupleLiteral ::= "(" ")") -> SemanticTypeTuple
	:= (SemanticTypeTuple);
Decorate(TypeTupleLiteral ::= "(" ItemsType ")") -> SemanticTypeTuple
	:= (SemanticTypeTuple
		...Decorate(ItemsType)
	);

Decorate(TypeRecordLiteral ::= "(" PropertiesType ")") -> SemanticTypeRecord
	:= (SemanticTypeRecord
		...Decorate(PropertiesType)
	);

Decorate(TypeListLiteral ::= "[" Type "]") -> SemanticTypeList
	:= (SemanticTypeList
		...Decorate(Type)
	);

Decorate(TypeDictLiteral ::= "[" ":" Type "]") -> SemanticTypeDict
	:= (SemanticTypeDict
		Decorate(Type)
	);

Decorate(TypeSetLiteral ::= "{" Type "}") -> SemanticTypeSet
	:= (SemanticTypeSet
		...Decorate(Type)
	);

Decorate(TypeMapLiteral ::= "{" Type__0 "->" Type__1 "}") -> SemanticTypeMap
	:= (SemanticTypeMap
		Decorate(Type__0)
		Decorate(Type__1)
	);

Decorate(GenericArguments ::= "<" ","? Type# ","? ">") -> Sequence<SemanticType>
	:= ParseList(Type, SemanticType);



Decorate(TypeUnit ::= IDENTIFIER) -> SemanticTypeAlias
	:= (SemanticTypeAlias[id=TokenWorth(IDENTIFIER)]);
Decorate(TypeUnit ::= KeywordType) -> SemanticTypeConstant
	:= (SemanticTypeConstant[value=KeywordType(KeywordType)]);
Decorate(TypeUnit ::= PrimitiveLiteral) -> SemanticTypeConstant
	:= (SemanticTypeConstant[value=ToType(Decorate(PrimitiveLiteral).value)]);
Decorate(TypeUnit ::= TypeGrouped) -> SemanticType
	:= Decorate(TypeGrouped);
Decorate(TypeUnit ::= TypeTupleLiteral) -> SemanticTypeTuple
	:= Decorate(TypeTupleLiteral);
Decorate(TypeUnit ::= TypeRecordLiteral) -> SemanticTypeRecord
	:= Decorate(TypeRecordLiteral);
Decorate(TypeUnit ::= TypeListLiteral) -> SemanticTypeList
	:= Decorate(TypeListLiteral);
Decorate(TypeUnit ::= TypeDictLiteral) -> SemanticTypeDict
	:= Decorate(TypeDictLiteral);
Decorate(TypeUnit ::= TypeSetLiteral) -> SemanticTypeSet
	:= Decorate(TypeSetLiteral);
Decorate(TypeUnit ::= TypeMapLiteral) -> SemanticTypeMap
	:= Decorate(TypeMapLiteral);



Decorate(TypeCompound ::= TypeUnit) -> SemanticType
	:= Decorate(TypeUnit);
Decorate(TypeCompound ::= TypeCompound "." PropertyAccessorType) -> SemanticTypeAccess
	:= (SemanticTypeAccess[kind=NORMAL]
		Decorate(TypeCompound)
		Decorate(PropertyAccessorType)
	);
Decorate(TypeCompound ::= TypeCompound "?." PropertyAccessorType) -> SemanticTypeAccess
	:= (SemanticTypeAccess[kind=MAYBE]
		Decorate(TypeCompound)
		Decorate(PropertyAccessorType)
	);
Decorate(TypeCompound ::= TypeCompound "." GenericArguments) -> SemanticTypeCall
	:= (SemanticTypeCall
		Decorate(TypeCompound)
		...Decorate(GenericArguments)
	);



Decorate(TypeUnarySymbol ::= TypeCompound) -> SemanticType
	:= Decorate(TypeCompound);
Decorate(TypeUnarySymbol ::= TypeUnarySymbol "?") -> SemanticTypeOperation
	:= (SemanticTypeOperation[operator=ORNULL]
		Decorate(TypeUnarySymbol)
	);
Decorate(TypeUnarySymbol ::= TypeUnarySymbol "!") -> SemanticTypeOperation
	:= (SemanticTypeOperation[operator=OREXCP]
		Decorate(TypeUnarySymbol)
	);



Decorate(TypeUnaryKeyword ::= TypeUnarySymbol) -> SemanticType
	:= Decorate(TypeUnarySymbol);
Decorate(TypeUnaryKeyword ::= "mut" TypeUnaryKeyword) -> SemanticTypeOperation
	:= (SemanticTypeOperation[operator=MUTABLE]
		Decorate(TypeUnaryKeyword)
	);



Decorate(TypeIntersection ::= TypeUnaryKeyword) -> SemanticType
	:= Decorate(TypeUnaryKeyword);
Decorate(TypeIntersection ::= TypeIntersection "&" TypeUnaryKeyword) -> SemanticTypeOperation
	:= (SemanticTypeOperation[operator=AND]
		Decorate(TypeIntersection)
		Decorate(TypeUnaryKeyword)
	);



Decorate(TypeUnion ::= TypeIntersection) -> SemanticType
	:= Decorate(TypeIntersection);
Decorate(TypeUnion ::= TypeUnion "|" TypeIntersection) -> SemanticTypeOperation
	:= (SemanticTypeOperation[operator=OR]
		Decorate(TypeUnion)
		Decorate(TypeIntersection)
	);



Decorate(Type ::= TypeUnion) -> SemanticType
	:= Decorate(TypeUnion);



Decorate(StringTemplate<Break> ::= TEMPLATE_FULL) -> SemanticTemplate
	:= (SemanticTemplate
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_FULL))])
	);
Decorate(StringTemplate<Break> ::= TEMPLATE_HEAD TEMPLATE_TAIL) -> SemanticTemplate
	:= (SemanticTemplate
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_HEAD))])
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_TAIL))])
	);
Decorate(StringTemplate<Break> ::= TEMPLATE_HEAD Expression<+Block><?Break> TEMPLATE_TAIL) -> SemanticTemplate
	:= (SemanticTemplate
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_HEAD))])
		Decorate(Expression<+Block><?Break>)
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_TAIL))])
	);
Decorate(StringTemplate<Break> ::= TEMPLATE_HEAD StringTemplate__0__List TEMPLATE_TAIL) -> SemanticTemplate
	:= (SemanticTemplate
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_HEAD))])
		...Decorate(StringTemplate__0__List)
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_TAIL))])
	);
Decorate(StringTemplate<Break> ::= TEMPLATE_HEAD Expression<+Block><?Break> StringTemplate__0__List TEMPLATE_TAIL) -> SemanticTemplate
	:= (SemanticTemplate
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_HEAD))])
		Decorate(Expression<+Block><?Break>)
		...Decorate(StringTemplate__0__List)
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_TAIL))])
	);

	Decorate(StringTemplate__0__List<Break> ::= TEMPLATE_MIDDLE) -> Vector<SemanticConstant>
		:= [SemanticConstant[value=String(TokenWorth(TEMPLATE_MIDDLE))]];
	Decorate(StringTemplate__0__List<Break> ::= TEMPLATE_MIDDLE Expression<+Block><?Break>) -> Vector<SemanticConstant, SemanticExpression>
		:= [
			(SemanticConstant[value=String(TokenWorth(TEMPLATE_MIDDLE))]),
			Decorate(Expression<+Block><?Break>),
		];
	Decorate(StringTemplate__0__List<Break> ::= StringTemplate__0__List TEMPLATE_MIDDLE) -> Sequence<...Vector<SemanticConstant, SemanticExpression?>>
		:= [
			...Decorate(StringTemplate__0__List),
			(SemanticConstant[value=String(TokenWorth(TEMPLATE_MIDDLE))]),
		];
	Decorate(StringTemplate__0__List<Break> ::= StringTemplate__0__List TEMPLATE_MIDDLE Expression<+Block><?Break>) -> Sequence<...Vector<SemanticConstant, SemanticExpression?>>
		:= [
			...Decorate(StringTemplate__0__List),
			(SemanticConstant[value=String(TokenWorth(TEMPLATE_MIDDLE))]),
			Decorate(Expression<+Block><?Break>),
		];



Decorate(Items<Break> ::= Expression<+Block><?Break> ",") -> Sequence<SemanticExpression>
	:= [Decorate(Expression<+Block><?Break>)];
Decorate(Items<Break> ::= "," Expression<+Block><?Break># ","?) -> Sequence<SemanticExpression>
	:= ParseList(Expression<+Block><?Break>, SemanticExpression);
Decorate(Items<Break> ::= Expression__0<+Block><?Break> "," Expression__1<+Block><?Break># ","?) -> Sequence<SemanticExpression>
	:= [
		Decorate(Expression__0<+Block><?Break>),
		...ParseList(Expression__1<+Block><?Break>, SemanticExpression),
	];

Decorate(Property<Break> ::= Word "=" Expression<+Block><?Break>) -> SemanticProperty
	:= (SemanticProperty
		Decorate(Word)
		Decorate(Expression<+Block><?Break>)
	);

Decorate(Case<Break> ::= Expression<+Block><?Break> "->" Expression<+Block><?Break>) -> SemanticCase
	:= (SemanticCase
		Decorate(Expression<+Block><?Break>)
		Decorate(Expression<+Block><?Break>)
	);



Decorate(PropertyAccessor<Break> ::= INTEGER) -> SemanticIndex
	:= (SemanticIndex[index=TokenWorth(INTEGER)]);
Decorate(PropertyAccessor<Break> ::= NATURAL) -> SemanticIndex
	:= (SemanticIndex[index=TokenWorth(NATURAL)]);
Decorate(PropertyAccessor<Break> ::= Word) -> SemanticKey
	:= Decorate(Word);
Decorate(PropertyAccessor<Break> ::= "[" Expression<+Block><?Break> "]") -> SemanticExpression
	:= Decorate(Expression<+Block><-Break>);



Decorate(ExpressionGrouped<Break> ::= "(" Expression<+Block><?Break> ")") -> SemanticExpression
	:= Decorate(Expression<+Block><?Break>);

Decorate(TupleLiteral<Break> ::= "(" ")") -> SemanticTuple
	:= (SemanticTuple);
Decorate(TupleLiteral<Break> ::= "(" Items<?Break> ")") -> SemanticTuple
	:= (SemanticTuple
		...Decorate(Items<?Break>)
	);

Decorate(RecordLiteral<Break> ::= "(" ","? Property<?Break># ","? ")") -> SemanticRecord
	:= (SemanticRecord
		...ParseList(Property<?Break>, SemanticProperty)
	);

Decorate(ListLiteral<Break> ::= "[" "]") -> SemanticList
	:= (SemanticList);
Decorate(ListLiteral<Break> ::= "[" (","? Expression<+Block><?Break># ","?)? "]") -> SemanticList
	:= (SemanticList
		...ParseList(Expression<+Block><?Break>, SemanticExpression)
	);

Decorate(DictLiteral<Break> ::= [" ","? Property<?Break># ","? "]") -> SemanticDict
	:= (SemanticDict
		...ParseList(Property<?Break>, SemanticProperty)
	);

Decorate(SetLiteral<Break> ::= "{" "}") -> SemanticSet
	:= (SemanticSet);
Decorate(SetLiteral<Break> ::= "{" (","? Expression<+Block><?Break># ","?)? "}") -> SemanticSet
	:= (SemanticSet
		...ParseList(Expression<+Block><?Break>, SemanticExpression)
	);

Decorate(MapLiteral<Break> ::= "{" ","? Case<?Break># ","? "}") -> SemanticMap
	:= (SemanticMap
		...ParseList(Case<?Break>, SemanticCase)
	);

Decorate(FunctionArguments<Break> ::= "(" (","? Expression<+Block><?Break># ","?)? ")") -> Sequence<SemanticExpression>
	:= ParseList(Expression<+Block><?Break>, SemanticExpression);



Decorate(ExpressionUnit<Block, Break> ::= IDENTIFIER) -> SemanticVariable
	:= (SemanticVariable[id=TokenWorth(IDENTIFIER)]);
Decorate(ExpressionUnit<Block, Break> ::= PrimitiveLiteral) -> SemanticConstant
	:= Decorate(PrimitiveLiteral);
Decorate(ExpressionUnit<Block, Break> ::= StringTemplate<?Break>) -> SemanticTemplate
	:= Decorate(StringTemplate<?Break>);
Decorate(ExpressionUnit<Block, Break> ::= ExpressionGrouped<?Break>) -> SemanticExpression
	:= Decorate(ExpressionGrouped<?Break>);
Decorate(ExpressionUnit<Block, Break> ::= TupleLiteral<?Break>) -> SemanticTuple
	:= Decorate(TupleLiteral<?Break>);
Decorate(ExpressionUnit<Block, Break> ::= RecordLiteral<?Break>) -> SemanticRecord
	:= Decorate(RecordLiteral<?Break>);
Decorate(ExpressionUnit<Block, Break> ::= ListLiteral<?Break>) -> SemanticList
	:= Decorate(ListLiteral<?Break>);
Decorate(ExpressionUnit<Block, Break> ::= DictLiteral<?Break>) -> SemanticDict
	:= Decorate(DictLiteral<?Break>);
Decorate(ExpressionUnit<Block, Break> ::= SetLiteral<?Break>) -> SemanticSet
	:= Decorate(SetLiteral<?Break>);
Decorate(ExpressionUnit<Block, Break> ::= MapLiteral<?Break>) -> SemanticMap
	:= Decorate(MapLiteral<?Break>);
Decorate(ExpressionUnit<Block, Break> ::= Block<?Break>) -> SemanticExpressionBlock
	:= (SemanticExpressionBlock Decorate(Block<?Break>));



Decorate(ExpressionCompound<Block, Break> ::= ExpressionUnit<?Block><?Break>) -> SemanticExpression
	:= Decorate(ExpressionUnit<?Block><?Break>);
Decorate(ExpressionCompound<Block, Break> ::= ExpressionCompound<?Block><?Break> "." PropertyAccessor<?Break>) -> SemanticAccess
	:= (SemanticAccess[kind=NORMAL]
		Decorate(ExpressionCompound<?Block><?Break>)
		Decorate(PropertyAccessor<?Break>)
	);
Decorate(ExpressionCompound<Block, Break> ::= ExpressionCompound<?Block><?Break> "?." PropertyAccessor<?Break>) -> SemanticAccess
	:= (SemanticAccess[kind=MAYBE]
		Decorate(ExpressionCompound<?Block><?Break>)
		Decorate(PropertyAccessor<?Break>)
	);
Decorate(ExpressionCompound<Block, Break> ::= ExpressionCompound<?Block><?Break> "!." PropertyAccessor<?Break>) -> SemanticAccess
	:= (SemanticAccess[kind=RESULT]
		Decorate(ExpressionCompound<?Block><?Break>)
		Decorate(PropertyAccessor<?Break>)
	);
Decorate(ExpressionCompound<Block, Break> ::= ExpressionCompound<?Block><?Break> "." FunctionArguments<?Break>) -> SemanticCall
	:= (SemanticCall
		Decorate(ExpressionCompound<?Block><?Break>)
		...Decorate(FunctionArguments<?Break>)
	);
Decorate(ExpressionCompound<Block, Break> ::= ExpressionCompound<?Block><?Break> "." GenericArguments FunctionArguments<?Break>) -> SemanticCall
	:= (SemanticCall
		Decorate(ExpressionCompound<?Block><?Break>)
		...Decorate(GenericArguments)
		...Decorate(FunctionArguments<?Break>)
	);



Decorate(ExpressionUnarySymbol<Block, Break> ::= ExpressionCompound<?Block><?Break>) -> SemanticExpression
	:= Decorate(ExpressionCompound<?Block><?Break>);
Decorate(ExpressionUnarySymbol<Block, Break> ::= "!" ExpressionUnarySymbol<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		Decorate(ExpressionUnarySymbol<?Block><?Break>)
	);
Decorate(ExpressionUnarySymbol<Block, Break> ::= "?" ExpressionUnarySymbol<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=EMP]
		Decorate(ExpressionUnarySymbol<?Block><?Break>)
	);
Decorate(ExpressionUnarySymbol<Block, Break> ::= "+" ExpressionUnarySymbol<?Block><?Break>) -> SemanticExpression
	:= Decorate(ExpressionUnarySymbol<?Block><?Break>);
Decorate(ExpressionUnarySymbol<Block, Break> ::= "-" ExpressionUnarySymbol<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=NEG]
		Decorate(ExpressionUnarySymbol<?Block><?Break>)
	);



Decorate(ExpressionUnaryKeyword<Block, Break> ::= ExpressionUnarySymbol<?Block><?Break>) -> SemanticExpression
	:= Decorate(ExpressionUnarySymbol<?Block><?Break>);
Decorate(ExpressionUnaryKeyword<Block, Break> ::= "int" ExpressionUnaryKeyword<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=INT]
		Decorate(ExpressionUnaryKeyword<?Block><?Break>)
	);
Decorate(ExpressionUnaryKeyword<Block, Break> ::= "float" ExpressionUnaryKeyword<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=FLOAT]
		Decorate(ExpressionUnaryKeyword<?Block><?Break>)
	);



Decorate(ExpressionCast<Block, Break> ::= ExpressionUnaryKeyword<?Block><?Break>) -> SemanticExpression
	:= Decorate(ExpressionUnaryKeyword<?Block><?Break>);
Decorate(ExpressionCast<Block, Break> ::= ExpressionCast<?Block><?Break> "as" ExpressionUnaryKeyword<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=CAST]
		Decorate(ExpressionCast<?Block><?Break>)
		Decorate(ExpressionUnaryKeyword<?Block><?Break>)
	);
Decorate(ExpressionCast<Block, Break> ::= ExpressionCast<?Block><?Break> "as?" ExpressionUnaryKeyword<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=MAYBE]
		Decorate(ExpressionCast<?Block><?Break>)
		Decorate(ExpressionUnaryKeyword<?Block><?Break>)
	);
Decorate(ExpressionCast<Block, Break> ::= ExpressionCast<?Block><?Break> "as!" ExpressionUnaryKeyword<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=RESULT]
		Decorate(ExpressionCast<?Block><?Break>)
		Decorate(ExpressionUnaryKeyword<?Block><?Break>)
	);
Decorate(ExpressionCast<Block, Break> ::= ExpressionCast<?Block><?Break> "as" "<" Type ">") -> SemanticClaim
	:= (SemanticClaim
		Decorate(ExpressionCast<?Block><?Break>)
		Decorate(Type)
	);



Decorate(ExpressionExponential<Block, Break> ::= ExpressionCast<?Block><?Break>) -> SemanticExpression
	:= Decorate(ExpressionCast<?Block><?Break>);
Decorate(ExpressionExponential<Block, Break> ::= ExpressionCast<?Block><?Break> "^" ExpressionExponential<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=EXP]
		Decorate(ExpressionCast<?Block><?Break>)
		Decorate(ExpressionExponential<?Block><?Break>)
	);



Decorate(ExpressionMultiplicative<Block, Break> ::= ExpressionExponential<?Block><?Break>) -> SemanticExpression
	:= Decorate(ExpressionExponential<?Block><?Break>);
Decorate(ExpressionMultiplicative<Block, Break> ::= ExpressionMultiplicative<?Block><?Break> "*" ExpressionExponential<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=MUL]
		Decorate(ExpressionMultiplicative<?Block><?Break>)
		Decorate(ExpressionExponential<?Block><?Break>)
	);
Decorate(ExpressionMultiplicative<Block, Break> ::= ExpressionMultiplicative<?Block><?Break> "/" ExpressionExponential<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=DIV]
		Decorate(ExpressionMultiplicative<?Block><?Break>)
		Decorate(ExpressionExponential<?Block><?Break>)
	);



Decorate(ExpressionAdditive<Block, Break> ::= ExpressionMultiplicative<?Block><?Break>) -> SemanticExpression
	:= Decorate(ExpressionMultiplicative<?Block><?Break>);
Decorate(ExpressionAdditive<Block, Break> ::= ExpressionAdditive<?Block><?Break> "+" ExpressionMultiplicative<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=ADD]
		Decorate(ExpressionAdditive<?Block><?Break>)
		Decorate(ExpressionMultiplicative<?Block><?Break>)
	);
Decorate(ExpressionAdditive<Block, Break> ::= ExpressionAdditive<?Block><?Break> "-" ExpressionMultiplicative<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=SUB]
		Decorate(ExpressionAdditive<?Block><?Break>)
		Decorate(ExpressionMultiplicative<?Block><?Break>)
	);



Decorate(ExpressionComparative<Block, Break> ::= ExpressionAdditive<?Block><?Break>) -> SemanticOperation
	:= Decorate(ExpressionAdditive<?Block><?Break>);
Decorate(ExpressionComparative<Block, Break> ::= ExpressionComparative<?Block><?Break> "<" ExpressionAdditive<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=LT]
		Decorate(ExpressionComparative<?Block><?Break>)
		Decorate(ExpressionAdditive<?Block><?Break>)
	);
Decorate(ExpressionComparative<Block, Break> ::= ExpressionComparative<?Block><?Break> ">" ExpressionAdditive<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=GT]
		Decorate(ExpressionComparative<?Block><?Break>)
		Decorate(ExpressionAdditive<?Block><?Break>)
	);
Decorate(ExpressionComparative<Block, Break> ::= ExpressionComparative<?Block><?Break> "<=" ExpressionAdditive<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=LE]
		Decorate(ExpressionComparative<?Block><?Break>)
		Decorate(ExpressionAdditive<?Block><?Break>)
	);
Decorate(ExpressionComparative<Block, Break> ::= ExpressionComparative<?Block><?Break> ">=" ExpressionAdditive<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=GE]
		Decorate(ExpressionComparative<?Block><?Break>)
		Decorate(ExpressionAdditive<?Block><?Break>)
	);
Decorate(ExpressionComparative<Block, Break> ::= ExpressionComparative<?Block><?Break> "!<" ExpressionAdditive<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=LT]
			Decorate(ExpressionComparative<?Block><?Break>)
			Decorate(ExpressionAdditive<?Block><?Break>)
		)
	);
Decorate(ExpressionComparative<Block, Break> ::= ExpressionComparative<?Block><?Break> "!>" ExpressionAdditive<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=GT]
			Decorate(ExpressionComparative<?Block><?Break>)
			Decorate(ExpressionAdditive<?Block><?Break>)
		)
	);
Decorate(ExpressionComparative<Block, Break> ::= ExpressionComparative<?Block><?Break> "is" ExpressionAdditive<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=IS]
		Decorate(ExpressionComparative<?Block><?Break>)
		Decorate(ExpressionAdditive<?Block><?Break>)
	);
Decorate(ExpressionComparative<Block, Break> ::= ExpressionComparative<?Block><?Break> "!is" ExpressionAdditive<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=IS]
			Decorate(ExpressionComparative<?Block><?Break>)
			Decorate(ExpressionAdditive<?Block><?Break>)
		)
	);



Decorate(ExpressionEquality<Block, Break> ::= ExpressionComparative<?Block><?Break>) -> SemanticOperation
	:= Decorate(ExpressionComparative<?Block>);
Decorate(ExpressionEquality<Block, Break> ::= ExpressionEquality<?Block><?Break> "===" ExpressionComparative<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=ID]
		Decorate(ExpressionEquality<?Block><?Break>)
		Decorate(ExpressionComparative<?Block><?Break>)
	);
Decorate(ExpressionEquality<Block, Break> ::= ExpressionEquality<?Block><?Break> "!==" ExpressionComparative<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=ID]
			Decorate(ExpressionEquality<?Block><?Break>)
			Decorate(ExpressionComparative<?Block><?Break>)
		)
	);
Decorate(ExpressionEquality<Block, Break> ::= ExpressionEquality<?Block><?Break> "==" ExpressionComparative<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=EQ]
		Decorate(ExpressionEquality<?Block><?Break>)
		Decorate(ExpressionComparative<?Block><?Break>)
	);
Decorate(ExpressionEquality<Block, Break> ::= ExpressionEquality<?Block><?Break> "!=" ExpressionComparative<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=EQ]
			Decorate(ExpressionEquality<?Block><?Break>)
			Decorate(ExpressionComparative<?Block><?Break>)
		)
	);



Decorate(ExpressionConjunctive<Block, Break> ::= ExpressionEquality<?Block><?Break>) -> SemanticExpression
	:= Decorate(ExpressionEquality<?Block><?Break>);
Decorate(ExpressionConjunctive<Block, Break> ::= ExpressionConjunctive<?Block><?Break> "&&" ExpressionEquality<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=AND]
		Decorate(ExpressionConjunctive<?Block><?Break>)
		Decorate(ExpressionEquality<?Block><?Break>)
	);
Decorate(ExpressionConjunctive<Block, Break> ::= ExpressionConjunctive<?Block><?Break> "!&" ExpressionEquality<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=AND]
			Decorate(ExpressionConjunctive<?Block><?Break>)
			Decorate(ExpressionEquality<?Block><?Break>)
		)
	);



Decorate(ExpressionDisjunctive<Block, Break> ::= ExpressionConjunctive<?Block><?Break>) -> SemanticOperation
	:= Decorate(ExpressionConjunctive<?Block><?Break>);
Decorate(ExpressionDisjunctive<Block, Break> ::= ExpressionDisjunctive<?Block><?Break> "||" ExpressionConjunctive<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=OR]
		Decorate(ExpressionDisjunctive<?Block><?Break>)
		Decorate(ExpressionConjunctive<?Block><?Break>)
	);
Decorate(ExpressionDisjunctive<Block, Break> ::= ExpressionDisjunctive<?Block><?Break> "!|" ExpressionConjunctive<?Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=OR]
			Decorate(ExpressionDisjunctive<?Block><?Break>)
			Decorate(ExpressionConjunctive<?Block><?Break>)
		)
	);



Decorate(ExpressionConditional<Break> ::= "if" Expression__0<+Block><?Break> "then" Expression__1<-Block><?Break> "else" Expression__2<-Block><?Break>) -> SemanticOperation
	:= (SemanticOperation[operator=COND]
		Decorate(Expression__0<+Block><?Break>)
		Decorate(Expression__1<-Block><?Break>)
		Decorate(Expression__2<-Block><?Break>)
	);



Decorate(Expression<Block, Break> ::= ExpressionDisjunctive<?Block><?Break>) -> SemanticExpression
	:= Decorate(ExpressionDisjunctive<?Block><?Break>);
Decorate(Expression<Block, Break> ::= ExpressionConditional) -> SemanticExpression
	:= Decorate(ExpressionConditional);



Decorate(Assignee<Break> ::= IDENTIFIER) -> SemanticVariable
	:= (SemanticVariable[id=TokenWorth(IDENTIFIER)]);
Decorate(Assignee<Break> ::= ExpressionCompound<+Block><?Break> "." PropertyAccessor<?Break>) -> SemanticAccess
	:= (SemanticAccess[kind=NORMAL]
		Decorate(ExpressionCompound<+Block><?Break>)
		Decorate(PropertyAccessor<?Break>)
	);



Decorate(StatementExpression<Break> ::= ";") -> SemanticStatementExpression
	:= (SemanticStatementExpression);
Decorate(StatementExpression<Break> ::= Expression<+Block><?Break> ";") -> SemanticStatementExpression
	:= (SemanticStatementExpression Decorate(Expression<+Block><?Break>));



Decorate(StatementClaim<Break> ::= "claim" Assignee<?Break> ":" Type ";") -> SemanticStatementClaim
	:= (SemanticStatementClaim
		Decorate(Assignee<?Break>)
		Decorate(Type)
	);



Decorate(StatementReassignment<Break> ::= "set" Assignee<?Break> "=" Expression<+Block><?Break> ";") -> SemanticStatementReassignment
	:= (SemanticStatementReassignment
		Decorate(Assignee<?Break>)
		Decorate(Expression<+Block><?Break>)
	);



Decorate(StatementConditional<Unless, Break> ::= "if" Expression<+Block><?Break> "then" Block<?Break> ";") -> SemanticStatementConditional
	:= (SemanticStatementConditional[unless=false]
		Decorate(Expression<+Block><?Break>)
		Decorate(Block<?Break>)
	);
Decorate(StatementConditional<Unless, Break> ::= "if" Expression<+Block><?Break> "then" Block__0<?Break> "else" Block__1<?Break> ";") -> SemanticStatementConditional
	:= (SemanticStatementConditional[unless=false]
		Decorate(Expression<+Block><?Break>)
		Decorate(Block__0<?Break>)
		Decorate(Block__1<?Break>)
	);
Decorate(StatementConditional<Unless, Break> ::= "if" Expression<+Block><?Break> "then" Block<?Break> "else" StatementConditional<-Unless><?Break>) -> SemanticStatementConditional
	:= (SemanticStatementConditional[unless=false]
		Decorate(Expression<+Block><?Break>)
		Decorate(Block<?Break>)
		Decorate(StatementConditional<-Unless><?Break>)
	);
Decorate(StatementConditional<Unless, Break> ::= "unless" Expression<+Block><?Break> "then" Block<?Break> ";") -> SemanticStatementConditional
	:= (SemanticStatementConditional[unless=true]
		Decorate(Expression<+Block><?Break>)
		Decorate(Block<?Break>)
	);



Decorate(StatementLoop ::= "while" Expression<+Block><-Break> "do" Block<+Break> ";") -> SemanticStatementLoop
	:= (SemanticStatementLoop[doFirst=false][until=false]
		Decorate(Expression<+Block><-Break>)
		Decorate(Block<+Break>)
	);
Decorate(StatementLoop ::= "do" Block<+Break> "while" Expression<+Block><-Break> ";") -> SemanticStatementLoop
	:= (SemanticStatementLoop[doFirst=true][until=false]
		Decorate(Expression<+Block><-Break>)
		Decorate(Block<+Break>)
	);
Decorate(StatementLoop ::= "until" Expression<+Block><-Break> "do" Block<+Break> ";") -> SemanticStatementLoop
	:= (SemanticStatementLoop[doFirst=false][until=true]
		Decorate(Expression<+Block><-Break>)
		Decorate(Block<+Break>)
	);
Decorate(StatementLoop ::= "do" Block<+Break> "until" Expression<+Block><-Break> ";") -> SemanticStatementLoop
	:= (SemanticStatementLoop[doFirst=true][until=true]
		Decorate(Expression<+Block><-Break>)
		Decorate(Block<+Break>)
	);



Decorate(StatementIteration ::= "for" "_" ":" Type "of" Expression<+Block><-Break> "do" Block<+Break> ";") -> SemanticStatementIteration
	:= (SemanticStatementIteration
		(SemanticType     Decorate(Type))
		(SemanticIterable Decorate(Expression<+Block><-Break>))
		Decorate(Block<+Break>)
	);
Decorate(StatementIteration ::= "for" IDENTIFIER ":" Type "of" Expression<+Block><-Break> "do" Block<+Break> ";") -> SemanticStatementIteration
	:= (SemanticStatementIteration
		(SemanticVariable[id=TokenWorth(IDENTIFIER)])
		(SemanticType     Decorate(Type))
		(SemanticIterable Decorate(Expression<+Block><-Break>))
		Decorate(Block<+Break>)
	);



Decorate(StatementBreak ::= "break" ";") -> SemanticStatementBreak
	:= (SemanticStatementBreak[continue=false]);
Decorate(StatementBreak ::= "continue" ";") -> SemanticStatementBreak
	:= (SemanticStatementBreak[continue=true]);



Decorate(Statement<Break> ::= Declaration<?Break>) -> SemanticDeclaration
	:= Decorate(Declaration<?Break>);
Decorate(Statement<Break> ::= StatementExpression<?Break>) -> SemanticStatementExpression
	:= Decorate(StatementExpression<?Break>);
Decorate(Statement<Break> ::= StatementClaim<?Break>) -> SemanticStatementClaim
	:= Decorate(StatementClaim<?Break>);
Decorate(Statement<Break> ::= StatementReassignment<?Break>) -> SemanticStatementReassignment
	:= Decorate(StatementReassignment<?Break>);
Decorate(Statement<Break> ::= StatementConditional<∓Unless><?Break>) -> SemanticStatementConditional
	:= Decorate(StatementConditional<∓Unless><?Break>);
Decorate(Statement<Break> ::= StatementLoop) -> SemanticStatementLoop
	:= Decorate(StatementLoop);
Decorate(Statement<Break> ::= StatementIteration) -> SemanticStatementIteration
	:= Decorate(StatementIteration);
Decorate(Statement<Break> ::= StatementBreak) -> SemanticStatementBreak
	:= Decorate(StatementBreak);



Decorate(Block<Break> ::= "{" Statement<?Break>+ "}") -> SemanticBlock
	:= (SemanticBlock
		...ParseList(Statement<?Break>, SemanticStatement)
	);



Decorate(DeclarationType ::= "type" "_" "=" Type ";") -> SemanticDeclarationType
	:= (SemanticDeclarationType
		Decorate(Type)
	);
Decorate(DeclarationType ::= "type" IDENTIFIER "=" Type ";") -> SemanticDeclarationType
	:= (SemanticDeclarationType
		(SemanticTypeAlias[id=TokenWorth(IDENTIFIER)])
		Decorate(Type)
	);



Decorate(DeclarationVariable<Break> ::= "let" "_" ":" Type "=" Expression<+Block><?Break> ";") -> SemanticDeclarationVariable
	:= (SemanticDeclarationVariable[unfixed=false]
		Decorate(Type)
		Decorate(Expression<+Block><?Break>)
	);
Decorate(DeclarationVariable<Break> ::= "let" IDENTIFIER ":" Type "=" Expression<+Block><?Break> ";") -> SemanticDeclarationVariable
	:= (SemanticDeclarationVariable[unfixed=false]
		(SemanticVariable[id=TokenWorth(IDENTIFIER)])
		Decorate(Type)
		Decorate(Expression<+Block><?Break>)
	);
Decorate(DeclarationVariable<Break> ::= "let" "var" "_" ":" Type "=" Expression<+Block><?Break> ";") -> SemanticDeclarationVariable
	:= (SemanticDeclarationVariable[unfixed=true]
		Decorate(Type)
		Decorate(Expression<+Block><?Break>)
	);
Decorate(DeclarationVariable<Break> ::= "let" "var" IDENTIFIER ":" Type "=" Expression<+Block><?Break> ";") -> SemanticDeclarationVariable
	:= (SemanticDeclarationVariable[unfixed=true]
		(SemanticVariable[id=TokenWorth(IDENTIFIER)])
		Decorate(Type)
		Decorate(Expression<+Block><?Break>)
	);
Decorate(DeclarationVariable<Break> ::= "let" "var" "_" "?:" Type ";") -> SemanticDeclarationVariable
	:= (SemanticDeclarationVariable[unfixed=true]
		Decorate(Type)
	);
Decorate(DeclarationVariable<Break> ::= "let" "var" IDENTIFIER "?:" Type ";") -> SemanticDeclarationVariable
	:= (SemanticDeclarationVariable[unfixed=true]
		(SemanticVariable[id=TokenWorth(IDENTIFIER)])
		Decorate(Type)
	);



Decorate(Declaration<Break> ::= DeclarationType) -> SemanticDeclarationType
	:= Decorate(DeclarationType);
Decorate(Declaration<Break> ::= DeclarationVariable<?Break>) -> SemanticDeclarationVariable
	:= Decorate(DeclarationVariable<?Break>);



Decorate(Goal ::= #x02 #x03) -> SemanticGoal
	:= (SemanticGoal);
Decorate(Goal ::= #x02 Block #x03) -> SemanticGoal
	:= (SemanticGoal
		Decorate(Block)
	);



ParseList(ParseNode, ASTNode)(ParseNode__List ::= ParseNode) -> Sequence<ASTNode>
	:= [Decorate(ParseNode)];
ParseList(ParseNode, ASTNode)(ParseNode__List ::= ParseNode__List ","? ParseNode) -> Sequence<ASTNode>
	:= [
		...Decorate(ParseNode__List),
		Decorate(ParseNode),
	];



TokenId(KeywordType  ::= "nothing")  -> TokenWorth("nothing");
TokenId(KeywordType  ::= "bool")     -> TokenWorth("bool");
TokenId(KeywordType  ::= "sym")      -> TokenWorth("sym");
TokenId(KeywordType  ::= "int")      -> TokenWorth("int");
TokenId(KeywordType  ::= "float")    -> TokenWorth("float");
TokenId(KeywordType  ::= "str")      -> TokenWorth("str");
TokenId(KeywordType  ::= "anything") -> TokenWorth("anything");
TokenId(KeywordValue ::= "null")     -> TokenWorth("null");
TokenId(KeywordValue ::= "false")    -> TokenWorth("false");
TokenId(KeywordValue ::= "true")     -> TokenWorth("true");



KeywordType(KeywordType ::= "nothing")  -> Type := Nothing;
KeywordType(KeywordType ::= "bool")     -> Type := Boolean;
KeywordType(KeywordType ::= "sym")      -> Type := Symbol;
KeywordType(KeywordType ::= "int")      -> Type := Integer;
KeywordType(KeywordType ::= "float")    -> Type := Float;
KeywordType(KeywordType ::= "str")      -> Type := String;
KeywordType(KeywordType ::= "anything") -> Type := Anything;



KeywordValue(KeywordValue ::= "null")  -> Object := null;
KeywordValue(KeywordValue ::= "false") -> Object := false;
KeywordValue(KeywordValue ::= "true")  -> Object := true;
