_KEYWORD_OTHER =:=
	// operator
		| "mut"
		| "as"
		| "is"
		| "isnt"
		| "if"
		| "then"
		| "else"
	// storage
		| "type"
		| "let"
		| "_"
	// modifier
		| "var"
;

Decorate(Word ::= _KEYWORD_OTHER) -> SemanticKey
	:= (SemanticKey[id=TokenWorth(_KEYWORD_OTHER)]);
Decorate(Word ::= IDENTIFIER) -> SemanticKey
	:= (SemanticKey[id=TokenWorth(IDENTIFIER)]);
Decorate(Word ::= KeywordType) -> SemanticKey
	:= (SemanticKey[id=TokenId(KeywordType)]);
Decorate(Word ::= KeywordValue) -> SemanticKey
	:= (SemanticKey[id=TokenId(KeywordValue)]);



Decorate(PrimitiveLiteral ::= INTEGER) -> SemanticConstant
	:= (SemanticConstant[value=Integer(TokenWorth(INTEGER))]);
Decorate(PrimitiveLiteral ::= FLOAT) -> SemanticConstant
	:= (SemanticConstant[value=Float(TokenWorth(FLOAT))]);
Decorate(PrimitiveLiteral ::= STRING) -> SemanticConstant
	:= (SemanticConstant[value=String(TokenWorth(STRING))]);
Decorate(PrimitiveLiteral ::= KeywordValue) -> SemanticConstant
	:= (SemanticConstant[value=KeywordValue(KeywordValue)]);
Decorate(PrimitiveLiteral ::= "@" Word) -> SemanticConstant
	:= (SemanticConstant[value=Symbol(Decorate(Word).id)]);



Decorate(EntryType<-Named><-Optional> ::= Type) -> SemanticItemType
	:= (SemanticItemType[optional=false] Decorate(Type));
Decorate(EntryType<-Named><+Optional> ::= "?:" Type) -> SemanticItemType
	:= (SemanticItemType[optional=true] Decorate(Type));
Decorate(EntryType<+Named><-Optional> ::= Word ":" Type) -> SemanticPropertyType
	:= (SemanticPropertyType[optional=false]
		Decorate(Word)
		Decorate(Type)
	);
Decorate(EntryType<+Named><+Optional> ::= Word "?:" Type) -> SemanticPropertyType
	:= (SemanticPropertyType[optional=true]
		Decorate(Word)
		Decorate(Type)
	);



Decorate(ItemsType ::= ","? EntryType<-Named><+Optional># ","?) -> Sequence<SemanticItemType>
	:= ParseList(EntryType<-Named><+Optional>, SemanticItemType);
Decorate(ItemsType ::= EntryType<-Named><-Optional> ",") -> Sequence<SemanticItemType>
	:= [Decorate(EntryType<-Named><-Optional>)];
Decorate(ItemsType ::= EntryType<-Named><-Optional> "," EntryType<-Named><+Optional># ","?) -> Sequence<SemanticItemType>
	:= [
		Decorate(EntryType<-Named><-Optional>),
		...ParseList(EntryType<-Named><+Optional>, SemanticItemType),
	];
Decorate(ItemsType ::= "," EntryType<-Named><-Optional># ","?) -> Sequence<SemanticItemType>
	:= ParseList(EntryType<-Named><-Optional>, SemanticItemType);
Decorate(ItemsType ::= "," EntryType<-Named><-Optional># "," EntryType<-Named><+Optional># ","?) -> Sequence<SemanticItemType>
	:= [
		...ParseList(EntryType<-Named><-Optional>, SemanticItemType),
		...ParseList(EntryType<-Named><+Optional>, SemanticItemType),
	];
Decorate(ItemsType ::= EntryType<-Named><-Optional>__0 "," EntryType<-Named><-Optional>__1# ","?) -> Sequence<SemanticItemType>
	:= [
		Decorate(EntryType<-Named><-Optional>__0),
		...ParseList(EntryType<-Named><-Optional>__1, SemanticItemType),
	];
Decorate(ItemsType ::= EntryType<-Named><-Optional>__0 "," EntryType<-Named><-Optional>__1# "," EntryType<-Named><+Optional># ","?) -> Sequence<SemanticItemType>
	:= [
		Decorate(EntryType<-Named><-Optional>__0),
		...ParseList(EntryType<-Named><-Optional>__1, SemanticItemType),
		...ParseList(EntryType<-Named><+Optional>,    SemanticItemType),
	];



Decorate(PropertiesType ::= ","? EntryType<+Named><-Optional># ","?) -> Sequence<SemanticPropertyType>
	:= ParseList(EntryType<+Named><-Optional>, SemanticPropertyType);
Decorate(PropertiesType ::= ","? EntryType<+Named><+Optional># ","?) -> Sequence<SemanticPropertyType>
	:= ParseList(EntryType<+Named><+Optional>, SemanticPropertyType);



Decorate(TypeGrouped ::= "(" Type ")") -> SemanticType
	:= Decorate(Type);

Decorate(TypeTupleLiteral ::= "(" ")") -> SemanticTypeTuple
	:= (SemanticTypeTuple);
Decorate(TypeTupleLiteral ::= "(" ItemsType ")") -> SemanticTypeTuple
	:= (SemanticTypeTuple
		...Decorate(ItemsType)
	);

Decorate(TypeRecordLiteral ::= "(" PropertiesType ")") -> SemanticTypeRecord
	:= (SemanticTypeRecord
		...Decorate(PropertiesType)
	);

Decorate(TypeListLiteral ::= "[" Type "]") -> SemanticTypeList
	:= (SemanticTypeList
		...Decorate(Type)
	);

Decorate(TypeDictLiteral ::= "[" ":" Type "]") -> SemanticTypeDict
	:= (SemanticTypeDict
		Decorate(Type)
	);

Decorate(TypeSetLiteral ::= "{" Type "}") -> SemanticTypeSet
	:= (SemanticTypeSet
		...Decorate(Type)
	);

Decorate(TypeMapLiteral ::= "{" Type__0 "->" Type__1 "}") -> SemanticTypeMap
	:= (SemanticTypeMap
		Decorate(Type__0)
		Decorate(Type__1)
	);

Decorate(GenericArguments ::= "<" ","? Type# ","? ">") -> Sequence<SemanticType>
	:= ParseList(Type, SemanticType);



Decorate(TypeUnit ::= IDENTIFIER) -> SemanticTypeAlias
	:= (SemanticTypeAlias[id=TokenWorth(IDENTIFIER)]);
Decorate(TypeUnit ::= KeywordType) -> SemanticTypeConstant
	:= (SemanticTypeConstant[value=KeywordType(KeywordType)]);
Decorate(TypeUnit ::= PrimitiveLiteral) -> SemanticTypeConstant
	:= (SemanticTypeConstant[value=ToType(Decorate(PrimitiveLiteral).value)]);
Decorate(TypeUnit ::= TypeGrouped) -> SemanticType
	:= Decorate(TypeGrouped);
Decorate(TypeUnit ::= TypeTupleLiteral) -> SemanticTypeTuple
	:= Decorate(TypeTupleLiteral);
Decorate(TypeUnit ::= TypeRecordLiteral) -> SemanticTypeRecord
	:= Decorate(TypeRecordLiteral);
Decorate(TypeUnit ::= TypeListLiteral) -> SemanticTypeList
	:= Decorate(TypeListLiteral);
Decorate(TypeUnit ::= TypeDictLiteral) -> SemanticTypeDict
	:= Decorate(TypeDictLiteral);
Decorate(TypeUnit ::= TypeSetLiteral) -> SemanticTypeSet
	:= Decorate(TypeSetLiteral);
Decorate(TypeUnit ::= TypeMapLiteral) -> SemanticTypeMap
	:= Decorate(TypeMapLiteral);



Decorate(PropertyAccessType ::= ("." | "?.") INTEGER) -> SemanticIndex
	:= (SemanticIndex[index=TokenWorth(INTEGER)]);
Decorate(PropertyAccessType ::= ("." | "?.") Word) -> SemanticKey
	:= Decorate(Word);

Decorate(GenericCall ::= "." GenericArguments) -> Sequence<SemanticType>
	:= Decorate(GenericArguments);



Decorate(TypeCompound ::= TypeUnit) -> SemanticType
	:= Decorate(TypeUnit);
Decorate(TypeCompound ::= TypeCompound PropertyAccessType) -> SemanticTypeAccess
	:= (SemanticTypeAccess[kind=AccessKind(PropertyAccessType)]
		Decorate(TypeCompound)
		Decorate(PropertyAccessType)
	);
Decorate(TypeCompound ::= TypeCompound GenericCall) -> SemanticTypeCall
	:= (SemanticTypeCall
		Decorate(TypeCompound)
		...Decorate(GenericCall)
	);



Decorate(TypeUnarySymbol ::= TypeCompound) -> SemanticType
	:= Decorate(TypeCompound);
Decorate(TypeUnarySymbol ::= TypeUnarySymbol "?") -> SemanticTypeOperation
	:= (SemanticTypeOperation[operator=ORNULL]
		Decorate(TypeUnarySymbol)
	);
Decorate(TypeUnarySymbol ::= TypeUnarySymbol "!") -> SemanticTypeOperation
	:= (SemanticTypeOperation[operator=OREXCP]
		Decorate(TypeUnarySymbol)
	);



Decorate(TypeUnaryKeyword ::= TypeUnarySymbol) -> SemanticType
	:= Decorate(TypeUnarySymbol);
Decorate(TypeUnaryKeyword ::= "mut" TypeUnaryKeyword) -> SemanticTypeOperation
	:= (SemanticTypeOperation[operator=MUTABLE]
		Decorate(TypeUnaryKeyword)
	);



Decorate(TypeIntersection ::= TypeUnarySymbol) -> SemanticType
	:= Decorate(TypeUnarySymbol);
Decorate(TypeIntersection ::= TypeIntersection "&" TypeUnaryKeyword) -> SemanticTypeOperation
	:= (SemanticTypeOperation[operator=AND]
		Decorate(TypeIntersection)
		Decorate(TypeUnaryKeyword)
	);



Decorate(TypeUnion ::= TypeIntersection) -> SemanticType
	:= Decorate(TypeIntersection);
Decorate(TypeUnion ::= TypeUnion "|" TypeIntersection) -> SemanticTypeOperation
	:= (SemanticTypeOperation[operator=OR]
		Decorate(TypeUnion)
		Decorate(TypeIntersection)
	);



Decorate(Type ::= TypeUnion) -> SemanticType
	:= Decorate(TypeUnion);



Decorate(StringTemplate ::= TEMPLATE_FULL) -> SemanticTemplate
	:= (SemanticTemplate
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_FULL))])
	);
Decorate(StringTemplate ::= TEMPLATE_HEAD TEMPLATE_TAIL) -> SemanticTemplate
	:= (SemanticTemplate
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_HEAD))])
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_TAIL))])
	);
Decorate(StringTemplate ::= TEMPLATE_HEAD Expression<+Block> TEMPLATE_TAIL) -> SemanticTemplate
	:= (SemanticTemplate
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_HEAD))])
		Decorate(Expression<+Block>)
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_TAIL))])
	);
Decorate(StringTemplate ::= TEMPLATE_HEAD StringTemplate__0__List TEMPLATE_TAIL) -> SemanticTemplate
	:= (SemanticTemplate
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_HEAD))])
		...Decorate(StringTemplate__0__List)
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_TAIL))])
	);
Decorate(StringTemplate ::= TEMPLATE_HEAD Expression<+Block> StringTemplate__0__List TEMPLATE_TAIL) -> SemanticTemplate
	:= (SemanticTemplate
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_HEAD))])
		Decorate(Expression<+Block>)
		...Decorate(StringTemplate__0__List)
		(SemanticConstant[value=String(TokenWorth(TEMPLATE_TAIL))])
	);

	Decorate(StringTemplate__0__List ::= TEMPLATE_MIDDLE) -> Vector<SemanticConstant>
		:= [SemanticConstant[value=String(TokenWorth(TEMPLATE_MIDDLE))]];
	Decorate(StringTemplate__0__List ::= TEMPLATE_MIDDLE Expression<+Block>) -> Vector<SemanticConstant, SemanticExpression>
		:= [
			(SemanticConstant[value=String(TokenWorth(TEMPLATE_MIDDLE))]),
			Decorate(Expression<+Block>),
		];
	Decorate(StringTemplate__0__List ::= StringTemplate__0__List TEMPLATE_MIDDLE) -> Sequence<...Vector<SemanticConstant, SemanticExpression?>>
		:= [
			...Decorate(StringTemplate__0__List),
			(SemanticConstant[value=String(TokenWorth(TEMPLATE_MIDDLE))]),
		];
	Decorate(StringTemplate__0__List ::= StringTemplate__0__List TEMPLATE_MIDDLE Expression<+Block>) -> Sequence<...Vector<SemanticConstant, SemanticExpression?>>
		:= [
			...Decorate(StringTemplate__0__List),
			(SemanticConstant[value=String(TokenWorth(TEMPLATE_MIDDLE))]),
			Decorate(Expression<+Block>),
		];



Decorate(Items ::= Expression<+Block> ",") -> Sequence<SemanticExpression>
	:= [Decorate(Expression<+Block>)];
Decorate(Items ::= "," Expression<+Block># ","?) -> Sequence<SemanticExpression>
	:= ParseList(Expression<+Block>, SemanticExpression);
Decorate(Items ::= Expression__0<+Block> "," Expression__1<+Block># ","?) -> Sequence<SemanticExpression>
	:= [
		Decorate(Expression__0<+Block>),
		...ParseList(Expression__1<+Block>, SemanticExpression),
	];

Decorate(Property ::= Word "=" Expression<+Block>) -> SemanticProperty
	:= (SemanticProperty
		Decorate(Word)
		Decorate(Expression<+Block>)
	);

Decorate(Case ::= Expression<+Block> "->" Expression<+Block>) -> SemanticCase
	:= (SemanticCase
		Decorate(Expression<+Block>)
		Decorate(Expression<+Block>)
	);



Decorate(ExpressionGrouped ::= "(" Expression<+Block> ")") -> SemanticExpression
	:= Decorate(Expression<+Block>);

Decorate(TupleLiteral ::= "(" ")") -> SemanticTuple
	:= (SemanticTuple);
Decorate(TupleLiteral ::= "(" Items ")") -> SemanticTuple
	:= (SemanticTuple
		...Decorate(Items)
	);

Decorate(RecordLiteral ::= "(" ","? Property# ","? ")") -> SemanticRecord
	:= (SemanticRecord
		...ParseList(Property, SemanticProperty)
	);

Decorate(ListLiteral ::= "[" "]") -> SemanticList
	:= (SemanticList);
Decorate(ListLiteral ::= "[" ( ","? Expression<+Block># ","? )? "]") -> SemanticList
	:= (SemanticList
		...ParseList(Expression<+Block>, SemanticExpression)
	);

Decorate(DictLiteral ::= [" ","? Property# ","? "]") -> SemanticDict
	:= (SemanticDict
		...ParseList(Property, SemanticProperty)
	);

Decorate(SetLiteral ::= "{" "}") -> SemanticSet
	:= (SemanticSet);
Decorate(SetLiteral ::= "{" ","? Expression<+Block># ","? "}") -> SemanticSet
	:= (SemanticSet
		...ParseList(Expression<+Block>, SemanticExpression)
	);

Decorate(MapLiteral ::= "{" ","? Case# ","? "}") -> SemanticMap
	:= (SemanticMap
		...ParseList(Case, SemanticCase)
	);

Decorate(FunctionArguments ::= "(" ( ","? Expression<+Block># ","? )? ")") -> Sequence<SemanticExpression>
	:= ParseList(Expression<+Block>, SemanticExpression);



Decorate(ExpressionUnit<Block> ::= IDENTIFIER) -> SemanticVariable
	:= (SemanticVariable[id=TokenWorth(IDENTIFIER)]);
Decorate(ExpressionUnit<Block> ::= PrimitiveLiteral) -> SemanticConstant
	:= Decorate(PrimitiveLiteral);
Decorate(ExpressionUnit<Block> ::= StringTemplate) -> SemanticTemplate
	:= Decorate(StringTemplate);
Decorate(ExpressionUnit<Block> ::= ExpressionGrouped) -> SemanticExpression
	:= Decorate(ExpressionGrouped);
Decorate(ExpressionUnit<Block> ::= TupleLiteral) -> SemanticTuple
	:= Decorate(TupleLiteral);
Decorate(ExpressionUnit<Block> ::= RecordLiteral) -> SemanticRecord
	:= Decorate(RecordLiteral);
Decorate(ExpressionUnit<Block> ::= ListLiteral) -> SemanticList
	:= Decorate(ListLiteral);
Decorate(ExpressionUnit<Block> ::= DictLiteral) -> SemanticDict
	:= Decorate(DictLiteral);
Decorate(ExpressionUnit<Block> ::= SetLiteral) -> SemanticSet
	:= Decorate(SetLiteral);
Decorate(ExpressionUnit<Block> ::= MapLiteral) -> SemanticMap
	:= Decorate(MapLiteral);
Decorate(ExpressionUnit<Block> ::= <Block+>Block) -> SemanticExpressionBlock
	:= (SemanticExpressionBlock Decorate(Block));



Decorate(PropertyAccess ::= ("." | "?." | "!.") INTEGER) -> SemanticIndex
	:= (SemanticIndex[index=TokenWorth(INTEGER)]);
Decorate(PropertyAccess ::= ("." | "?." | "!.") Word) -> SemanticKey
	:= Decorate(Word);
Decorate(PropertyAccess ::= ("." | "?." | "!.") "[" Expression<+Block> "]") -> SemanticExpression
	:= Decorate(Expression<+Block>);

Decorate(PropertyAssign ::= "." INTEGER) -> SemanticIndex
	:= (SemanticIndex[index=TokenWorth(INTEGER)]);
Decorate(PropertyAssign ::= "." Word) -> SemanticKey
	:= Decorate(Word);
Decorate(PropertyAssign ::= "." "[" Expression<+Block> "]") -> SemanticExpression
	:= Decorate(Expression<+Block>);

Decorate(FunctionCall ::= "." FunctionArguments) -> Vector<Sequence<SemanticType>, Sequence<SemanticExpression>>
	:= [
		[],
		Decorate(FunctionArguments),
	];
Decorate(FunctionCall ::= "." GenericArguments FunctionArguments) -> Vector<Sequence<SemanticType>, Sequence<SemanticExpression>>
	:= [
		Decorate(GenericArguments),
		Decorate(FunctionArguments),
	];



Decorate(ExpressionCompound<Block> ::= ExpressionUnit<?Block>) -> SemanticExpression
	:= Decorate(ExpressionUnit<?Block>);
Decorate(ExpressionCompound<Block> ::= ExpressionCompound<?Block> PropertyAccess) -> SemanticAccess
	:= (SemanticAccess[kind=AccessKind(PropertyAccess)]
		Decorate(ExpressionCompound<?Block>)
		Decorate(PropertyAccess)
	);
Decorate(ExpressionCompound<Block> ::= ExpressionCompound<?Block> FunctionCall) -> SemanticCall
	:= (SemanticCall
		Decorate(ExpressionCompound<?Block>)
		...(...Decorate(FunctionCall))
	);



Decorate(Assignee ::= IDENTIFIER) -> SemanticVariable
	:= (SemanticVariable[id=TokenWorth(IDENTIFIER)]);
Decorate(Assignee ::= ExpressionCompound<+Block> PropertyAssign) -> SemanticAccess
	:= (SemanticAccess[kind=NORMAL]
		Decorate(ExpressionCompound<+Block>)
		Decorate(PropertyAssign)
	);



Decorate(ExpressionUnarySymbol<Block> ::= ExpressionCompound<?Block>) -> SemanticExpression
	:= Decorate(ExpressionCompound<?Block>);
Decorate(ExpressionUnarySymbol<Block> ::= "!" ExpressionUnarySymbol<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		Decorate(ExpressionUnarySymbol<?Block>)
	);
Decorate(ExpressionUnarySymbol<Block> ::= "?" ExpressionUnarySymbol<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=EMP]
		Decorate(ExpressionUnarySymbol<?Block>)
	);
Decorate(ExpressionUnarySymbol<Block> ::= "+" ExpressionUnarySymbol<?Block>) -> SemanticExpression
	:= Decorate(ExpressionUnarySymbol<?Block>);
Decorate(ExpressionUnarySymbol<Block> ::= "-" ExpressionUnarySymbol<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=NEG]
		Decorate(ExpressionUnarySymbol<?Block>)
	);



Decorate(ExpressionUnaryKeyword<Block> ::= ExpressionUnarySymbol<?Block>) -> SemanticExpression
	:= Decorate(ExpressionUnarySymbol<?Block>);
Decorate(ExpressionUnaryKeyword<Block> ::= "int" ExpressionUnaryKeyword<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=INT]
		Decorate(ExpressionUnaryKeyword<?Block>)
	);
Decorate(ExpressionUnaryKeyword<Block> ::= "float" ExpressionUnaryKeyword<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=FLOAT]
		Decorate(ExpressionUnaryKeyword<?Block>)
	);



Decorate(ExpressionCast<Block> ::= ExpressionUnaryKeyword<?Block>) -> SemanticExpression
	:= Decorate(ExpressionUnaryKeyword<?Block>);
Decorate(ExpressionCast<Block> ::= ExpressionCast<?Block> "as" ExpressionUnaryKeyword<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=CAST]
		Decorate(ExpressionCast<?Block>)
		Decorate(ExpressionUnaryKeyword<?Block>)
	);
Decorate(ExpressionCast<Block> ::= ExpressionCast<?Block> "as?" ExpressionUnaryKeyword<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=MAYBE]
		Decorate(ExpressionCast<?Block>)
		Decorate(ExpressionUnaryKeyword<?Block>)
	);
Decorate(ExpressionCast<Block> ::= ExpressionCast<?Block> "as!" ExpressionUnaryKeyword<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=RESULT]
		Decorate(ExpressionCast<?Block>)
		Decorate(ExpressionUnaryKeyword<?Block>)
	);
Decorate(ExpressionCast<Block> ::= ExpressionCast<?Block> "as" "<" Type ">") -> SemanticClaim
	:= (SemanticClaim
		Decorate(ExpressionCast<?Block>)
		Decorate(Type)
	);



Decorate(ExpressionExponential<Block> ::= ExpressionCast<?Block>) -> SemanticExpression
	:= Decorate(ExpressionCast<?Block>);
Decorate(ExpressionExponential<Block> ::= ExpressionCast<?Block> "^" ExpressionExponential<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=EXP]
		Decorate(ExpressionCast<?Block>)
		Decorate(ExpressionExponential<?Block>)
	);



Decorate(ExpressionMultiplicative<Block> ::= ExpressionExponential<?Block>) -> SemanticExpression
	:= Decorate(ExpressionExponential<?Block>);
Decorate(ExpressionMultiplicative<Block> ::= ExpressionMultiplicative<?Block> "*" ExpressionExponential<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=MUL]
		Decorate(ExpressionMultiplicative<?Block>)
		Decorate(ExpressionExponential<?Block>)
	);
Decorate(ExpressionMultiplicative<Block> ::= ExpressionMultiplicative<?Block> "/" ExpressionExponential<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=DIV]
		Decorate(ExpressionMultiplicative<?Block>)
		Decorate(ExpressionExponential<?Block>)
	);



Decorate(ExpressionAdditive<Block> ::= ExpressionMultiplicative<?Block>) -> SemanticExpression
	:= Decorate(ExpressionMultiplicative<?Block>);
Decorate(ExpressionAdditive<Block> ::= ExpressionAdditive<?Block> "+" ExpressionMultiplicative<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=ADD]
		Decorate(ExpressionAdditive<?Block>)
		Decorate(ExpressionMultiplicative<?Block>)
	);
Decorate(ExpressionAdditive<Block> ::= ExpressionAdditive<?Block> "-" ExpressionMultiplicative<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=ADD]
		Decorate(ExpressionAdditive<?Block>)
		(SemanticOperation[operator=NEG] Decorate(ExpressionMultiplicative<?Block>))
	);



Decorate(ExpressionComparative<Block> ::= ExpressionAdditive<?Block>) -> SemanticOperation
	:= Decorate(ExpressionAdditive<?Block>);
Decorate(ExpressionComparative<Block> ::= ExpressionComparative<?Block> "<" ExpressionAdditive<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=LT]
		Decorate(ExpressionComparative<?Block>)
		Decorate(ExpressionAdditive<?Block>)
	);
Decorate(ExpressionComparative<Block> ::= ExpressionComparative<?Block> ">" ExpressionAdditive<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=GT]
		Decorate(ExpressionComparative<?Block>)
		Decorate(ExpressionAdditive<?Block>)
	);
Decorate(ExpressionComparative<Block> ::= ExpressionComparative<?Block> "<=" ExpressionAdditive<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=LE]
		Decorate(ExpressionComparative<?Block>)
		Decorate(ExpressionAdditive<?Block>)
	);
Decorate(ExpressionComparative<Block> ::= ExpressionComparative<?Block> ">=" ExpressionAdditive<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=GE]
		Decorate(ExpressionComparative<?Block>)
		Decorate(ExpressionAdditive<?Block>)
	);
Decorate(ExpressionComparative<Block> ::= ExpressionComparative<?Block> "!<" ExpressionAdditive<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=LT]
			Decorate(ExpressionComparative<?Block>)
			Decorate(ExpressionAdditive<?Block>)
		)
	);
Decorate(ExpressionComparative<Block> ::= ExpressionComparative<?Block> "!>" ExpressionAdditive<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=GT]
			Decorate(ExpressionComparative<?Block>)
			Decorate(ExpressionAdditive<?Block>)
		)
	);
Decorate(ExpressionComparative<Block> ::= ExpressionComparative<?Block> "is" ExpressionAdditive<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=IS]
		Decorate(ExpressionComparative<?Block>)
		Decorate(ExpressionAdditive<?Block>)
	);
Decorate(ExpressionComparative<Block> ::= ExpressionComparative<?Block> "isnt" ExpressionAdditive<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=IS]
			Decorate(ExpressionComparative<?Block>)
			Decorate(ExpressionAdditive<?Block>)
		)
	);



Decorate(ExpressionEquality<Block> ::= ExpressionComparative<?Block>) -> SemanticOperation
	:= Decorate(ExpressionComparative<?Block>);
Decorate(ExpressionEquality<Block> ::= ExpressionEquality<?Block> "===" ExpressionComparative<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=ID]
		Decorate(ExpressionEquality<?Block>)
		Decorate(ExpressionComparative<?Block>)
	);
Decorate(ExpressionEquality<Block> ::= ExpressionEquality<?Block> "!==" ExpressionComparative<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=ID]
			Decorate(ExpressionEquality<?Block>)
			Decorate(ExpressionComparative<?Block>)
		)
	);
Decorate(ExpressionEquality<Block> ::= ExpressionEquality<?Block> "==" ExpressionComparative<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=EQ]
		Decorate(ExpressionEquality<?Block>)
		Decorate(ExpressionComparative<?Block>)
	);
Decorate(ExpressionEquality<Block> ::= ExpressionEquality<?Block> "!=" ExpressionComparative<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=EQ]
			Decorate(ExpressionEquality<?Block>)
			Decorate(ExpressionComparative<?Block>)
		)
	);



Decorate(ExpressionConjunctive<Block> ::= ExpressionEquality<?Block>) -> SemanticExpression
	:= Decorate(ExpressionEquality<?Block>);
Decorate(ExpressionConjunctive<Block> ::= ExpressionConjunctive<?Block> "&&" ExpressionEquality<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=AND]
		Decorate(ExpressionConjunctive<?Block>)
		Decorate(ExpressionEquality<?Block>)
	);
Decorate(ExpressionConjunctive<Block> ::= ExpressionConjunctive<?Block> "!&" ExpressionEquality<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=AND]
			Decorate(ExpressionConjunctive<?Block>)
			Decorate(ExpressionEquality<?Block>)
		)
	);



Decorate(ExpressionDisjunctive<Block> ::= ExpressionConjunctive<?Block>) -> SemanticOperation
	:= Decorate(ExpressionConjunctive<?Block>);
Decorate(ExpressionDisjunctive<Block> ::= ExpressionDisjunctive<?Block> "||" ExpressionConjunctive<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=OR]
		Decorate(ExpressionDisjunctive<?Block>)
		Decorate(ExpressionConjunctive<?Block>)
	);
Decorate(ExpressionDisjunctive<Block> ::= ExpressionDisjunctive<?Block> "!|" ExpressionConjunctive<?Block>) -> SemanticOperation
	:= (SemanticOperation[operator=NOT]
		(SemanticOperation[operator=OR]
			Decorate(ExpressionDisjunctive<?Block>)
			Decorate(ExpressionConjunctive<?Block>)
		)
	);



Decorate(ExpressionConditional ::= "if" Expression__0<+Block> "then" Expression__1<-Block> "else" Expression__2<-Block>) -> SemanticOperation
	:= (SemanticOperation[operator=COND]
		Decorate(Expression__0<+Block>)
		Decorate(Expression__1<-Block>)
		Decorate(Expression__2<-Block>)
	);



Decorate(Expression<Block> ::= ExpressionDisjunctive<?Block>) -> SemanticExpression
	:= Decorate(ExpressionDisjunctive<?Block>);
Decorate(Expression<Block> ::= ExpressionConditional) -> SemanticExpression
	:= Decorate(ExpressionConditional);



Decorate(StatementExpression ::= ";") -> SemanticStatementExpression
	:= (SemanticStatementExpression);
Decorate(StatementExpression ::= Expression<+Block> ";") -> SemanticStatementExpression
	:= (SemanticStatementExpression Decorate(Expression<+Block>));



Decorate(StatementConditional<-Unless> ::= "if" Expression<+Block> "then" Block ";") -> SemanticStatementConditional
	:= (SemanticStatementConditional[unless=false]
		Decorate(Expression<+Block>)
		Decorate(Block)
	);
Decorate(StatementConditional<-Unless> ::= "if" Expression<+Block> "then" Block__0 "else" Block__1 ";") -> SemanticStatementConditional
	:= (SemanticStatementConditional[unless=false]
		Decorate(Expression<+Block>)
		Decorate(Block__0)
		Decorate(Block__1)
	);
Decorate(StatementConditional<-Unless> ::= "if" Expression<+Block> "then" Block "else" StatementConditional<-Unless>) -> SemanticStatementConditional
	:= (SemanticStatementConditional[unless=false]
		Decorate(Expression<+Block>)
		Decorate(Block)
		Decorate(StatementConditional<-Unless>)
	);
Decorate(StatementConditional<+Unless> ::= "unless" Expression<+Block> "then" Block ";") -> SemanticStatementConditional
	:= (SemanticStatementConditional[unless=true]
		Decorate(Expression<+Block>)
		Decorate(Block)
	);



Decorate(Statement ::= StatementExpression) -> SemanticStatementExpression
	:= Decorate(StatementExpression);
Decorate(Statement ::= StatementConditional<∓Unless>) -> SemanticStatementConditional
	:= Decorate(StatementConditional<∓Unless>);
Decorate(Statement ::= Declaration) -> SemanticDeclaration
	:= Decorate(Declaration);



Decorate(Block ::= "{" Statement+ "}") -> SemanticBlock
	:= (SemanticBlock
		...ParseList(Statement, SemanticStatement)
	);



Decorate(DeclarationType ::= "type" "_" "=" Type ";") -> SemanticDeclarationType
	:= (SemanticDeclarationType
		Decorate(Type)
	);
Decorate(DeclarationType ::= "type" IDENTIFIER "=" Type ";") -> SemanticDeclarationType
	:= (SemanticDeclarationType
		(SemanticTypeAlias[id=TokenWorth(IDENTIFIER)])
		Decorate(Type)
	);



Decorate(DeclarationVariable ::= "let" "_" ":" Type "=" Expression<+Block> ";") -> SemanticDeclarationVariable
	:= (SemanticDeclarationVariable[unfixed=false]
		Decorate(Type)
		Decorate(Expression<+Block>)
	);
Decorate(DeclarationVariable ::= "let" IDENTIFIER ":" Type "=" Expression<+Block> ";") -> SemanticDeclarationVariable
	:= (SemanticDeclarationVariable[unfixed=false]
		(SemanticVariable[id=TokenWorth(IDENTIFIER)])
		Decorate(Type)
		Decorate(Expression<+Block>)
	);
Decorate(DeclarationVariable ::= "let" "var" "_" ":" Type "=" Expression<+Block> ";") -> SemanticDeclarationVariable
	:= (SemanticDeclarationVariable[unfixed=true]
		Decorate(Type)
		Decorate(Expression<+Block>)
	);
Decorate(DeclarationVariable ::= "let" "var" IDENTIFIER ":" Type "=" Expression<+Block> ";") -> SemanticDeclarationVariable
	:= (SemanticDeclarationVariable[unfixed=true]
		(SemanticVariable[id=TokenWorth(IDENTIFIER)])
		Decorate(Type)
		Decorate(Expression<+Block>)
	);
Decorate(DeclarationVariable ::= "let" "var" "_" "?:" Type ";") -> SemanticDeclarationVariable
	:= (SemanticDeclarationVariable[unfixed=true]
		Decorate(Type)
	);
Decorate(DeclarationVariable ::= "let" "var" IDENTIFIER "?:" Type ";") -> SemanticDeclarationVariable
	:= (SemanticDeclarationVariable[unfixed=true]
		(SemanticVariable[id=TokenWorth(IDENTIFIER)])
		Decorate(Type)
	);



Decorate(DeclarationClaim ::= "claim" Assignee ":" Type ";") -> SemanticDeclarationClaim
	:= (SemanticDeclarationClaim
		Decorate(Assignee)
		Decorate(Type)
	);



Decorate(DeclarationReassignment ::= "set" Assignee "=" Expression<+Block> ";") -> SemanticDeclarationReassignment
	:= (SemanticDeclarationReassignment
		Decorate(Assignee)
		Decorate(Expression<+Block>)
	);



Decorate(Declaration ::= DeclarationType) -> SemanticDeclarationType
	:= Decorate(DeclarationType);
Decorate(Declaration ::= DeclarationVariable) -> SemanticDeclarationVariable
	:= Decorate(DeclarationVariable);
Decorate(Declaration ::= DeclarationClaim) -> SemanticDeclarationClaim
	:= Decorate(DeclarationClaim);
Decorate(Declaration ::= DeclarationReassignment) -> SemanticDeclarationReassignment
	:= Decorate(StatementAssignment);



Decorate(Goal ::= #x02 #x03) -> SemanticGoal
	:= (SemanticGoal);
Decorate(Goal ::= #x02 Block #x03) -> SemanticGoal
	:= (SemanticGoal
		Decorate(Block)
	);



ParseList(ParseNode, ASTNode)(ParseNode__List ::= ParseNode) -> Sequence<ASTNode>
	:= [Decorate(ParseNode)];
ParseList(ParseNode, ASTNode)(ParseNode__List ::= ParseNode__List ","? ParseNode) -> Sequence<ASTNode>
	:= [
		...Decorate(ParseNode__List),
		Decorate(ParseNode),
	];



AccessKind(PropertyAccess ::= "."  (INTEGER | Word | "[" Expression<+Block> "]")) -> NORMAL := NORMAL;
AccessKind(PropertyAccess ::= "?." (INTEGER | Word | "[" Expression<+Block> "]")) -> MAYBE  := MAYBE;
AccessKind(PropertyAccess ::= "!." (INTEGER | Word | "[" Expression<+Block> "]")) -> RESULT := RESULT;



TokenId(KeywordType  ::= "nothing")  -> TokenWorth("nothing");
TokenId(KeywordType  ::= "bool")     -> TokenWorth("bool");
TokenId(KeywordType  ::= "sym")      -> TokenWorth("sym");
TokenId(KeywordType  ::= "int")      -> TokenWorth("int");
TokenId(KeywordType  ::= "float")    -> TokenWorth("float");
TokenId(KeywordType  ::= "str")      -> TokenWorth("str");
TokenId(KeywordType  ::= "anything") -> TokenWorth("anything");
TokenId(KeywordValue ::= "null")     -> TokenWorth("null");
TokenId(KeywordValue ::= "false")    -> TokenWorth("false");
TokenId(KeywordValue ::= "true")     -> TokenWorth("true");



KeywordType(KeywordType ::= "nothing")  -> Type := Nothing;
KeywordType(KeywordType ::= "bool")     -> Type := Boolean;
KeywordType(KeywordType ::= "sym")      -> Type := Symbol;
KeywordType(KeywordType ::= "int")      -> Type := Integer;
KeywordType(KeywordType ::= "float")    -> Type := Float;
KeywordType(KeywordType ::= "str")      -> Type := String;
KeywordType(KeywordType ::= "anything") -> Type := Anything;



KeywordValue(KeywordValue ::= "null")  -> Object := null;
KeywordValue(KeywordValue ::= "false") -> Object := false;
KeywordValue(KeywordValue ::= "true")  -> Object := true;
