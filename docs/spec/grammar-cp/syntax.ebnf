// IDENTIFIER      ::= [./lexicon.ebnf#Identifier];
// INTEGER         ::= [./lexicon.ebnf#Integer];
// FLOAT           ::= [./lexicon.ebnf#Float];
// STRING          ::= [./lexicon.ebnf#String];
// TEMPLATE_FULL   ::= [./lexicon.ebnf#TemplateFull];
// TEMPLATE_HEAD   ::= [./lexicon.ebnf#TemplateHead];
// TEMPLATE_MIDDLE ::= [./lexicon.ebnf#TempalteMiddle];
// TEMPLATE_TAIL   ::= [./lexicon.ebnf#TempalteTail];



KeywordType ::=
	| "nothing"
	| "bool"
	| "sym"
	| "int"
	| "float"
	| "str"
	| "anything"
;

KeywordValue ::=
	| "null"
	| "false"
	| "true"
;



Word ::=
	// operator
		| "mut"
		| "as"
		| "is"
		| "isnt"
		| "if"
		| "then"
		| "else"
	// storage
		| "type"
		| "let"
		| "claim"
		| "set"
		| "_"
		| "void"
	// modifier
		| "nominal"
		| "var"
	// control
		| "unless"
	| IDENTIFIER
	| KeywordType
	| KeywordValue
;



PrimitiveLiteral ::=
	| INTEGER
	| FLOAT
	| STRING
	| KeywordValue
	| "@" Word
;



EntryType<Named, Optional>
	::= <Named+>(Word & <Optional->":") <Optional+>"?:" Type;

ItemsType ::=
	|                                                                  ","?  EntryType<-Named><+Optional>#   ","?
	| EntryType<-Named><-Optional>                                     ","  (EntryType<-Named><+Optional>#   ","?)?
	| EntryType<-Named><-Optional>? "," EntryType<-Named><-Optional># (","   EntryType<-Named><+Optional>#)? ","?
;

PropertiesType
	::= ","? EntryType<+Named><∓Optional># ","?;

TypeGrouped       ::= "(" Type             ")";
TypeTupleLiteral  ::= "(" ItemsType?       ")";
TypeRecordLiteral ::= "(" PropertiesType   ")";
TypeListLiteral   ::= "[" Type             "]";
TypeDictLiteral   ::= "[" ":" Type         "]";
TypeSetLiteral    ::= "{" Type             "}";
TypeMapLiteral    ::= "{" Type "->" Type   "}";
GenericArguments  ::= "<"  ","? Type# ","? ">";

TypeUnit ::=
	| IDENTIFIER
	| KeywordType
	| PrimitiveLiteral
	| TypeGrouped
	| TypeTupleLiteral
	| TypeListLiteral
	| TypeRecordLiteral
	| TypeDictLiteral
	| TypeSetLiteral
	| TypeMapLiteral
;

PropertyAccessorType ::= INTEGER | Word;

TypeCompound ::=
	| TypeUnit
	| TypeCompound (
		| ("." | "?.") PropertyAccessorType
		|  "."         GenericArguments
	)
;

TypeUnarySymbol ::=
	| TypeCompound
	| TypeUnarySymbol ("?" | "!")
;

TypeUnaryKeyword ::=
	| TypeUnarySymbol
	| "mut" TypeUnaryKeyword
;

TypeIntersection ::= (TypeIntersection "&")? TypeUnaryKeyword;
TypeUnion        ::= (TypeUnion        "|")? TypeIntersection;

Type ::=
	| TypeUnion
;



StringTemplate ::=
	| TEMPLATE_FULL
	| TEMPLATE_HEAD Expression<+Block>? (TEMPLATE_MIDDLE Expression<+Block>?)* TEMPLATE_TAIL
;

Items ::=
	| Expression<+Block>  ","
	| Expression<+Block>? "," Expression<+Block># ","?
;

Property ::= Word               "="  Expression<+Block>;
Case     ::= Expression<+Block> "->" Expression<+Block>;

ExpressionGrouped ::= "("        Expression<+Block>          ")";
TupleLiteral      ::= "("        Items?                      ")";
RecordLiteral     ::= "("   ","? Property#           ","?    ")";
ListLiteral       ::= "[" ( ","? Expression<+Block># ","? )? "]";
DictLiteral       ::= "["   ","? Property#           ","?    "]";
SetLiteral        ::= "{" ( ","? Expression<+Block># ","? )? "}";
MapLiteral        ::= "{"   ","? Case#               ","?    "}";
FunctionArguments ::= "(" ( ","? Expression<+Block># ","? )? ")";

ExpressionUnit<Block> ::=
	| IDENTIFIER
	| PrimitiveLiteral
	| StringTemplate
	| ExpressionGrouped
	| TupleLiteral
	| RecordLiteral
	| ListLiteral
	| DictLiteral
	| SetLiteral
	| MapLiteral
	| <Block+>Block
;

PropertyAccessor ::= INTEGER | Word | "[" Expression<+Block> "]";

ExpressionCompound<Block> ::=
	| ExpressionUnit<?Block>
	| ExpressionCompound<?Block> (
		| ("." | "?." | "!.") PropertyAccessor
		|  "."                GenericArguments? FunctionArguments
	)
;

Assignee ::=
	| IDENTIFIER
	| ExpressionCompound<+Block> "." PropertyAccessor
;

ExpressionUnarySymbol  <Block> ::= ExpressionCompound    <?Block> | ("!" | "?" | "+" | "-") ExpressionUnarySymbol  <?Block>;
ExpressionUnaryKeyword <Block> ::= ExpressionUnarySymbol <?Block> | ("int" | "float")       ExpressionUnaryKeyword <?Block>;

ExpressionCast<Block> ::=
	| (ExpressionCast<?Block> ("as" | "as?" | "as!"))? ExpressionUnaryKeyword<?Block>
	|  ExpressionCast<?Block>  "as"                    "<" Type ">"
;

ExpressionExponential<Block>
	::= ExpressionCast<?Block> ("^" ExpressionExponential<?Block>)?;

ExpressionMultiplicative <Block> ::= (ExpressionMultiplicative <?Block> ("*" | "/" ))?                                            ExpressionExponential    <?Block>;
ExpressionAdditive       <Block> ::= (ExpressionAdditive       <?Block> ("+" | "-" ))?                                            ExpressionMultiplicative <?Block>;
ExpressionComparative    <Block> ::= (ExpressionComparative    <?Block> ("<" | ">" | "<=" | ">=" | "!<" | "!>" | "is" | "isnt"))? ExpressionAdditive       <?Block>;
ExpressionEquality       <Block> ::= (ExpressionEquality       <?Block> ("===" | "!==" | "==" | "!="))?                           ExpressionComparative    <?Block>;
ExpressionConjunctive    <Block> ::= (ExpressionConjunctive    <?Block> ("&&" | "!&"))?                                           ExpressionEquality       <?Block>;
ExpressionDisjunctive    <Block> ::= (ExpressionDisjunctive    <?Block> ("||" | "!|"))?                                           ExpressionConjunctive    <?Block>;

ExpressionConditional
	::= "if" Expression<+Block> "then" Expression<-Block> "else" Expression<-Block>;

Expression<Block> ::=
	| ExpressionDisjunctive<?Block>
	| ExpressionConditional
;



StatementExpression
	::= Expression<+Block>? ";";

StatementConditional<Unless> ::=
	& <Unless->"if" <Unless+>"unless" Expression<+Block>
	& "then" Block
	& <Unless->(
		| ("else" Block)? ";"
		| "else" StatementConditional<?Unless>
	)
	& <Unless+>";"
;

Statement ::=
	| StatementExpression
	| StatementConditional<∓Unless>
	| Declaration
;



Block
	::= "{" Statement+ "}";



DeclarationType
	::= "type" ("_" | IDENTIFIER) "=" Type ";";

DeclarationVariable ::=
	| "let" "var"? ("_" | IDENTIFIER) ":"  Type "=" Expression<+Block> ";"
	| "let" "var"  ("_" | IDENTIFIER) "?:" Type                        ";"
;

DeclarationClaim        ::= "claim" Assignee ":" Type               ";";
DeclarationReassignment ::= "set"   Assignee "=" Expression<+Block> ";";

Declaration ::=
	| DeclarationType
	| DeclarationVariable
	| DeclarationClaim
	| DeclarationReassignment
;



Goal
	::= #x02 Block? #x03;
