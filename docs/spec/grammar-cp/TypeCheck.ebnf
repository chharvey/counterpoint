None! TypeCheck(Or<
	SemanticKey,
	SemanticPropertyType
	SemanticProperty,
	SemanticCase,
	SemanticStatementExpression,
	SemanticGoal,
> list) :=
	1. *For each* `it` in `list.children`:
		1. *Perform:* *Unwrap:* `TypeCheck(it)`.
;



None TypeCheck(SemanticType type) :=
	1. *Return*.
;



None! TypeCheck(SemanticExpression expr) :=
	1. *Perform:* *Unwrap:* `TypeOf(expr)`.
		1. *Note:* The result of this step is not used; it is only performed to rethrow any TypeErrors.
;



None! TypeCheck(SemanticDeclarationType decl) :=
	1. *If* `decl.children.count` is 1:
		1. *Let* `typevalue` be *Unwrap:* `TypeValueOf(decl.children.0)`.
	2. *Else:*
		1. *Assert:* `decl.children.count` is 2.
		2. *Let* `typevalue` be *Unwrap:* `TypeValueOf(decl.children.1)`.
		3. *Assert:* the validator’s symbol table contains a SymbolSchema `symbol` whose `id` is `decl.children.0.id`.
		4. *Assert:* `symbol` is an instance of `SymbolSchemaType`.
		5. *Set* `symbol.typevalue` to `typevalue`.
;



None! TypeCheck(SemanticDeclarationVariable decl) :=
	1. *Let* `assignee` be an item `child` in `decl.children` such that `child` is a SemanticVariable.
	2. *Let* `typenode` be an item `child` in `decl.children` such that `child` is a SemanticType.
	3. *Let* `assigned` be an item `child` in `decl.children` such that `child` is a SemanticExpression.
	4. *If* `assigned` is not *none*:
		1. *Perform:* *UnwrapAffirm:* `TypeCheck(assigned)`.
	5. *Assert:* `typenode` is not *none*.
	6. *Let* `assignee_type` be *Unwrap:* `TypeValueOf(typenode)`.
	7. *If* `assigned` is not *none*:
		1. *Perform:* *Unwrap:* `TypeCheckAssign(assigned, assignee_type)`.
	8. *If* `assignee` is not *none*:
		1. *If* `assigned` is not *none*:
			1. *Let* `value` be *Unwrap:* `ValueOf(assigned)`.
		2. *Else:*
			1. *Let* `value` be *none*.
		3. *Assert:* the validator’s symbol table contains a SymbolSchema `symbol` whose `id` is `assignee.id`:
		4. *Assert:* `symbol` is an instance of `SymbolSchemaVar`.
		5. *Set* `symbol.type` to `assignee_type`.
		6. *If* `assignee_type` is not mutable and has no mutable parts *and* `decl.unfixed` is `false`:
			1. *Assert:* `symbol.unfixed` is `false`.
			2. *Set* `symbol.value` to `value`.
;



Type! TypeCheck(SemanticDeclarationClaim claim) :=
	1. *Assert:* `claim.children.count` is 2.
	2. *Let* `assignee` be `claim.children.0`.
	3. Let `computed_type` be `TypeOf(assignee)`.
	4. Let `claimed_type` be `TypeValueOf(claim.children.1)`.
	5. *If* *UnwrapAffirm:* `Intersection(computed_type, claimed_type)` is `Nothing`:
		1. *Throw:* a new TypeErrorNotAssignable.
	6. *If* `assignee` is a SemanticVariable:
		1. *If* the validator’s symbol table contains a SymbolStructure `symbol` whose `id` is `assignee.id`:
			1. *Assert:* `symbol` is an instance of `SymbolStructureVar`.
			2. *Set* `symbol.type` to `claimed_type`.
	7. *Else:*
		// TODO
;



None! TypeCheck(SemanticDeclarationReassignment assignment) :=
	1. *Assert:* `assignment.children.count` is 2.
	2. *Let* `assignee` be `assignment.children.0`.
	3. *Let* `assigned` be `assignment.children.1`.
	4. *Perform:* *UnwrapAffirm:* `TypeCheck(assignee)`.
	5. *Perform:* *UnwrapAffirm:* `TypeCheck(assigned)`.
	6. *If* `assignee` is a SemanticAccess:
		2. *Let* `base_type` be *Unwrap:* `TypeOf(assignee.children.0)`.
		3. *If* `base_type` is not mutable:
			1. *Throw:* a new MutabilityError01.
	7. *Let* `assignee_type` be *Unwrap:* `WriteTypeOf(assignee)`.
	8. *Return:* `TypeCheckAssign(assigned, assignee_type)`.
;



None! TypeCheckAssign(SemanticExpression assigned, Type assignee_type) :=
	1. *Let* `assigned_type` be *Unwrap:* `TypeOf(assigned)`.
	2. *If* *UnwrapAffirm:* `Subtype(assigned_type, assignee_type)` is `false`:
		1. *If* `assigned` is a SemanticCollectionLiteral:
			1. *Return:* `AssignTo(assigned, assignee_type)`.
		2. *Else:*
			1. *Throw:* a new TypeErrorNotAssignable.
;
