Codegen((TRAP)) := (unreachable);

Codegen((NULL.CONST null))  := (global.get $Value.NULL);
Codegen((BOOL.CONST false)) := (global.get $Value.FALSE);
Codegen((BOOL.CONST true))  := (global.get $Value.TRUE);

Codegen((SYM.CONST   `v`)) := (call $Value.new-primitive (call $Vect.new-nat   (i64.const `v.id`)));
Codegen((INT.CONST   `v`)) := (call $Value.new-primitive (call $Vect.new-int   (i64.const `v.data`)));
Codegen((NAT.CONST   `v`)) := (call $Value.new-primitive (call $Vect.new-nat   (i64.const `v.data`)));
Codegen((FLOAT.CONST `v`)) := (call $Value.new-primitive (call $Vect.new-float (i64.const `v.data`)));

Codegen((STR.CONST `v`)) := (call $Value.from-string
	(array.new_fixed $String `v.data.map("(i32.const `v.data[i]`)")`)
);

Codegen((GET `id ::= CoreLibName`)) := (call $Value.new-composite (global.get ‹index›));
Codegen((GET `id`)) := (local.get ‹index›);

Codegen((STR.TEMPLATE `strings`)) := (call $Value.new-composite
	(block (result (ref $Cpl-String))
		`strings.map("(local.set $str_`i` (call $Value.as-string `Codegen(strings[i])`))")`
		(local.set $internal
			(array.new_default $String `strings.map("(array.len (local.get $str_`i`))").reduce("(i32.add `a` `b`)")`)
		)
		(local.set $offset (i32.const 0))
		`strings.flatMap([
			"(array.copy
				(local.get $internal)
				(local.get $offset)
				(local.get $str_`i`)
				(i32.const 0)
				(array.len (local.get $str_`i`))
			)",
			"(local.set $offset (i32.add (local.get $offset) (array.len (local.get $str_`i`))))",
		]).slice(0, -1)`
		(struct.new $Cpl-String (local.get $internal))
	)
);

Codegen((TUPLE.NEW)) := (call $Value.from-tuple
	(array.new_fixed $Tuple 0)
);
Codegen((TUPLE.NEW `values`)) := (call $Value.from-tuple
	(array.new_fixed $Tuple `values.count` `values.map(Codegen)`)
);

Codegen((RECORD.NEW)) := (call $Value.from-record
	(array.new_fixed $Record 0)
);
Codegen((RECORD.NEW `pairs`)) := (call $Value.from-record
	(array.new_fixed $Record `pairs.count` `pairs.hashMap("(struct.new $Property (i64.const `pairs[i].0`) `Codegen(pairs[i].1)`)")`)
);

Codegen((LIST.NEW)) := (call $Value.from-list
	(struct.new $List
		(i32.const 0)
		(array.new_default $ListInternal (i32.const 8))
	)
);
Codegen((LIST.NEW `values`)) := (call $Value.from-list
	(struct.new $List
		(i32.const `values.count`)
		(array.new_fixed $ListInternal `CapacityNeeded(values.count)`
			`values.pad(CapacityNeeded(values.count), "(ref.null $Value)").map(Codegen)`
		)
	)
);

Codegen((DICT.NEW)) := (call $Value.from-dict
	(struct.new $Dict
		(i32.const 0)
		(array.new_default $DictInternal (i32.const 8))
	)
);
Codegen((DICT.NEW `pairs`)) := (call $Value.from-dict
	(struct.new $Dict
		(i32.const `pairs.count`)
		(array.new_fixed $DictInternal `CapacityNeeded(pairs.count)`
			`pairs.pad(CapacityNeeded(pairs.count), "(ref.null $Property)").hashMap("(struct.new $Property
				(i64.const `pairs[i].0`)
				`Codegen(pairs[i].1)`
			)")`
		)
	)
);

// `Set<T>`s are implemented as `Map<T, null>`s
Codegen((SET.NEW)) := (call $Value.from-map
	(struct.new $Map
		(i32.const 0)
		(array.new_default $MapInternal (i32.const 8))
	)
);
Codegen((SET.NEW `values`)) := (call $Value.from-map
	(block (result (ref $Map))
		(local.set $map (struct.new $Map
			(i32.const `values.count`)
			(array.new_default $MapInternal `CapacityNeeded(values.count)`)
		))
		`...values.map("(call $Map.set `Codegen(values[i])` `Codegen((NULL.CONST null))`)")`
		(local.get $map)
	)
);

Codegen((MAP.NEW)) := (call $Value.from-map
	(struct.new $Map
		(i32.const 0)
		(array.new_default $MapInternal (i32.const 8))
	)
);
Codegen((MAP.NEW `pairs`)) := (call $Value.from-map
	(block (result (ref $Map))
		(local.set $map (struct.new $Map
			(i32.const `pairs.count`)
			(array.new_default $MapInternal `CapacityNeeded(pairs.count)`)
		))
		`...pairs.map("(call $Map.set `Codegen(pairs[i].0)` `Codegen(pairs[i].1)`)")`
		(local.get $map)
	)
);

Codegen((OBJECT.NEW `false` `class`)) := (call $Value.new-composite (struct.new $Object
	(call $Object.ctr-plus-plus)
	(ref.cast (ref $Class) (struct.get $Value $composite `Codegen(class)`))
	(struct.new $Dict
		(i32.const 0)
		(array.new_default $DictInternal (i32.const 8))
	)
));
Codegen((OBJECT.NEW `true` `class`)) := (call $Value.new-composite (struct.new $Class
	(call $Object.ctr-plus-plus)
	(ref.cast (ref $Class) (struct.get $Value $composite `Codegen(class)`))
	(struct.new $Dict
		(i32.const 0)
		(array.new_default $DictInternal (i32.const 8))
	)
));
Codegen((OBJECT.NEW `true`)) := (call $Value.new-composite (struct.new $Class
	(call $Object.ctr-plus-plus)
	(ref.null $Class)
	(struct.new $Dict
		(i32.const 0)
		(array.new_default $DictInternal (i32.const 8))
	)
));

Codegen((EXCP.NEW `message`)) := (call $Value.new-newComposite
	(struct.new $Exception
		(call $Object.ctr-plus-plus)
		(ref.null $Class)
		(ref.null $Dict)
		(ref.cast (ref $Cpl-String) (struct.get $Value $composite `Codegen(message)`))
	)
);
Codegen((EXCP.NEW `message` `cause`)) := (call $Value.new-newComposite
	(struct.new $Exception
		(call $Object.ctr-plus-plus)
		(ref.null $Class)
		(ref.null $Dict)
		(ref.cast (ref $Cpl-String) (struct.get $Value $composite `Codegen(message)`))
		(ref.cast (ref $Exception)  (struct.get $Value $composite `Codegen(cause)`))
	)
);

Codegen((MAYBE.NEW)) := (call $Value.new-composite
	(struct.new $Maybe
		(call $Object.ctr-plus-plus)
		(ref.null $Value)
	)
);
Codegen((MAYBE.NEW `value`)) := (call $Value.new-composite
	(struct.new $Maybe
		(call $Object.ctr-plus-plus)
		`Codegen(value)`
	)
);

Codegen((RESULT.NEW nil `excp`)) := (call $Value.new-composite
	(struct.new $Result
		(call $Object.ctr-plus-plus)
		(ref.null $Value)
		(ref.cast (ref $Exception) (struct.get $Value $composite `Codegen(excp)`))
	)
);
Codegen((RESULT.NEW `value` nil)) := (call $Value.new-composite
	(struct.new $Result
		(call $Object.ctr-plus-plus)
		`Codegen(value)`
		(ref.null $Exception)
	)
);

Codegen((TUPLE.HAS `index` `obj`)) := (call $Value.bool-from-i32 (i32.lt_u
	(i32.const `index`)
	(array.len (call $Value.as-tuple `Codegen(obj)`))
));

Codegen((RECORD.HAS `key` `obj`)) := (call cg.vm.Value.boolFromI32 (call $Record.has-key
	(call $Value.as-record `Codegen(obj)`)
	(i64.const `key`)
));

Codegen((TUPLE.GET `index` `obj`)) := (array.get
	(call $Value.as-tuple `Codegen(obj)`)
	(i32.const `index`)
);

Codegen((RECORD.GET `key` `obj`)) := (call $Record.get
	(call $Value.as-record `Codegen(obj)`)
	(i64.const `key`)
);

Codegen((LIST.GET `obj` `accessor`)) := (call $List.get
	(call $Value.as-list             `Codegen(obj)`)
	(i32.wrap_i64 (call $Vect.as-int (struct.get $Value $primitive `Codegen(accessor)`)))
);

Codegen((DICT.GET `obj` `accessor`)) := (call $Dict.get
	(call $Value.as-dict `Codegen(obj)`)
	(call $Vect.as-nat (struct.get $Value $primitive `Codegen(accessor)`))
);

Codegen((SET.GET `obj` `accessor`)) := (block (result (ref $Value))
	(drop (local.set $nullish-case
		(call $Map.find
			(call $Value.as-map `Codegen(obj)`)
			`Codegen(accessor)`
		)
	))
	(if (result (ref $Value))
		(i32.or
			(ref.is_null (local.get $nullish-case))
			(ref.eq (local.get $nullish-case) (global.get $Case.TOMBSTONE))
		)
		(then `Codegen((BOOL.CONST false))`)
		(else `Codegen((BOOL.CONST true))`)
	)
);

Codegen((MAP.GET `obj` `accessor`)) := (call $Map.get
	(call $Value.as-map `Codegen(obj)`)
	`Codegen(accessor)`
);

// Codegen((CALL `callable` `args`));

Codegen((BOOL.FROM  `v`)) := (call $op:not (call $op:not `Codegen(v)`));
Codegen((INT.FROM   `v`)) := (call $op:to-int   `Codegen(v)`);
Codegen((NAT.FROM   `v`)) := (call $op:to-nat   `Codegen(v)`);
Codegen((FLOAT.FROM `v`)) := (call $op:to-float `Codegen(v)`);
Codegen((STR.FROM   `v`)) := (call $op:to-str   `Codegen(v)`);

Codegen((NOT `v`)) := (call $op:not      `Codegen(v)`);
Codegen((EMP `v`)) := (call $op:is-empty `Codegen(v)`);
Codegen((NEG `v`)) := (call $op:negate   `Codegen(v)`);

Codegen((LIST.COUNT `obj`)) := (call $Value.new-primitive
	(call $Vect.new-nat
		(i64.extend_i32_u (call $List.count (call $Value.as-list `Codegen(obj)`)))
	)
);
Codegen((DICT.COUNT `obj`)) := (call $Value.new-primitive
	(call $Vect.new-nat
		(i64.extend_i32_u (call $Dict.count (call $Value.as-dict `Codegen(obj)`)))
	)
);
Codegen((SET.COUNT `obj`)) := (call $Value.new-primitive
	(call $Vect.new-nat
		(i64.extend_i32_u (call $Map.count (call $Value.as-map `Codegen(obj)`)))
	)
);
Codegen((MAP.COUNT `obj`)) := (call $Value.new-primitive
	(call $Vect.new-nat
		(i64.extend_i32_u (call $Map.count (call $Value.as-map `Codegen(obj)`)))
	)
);

Codegen((MAYBE.UNWRAP   `obj`)) := (call $op:unwrap-maybe   `Codegen(obj)`);
Codegen((RESULT.UNWRAP  `obj`)) := (call $op:unwrap-result  `Codegen(obj)`);
Codegen((RESULT.EXTRACT `obj`)) := (call $op:extract-result `Codegen(obj)`);

Codegen((INSTANCEOF "Symbol"    `v`)) := (call $op:is-int       `Codegen(v)`);
Codegen((INSTANCEOF "Integer"   `v`)) := (call $op:is-int       `Codegen(v)`);
Codegen((INSTANCEOF "Natural"   `v`)) := (call $op:is-nat       `Codegen(v)`);
Codegen((INSTANCEOF "Float"     `v`)) := (call $op:is-float     `Codegen(v)`);
Codegen((INSTANCEOF "String"    `v`)) := (call $op:is-string    `Codegen(v)`);
Codegen((INSTANCEOF "Object"    `v`)) := (call $op:is-object    `Codegen(v)`);
Codegen((INSTANCEOF "List"      `v`)) := (call $op:is-cpl-list  `Codegen(v)`);
Codegen((INSTANCEOF "Dict"      `v`)) := (call $op:is-cpl-dict  `Codegen(v)`);
Codegen((INSTANCEOF "Set"       `v`)) := (call $op:is-cpl-map   `Codegen(v)`);
Codegen((INSTANCEOF "Map"       `v`)) := (call $op:is-cpl-map   `Codegen(v)`);
Codegen((INSTANCEOF "Exception" `v`)) := (call $op:is-exception `Codegen(v)`);
Codegen((INSTANCEOF "Maybe"     `v`)) := (call $op:is-maybe     `Codegen(v)`);
Codegen((INSTANCEOF "None"      `v`)) := (call $op:is-none      `Codegen(v)`);
Codegen((INSTANCEOF "Some"      `v`)) := (call $op:is-some      `Codegen(v)`);
Codegen((INSTANCEOF "Result"    `v`)) := (call $op:is-result    `Codegen(v)`);
Codegen((INSTANCEOF "Fail"      `v`)) := (call $op:is-fail      `Codegen(v)`);
Codegen((INSTANCEOF "Ok"        `v`)) := (call $op:is-ok        `Codegen(v)`);
Codegen((INSTANCEOF "Function"  `v`)) := (call $op:is-function  `Codegen(v)`);

Codegen((CAST "Null"      `v`)) := (call $op:as-null      `Codegen(v)`);
Codegen((CAST "Boolean"   `v`)) := (call $op:as-bool      `Codegen(v)`);
Codegen((CAST "Symbol"    `v`)) := (call $op:as-int       `Codegen(v)`);
Codegen((CAST "Integer"   `v`)) := (call $op:as-int       `Codegen(v)`);
Codegen((CAST "Natural"   `v`)) := (call $op:as-nat       `Codegen(v)`);
Codegen((CAST "Float"     `v`)) := (call $op:as-float     `Codegen(v)`);
Codegen((CAST "String"    `v`)) := (call $op:as-string    `Codegen(v)`);
Codegen((CAST "Object"    `v`)) := (call $op:as-object    `Codegen(v)`);
Codegen((CAST "List"      `v`)) := (call $op:as-cpl-list  `Codegen(v)`);
Codegen((CAST "Dict"      `v`)) := (call $op:as-cpl-dict  `Codegen(v)`);
Codegen((CAST "Set"       `v`)) := (call $op:as-cpl-map   `Codegen(v)`);
Codegen((CAST "Map"       `v`)) := (call $op:as-cpl-map   `Codegen(v)`);
Codegen((CAST "Exception" `v`)) := (call $op:as-exception `Codegen(v)`);
Codegen((CAST "Maybe"     `v`)) := (call $op:as-maybe     `Codegen(v)`);
Codegen((CAST "None"      `v`)) := (call $op:as-none      `Codegen(v)`);
Codegen((CAST "Some"      `v`)) := (call $op:as-some      `Codegen(v)`);
Codegen((CAST "Result"    `v`)) := (call $op:as-result    `Codegen(v)`);
Codegen((CAST "Fail"      `v`)) := (call $op:as-fail      `Codegen(v)`);
Codegen((CAST "Ok"        `v`)) := (call $op:as-ok        `Codegen(v)`);
Codegen((CAST "Function"  `v`)) := (call $op:as-function  `Codegen(v)`);

Codegen((INT.ADD `v0` `v1`)) := (call $op:int-add `Codegen(v0)` `Codegen(v1)`);
Codegen((INT.SUB `v0` `v1`)) := (call $op:int-sub `Codegen(v0)` `Codegen(v1)`);
Codegen((INT.MUL `v0` `v1`)) := (call $op:int-mul `Codegen(v0)` `Codegen(v1)`);
Codegen((INT.DIV `v0` `v1`)) := (call $op:int-div `Codegen(v0)` `Codegen(v1)`);
Codegen((INT.EXP `v0` `v1`)) := (call $op:int-exp `Codegen(v0)` `Codegen(v1)`);

Codegen((NAT.ADD `v0` `v1`)) := (call $op:nat-add `Codegen(v0)` `Codegen(v1)`);
Codegen((NAT.SUB `v0` `v1`)) := (call $op:nat-sub `Codegen(v0)` `Codegen(v1)`);
Codegen((NAT.MUL `v0` `v1`)) := (call $op:nat-mul `Codegen(v0)` `Codegen(v1)`);
Codegen((NAT.DIV `v0` `v1`)) := (call $op:nat-div `Codegen(v0)` `Codegen(v1)`);
Codegen((NAT.EXP `v0` `v1`)) := (call $cpl-nat-exp `Codegen(v0)` `Codegen(v1)`);

Codegen((FLOAT.ADD `v0` `v1`)) := (call $op:float-add `Codegen(v0)` `Codegen(v1)`);
Codegen((FLOAT.SUB `v0` `v1`)) := (call $op:float-sub `Codegen(v0)` `Codegen(v1)`);
Codegen((FLOAT.MUL `v0` `v1`)) := (call $op:float-mul `Codegen(v0)` `Codegen(v1)`);
Codegen((FLOAT.DIV `v0` `v1`)) := (call $op:float-div `Codegen(v0)` `Codegen(v1)`);
Codegen((FLOAT.EXP `v0` `v1`)) := (call $op:float-exp `Codegen(v0)` `Codegen(v1)`);

Codegen((LT `v0` `v1`)) := (call $op:lt `Codegen(v0)` `Codegen(v1)`);
Codegen((GT `v0` `v1`)) := (call $op:gt `Codegen(v0)` `Codegen(v1)`);
Codegen((LE `v0` `v1`)) := (call $op:le `Codegen(v0)` `Codegen(v1)`);
Codegen((GE `v0` `v1`)) := (call $op:ge `Codegen(v0)` `Codegen(v1)`);

Codegen((ID `v0` `v1`)) := (call $op:id `Codegen(v0)` `Codegen(v1)`);
Codegen((EQ `v0` `v1`)) := (call $op:eq `Codegen(v0)` `Codegen(v1)`);

Codegen((LAMBDA `name` `arity` `source`)) := (call $Value.new-composite
	(struct.new $Function
		(call $Object.ctr-plus-plus)
		(i32.const `arity`)
	)
);

Codegen((DROP `v`)) := (drop `Codegen(v)`);

Codegen((DECL `id` `type` `v`)) := (local.set ‹index› `id` `Codegen(v)`);
Codegen((DECL `id` `type`))     := (local.set ‹index› `id` (struct.new_default $Value));
Codegen((SET  `id` `v`))        := (local.set ‹index› `id` `Codegen(v)`);

Codegen((LIST.SET `obj` `accessor` `v`)) := (call $List.set
	(call $Value.as-list `Codegen(obj)`)
	(i32.wrap_i64 (i64x2.extract_lane 1 (struct.get $Value $primitive `Codegen(accessor)`)))
	`Codegen(v)`
);

Codegen((DICT.SET `obj` `accessor` `v`)) := (call $Dict.set
	(call $Value.as-dict `Codegen(obj)`)
	(i64x2.extract_lane 1 (struct.get $Value $primitive `Codegen(accessor)`))
	`Codegen(v)`
);

Codegen((SET.SET `obj` `accessor` `v`)) := (block
	(local.set $base     (call $Value.as-map `Codegen(obj)`))
	(local.set $accessor `Codegen(accessor)`)
	(if
		(call $Vect.is-true (struct.get $Value $primitive `Codegen(v)`))
		(call $Map.set
			(local.get $base)
			(local.get $accessor)
			`Codegen((NULL.CONST null))`
		)
		(drop (call $Map.delete
			(local.get $base)
			(local.get $accessor)
		))
	)
);

Codegen((MAP.SET `obj` `accessor` `v`)) := (call $Map.set
	(call $Value.as-map `Codegen(obj)`)
	`Codegen(accessor)`
	`Codegen(v)`
);

Codegen((LIST.COPY `dest` `src:Tuple`)) := (call $List.copy-from-tuple
	(call $Value.as-list  `Codegen(dest)`)
	(call $Value.as-tuple `Codegen(src)`)
);
Codegen((LIST.COPY `dest` `src:List`)) := (call $List.copy-from-list
	(call $Value.as-list `Codegen(dest)`)
	(call $Value.as-list `Codegen(src)`)
);
Codegen((LIST.COPY `dest` `src:Set`)) := (call $List.fill-from-set
	(call $Value.as-list `Codegen(dest)`)
	(call $Value.as-map  `Codegen(src)`)
);

Codegen((DICT.COPY `dest` `src:Tuple`)) := (call $Dict.fill-from-tuple
	(call $Value.as-dict  `Codegen(dest)`)
	(call $Value.as-tuple `Codegen(src)`)
);
Codegen((DICT.COPY `dest` `src:Record`)) := (call $Dict.copy-from-record
	(call $Value.as-dict   `Codegen(dest)`)
	(call $Value.as-record `Codegen(src)`)
);
Codegen((DICT.COPY `dest` `src:List`)) := (call $Dict.fill-from-list
	(call $Value.as-dict `Codegen(dest)`)
	(call $Value.as-list `Codegen(src)`)
);
Codegen((DICT.COPY `dest` `src:Dict`)) := (call $Dict.copy-from-dict
	(call $Value.as-dict `Codegen(dest)`)
	(call $Value.as-dict `Codegen(src)`)
);
Codegen((DICT.COPY `dest` `src:Set`)) := (call $Dict.fill-from-set
	(call $Value.as-dict `Codegen(dest)`)
	(call $Value.as-map  `Codegen(src)`)
);
Codegen((DICT.COPY `dest` `src:Map`)) := (call $Dict.fill-from-map
	(call $Value.as-dict `Codegen(dest)`)
	(call $Value.as-map  `Codegen(src)`)
);

Codegen((SET.COPY `dest` `src:Tuple`)) := (call $Map.fill-set-from-tuple
	(call $Value.as-map   `Codegen(dest)`)
	(call $Value.as-tuple `Codegen(src)`)
);
Codegen((SET.COPY `dest` `src:List`)) := (call $Map.fill-set-from-list
	(call $Value.as-map  `Codegen(dest)`)
	(call $Value.as-list `Codegen(src)`)
);
Codegen((SET.COPY `dest` `src:Set`)) := (call $Map.copy-from-map
	(call $Value.as-map `Codegen(dest)`)
	(call $Value.as-map `Codegen(src)`)
);

Codegen((MAP.COPY `dest` `src:Tuple`)) := (call $Map.fill-from-tuple
	(call $value.as-map   `Codegen(dest)`)
	(call $Value.as-tuple `Codegen(src)`)
);
Codegen((MAP.COPY `dest` `src:List`)) := (call $Map.fill-from-list
	(call $value.as-map  `Codegen(dest)`)
	(call $Value.as-list `Codegen(src)`)
);
Codegen((MAP.COPY `dest` `src:Set`)) := (call $Map.fill-from-set
	(call $value.as-map `Codegen(dest)`)
	(call $value.as-map `Codegen(src)`)
);
Codegen((MAP.COPY `dest` `src:Map`)) := (call $Map.copy-from-map
	(call $value.as-map `Codegen(dest)`)
	(call $value.as-map `Codegen(src)`)
);

Codegen((RETURN `value` nil)) := (return `Codegen(value)`  (ref.null $Exception));
Codegen((RETURN nil `excp`))  := (return (ref.null $Value) `Codegen(excp)`);
