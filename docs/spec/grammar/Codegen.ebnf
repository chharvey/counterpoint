Codegen((TRAP)) := (unreachable);

Codegen((NULL.CONST null))  := (v128.const i16x8 0 0 0 0x0001 0 0 0 0);
Codegen((BOOL.CONST false)) := (v128.const i16x8 0 0 0 0x0002 0 0 0 0);
Codegen((BOOL.CONST true))  := (v128.const i16x8 0 0 0 0x0003 0 0 0 0);

Codegen((SYM.CONST   `v`)) := (i64x2.replace_lane 1 (v128.const i16x8 0 0 0 0x0028 0 0 0 0) (i64.const `v.id`));
Codegen((INT.CONST   `v`)) := (i64x2.replace_lane 1 (v128.const i16x8 0 0 0 0x0018 0 0 0 0) (i64.const `v.data`));
Codegen((NAT.CONST   `v`)) := (i64x2.replace_lane 1 (v128.const i16x8 0 0 0 0x0028 0 0 0 0) (i64.const `v.data`));
Codegen((FLOAT.CONST `v`)) := (i64x2.replace_lane 1 (v128.const i16x8 0 0 0 0x0048 0 0 0 0) (i64.const `v.data`));

// Codegen((STR.CONST `v`));

Codegen((GET `id`)) := (local.get ‹index› `id.type`);

// Codegen((STR.TEMPLATE `v`));

Codegen((TUPLE.NEW)) := (struct.new $Value
	(i32.const 1)
	(v128.const i64x2 0 0)
	(array.new_fixed $Tuple 0)
);
Codegen((TUPLE.NEW `values`)) := (struct.new $Value
	(i32.const 1)
	(v128.const i64x2 0 0)
	(array.new_fixed $Tuple `values.count` `values.map(Codegen)`)
);

Codegen((RECORD.NEW)) := (struct.new $Value
	(i32.const 1)
	(v128.const i64x2 0 0)
	(array.new_fixed $Record 0)
);
Codegen((RECORD.NEW `pairs`)) := (struct.new $Value
	(i32.const 1)
	(v128.const i64x2 0 0)
	(array.new_fixed $Record `pairs.count` `pairs.hashMap("(struct.new $Property (i64.const `pairs[i].0`) `Codegen(pairs[i].1)`)")`)
);

Codegen((LIST.NEW)) := (struct.new $Value
	(i32.const 1)
	(v128.const i64x2 0 0)
	(struct.new $List
		(i32.const 0)
		(array.new_default $ListInternal (i32.const 8))
	)
);
Codegen((LIST.NEW `values`)) := (struct.new $Value
	(i32.const 1)
	(v128.const i64x2 0 0)
	(struct.new $List
		(i32.const `values.count`)
		(array.new_fixed $ListInternal `CapacityNeeded(values.count)` `values.pad(CapacityNeeded(values.count), "(ref.null $Value)").map(Codegen)`)
	)
);

Codegen((DICT.NEW)) := (struct.new $Value
	(i32.const 1)
	(v128.const i64x2 0 0)
	(struct.new $Dict
		(i32.const 0)
		(array.new_default $DictInternal (i32.const 8))
	)
);
Codegen((DICT.NEW `pairs`)) := (struct.new $Value
	(i32.const 1)
	(v128.const i64x2 0 0)
	(struct.new $Dict
		(i32.const `pairs.count`)
		(array.new_fixed $DictInternal `CapacityNeeded(pairs.count)` `pairs.pad(CapacityNeeded(pairs.count), "(ref.null $Property)").hashMap("(struct.new $Property (i64.const `pairs[i].0`) `Codegen(pairs[i].1)`)")`)
	)
);

// Codegen((SET.NEW    `values`));
// Codegen((MAP.NEW    `pairs`));

Codegen((TUPLE.GET `index` `obj`)) := (array.get
	(ref.cast (ref $Tuple) (struct.get $composite `Codegen(obj)`))
	(i32.const `index`)
);

Codegen((RECORD.GET `key` `obj`)) := (call $Record.get
	(ref.cast (ref $Record) (struct.get $composite `Codegen(obj)`))
	(i64.const `key`)
);

Codegen((LIST.GET `obj` `accessor`)) := (block (result (ref $Value))
	(local.set $item (array.get
		(struct.get $internal (ref.cast (ref $List) (struct.get $composite `Codegen(obj)`)))
		(i32.wrap_i64 (i64x2.extract_lane 1 (struct.get $primitive `Codegen(accessor)`)))
	))
	(if (result (ref $Value)) (ref.is_null (local.get $item))
		(then `Codegen("(NULL.CONST null)")`)
		(else (ref.as_non_null (local.get $item)))
	)
);

Codegen((DICT.GET `obj` `accessor`)) := (block (result (ref $Value))
	(drop
		(local.set $maybe-prop
			(call $Dict.find
				(ref.cast (ref $Dict) (struct.get $composite `Codegen(obj)`))
				(i64x2.extract_lane 1 (struct.get $primitive `Codegen(accessor)`))
			)
		)
	)
	(if (result (ref $Value)) (i32.or
		(ref.is_null (local.get $maybe-prop))
		(call $Property.is-tombstone (local.get $maybe-prop))
	)
		(then `Codegen("(NULL.CONST null)")`)
		(else (struct.get $value (local.get $maybe-prop)))
	)
);

// Codegen((SET.GET  `obj` `accessor`));
// Codegen((MAP.GET  `obj` `accessor`));

// Codegen((CALL `values`));

Codegen((ISNULL `v`)) := (call $isnull `Codegen(v)`);

Codegen((NOT `v`)) := (call $vnot `Codegen(v)`);
Codegen((EMP `v`)) := (call $vemp `Codegen(v)`);
Codegen((NEG `v`)) := (call $vneg `Codegen(v)`);

Codegen((TOINT `v`))   := (call $vtoi `Codegen(v)`);
Codegen((TONAT `v`))   := (call $vton `Codegen(v)`);
Codegen((TOFLOAT `v`)) := (call $vtof `Codegen(v)`);

Codegen((INT.ADD `v0` `v1`)) := (call $viadd   `Codegen(v0)` `Codegen(v1)`);
Codegen((INT.SUB `v0` `v1`)) := (call $visub_s `Codegen(v0)` `Codegen(v1)`);
Codegen((INT.MUL `v0` `v1`)) := (call $vimul   `Codegen(v0)` `Codegen(v1)`);
Codegen((INT.DIV `v0` `v1`)) := (call $vidiv_s `Codegen(v0)` `Codegen(v1)`);
Codegen((INT.EXP `v0` `v1`)) := (call $viexp   `Codegen(v0)` `Codegen(v1)`);

Codegen((NAT.ADD `v0` `v1`)) := (call $viadd   `Codegen(v0)` `Codegen(v1)`);
Codegen((NAT.SUB `v0` `v1`)) := (call $visub_u `Codegen(v0)` `Codegen(v1)`);
Codegen((NAT.MUL `v0` `v1`)) := (call $vimul   `Codegen(v0)` `Codegen(v1)`);
Codegen((NAT.DIV `v0` `v1`)) := (call $vidiv_u `Codegen(v0)` `Codegen(v1)`);
Codegen((NAT.EXP `v0` `v1`)) := (call $viexp   `Codegen(v0)` `Codegen(v1)`);

Codegen((FLOAT.ADD `v0` `v1`)) := (call $vfadd `Codegen(v0)` `Codegen(v1)`);
Codegen((FLOAT.SUB `v0` `v1`)) := (call $vfsub `Codegen(v0)` `Codegen(v1)`);
Codegen((FLOAT.MUL `v0` `v1`)) := (call $vfmul `Codegen(v0)` `Codegen(v1)`);
Codegen((FLOAT.DIV `v0` `v1`)) := (call $vfdiv `Codegen(v0)` `Codegen(v1)`);
Codegen((FLOAT.EXP `v0` `v1`)) := (unreachable);

Codegen((LT  `v0` `v1`)) := (call $vlt `Codegen(v0)` `Codegen(v1)`);
Codegen((GT  `v0` `v1`)) := (call $vgt `Codegen(v0)` `Codegen(v1)`);
Codegen((LE  `v0` `v1`)) := (call $vle `Codegen(v0)` `Codegen(v1)`);
Codegen((GE  `v0` `v1`)) := (call $vge `Codegen(v0)` `Codegen(v1)`);
Codegen((NLT `v0` `v1`)) := `Codegen("(NOT (LT `v0` `v1`))")`;
Codegen((NGT `v0` `v1`)) := `Codegen("(NOT (GT `v0` `v1`))")`;

Codegen((ID  `v0` `v1`)) := (call $vid `Codegen(v0)` `Codegen(v1)`);
Codegen((EQ  `v0` `v1`)) := (call $veq `Codegen(v0)` `Codegen(v1)`);
Codegen((NID `v0` `v1`)) := `Codegen("(NOT (ID `v0` `v1`))")`;
Codegen((NEQ `v0` `v1`)) := `Codegen("(NOT (EQ `v0` `v1`))")`;

// Codegen((PHI `pairs`));

Codegen((DROP `v`)) := (drop `Codegen(v)`);

Codegen((DECL `id` `type` `v`)) := (local.set ‹index› `id` `Codegen(v)`);
Codegen((SET  `id`        `v`)) := (local.set ‹index› `id` `Codegen(v)`);

Codegen((LIST.SET `obj` `accessor` `v`)) := (call $List.set
	(ref.cast (ref $List) (struct.get $composite `Codegen(obj)`))
	(i32.wrap_i64 (i64x2.extract_lane 1 (struct.get $primitive `Codegen(accessor)`)))
	`Codegen(v)`
);
Codegen((DICT.SET `obj` `accessor` `v`)) := (call $Dict.set
	(ref.cast (ref $Dict) (struct.get $composite `Codegen(obj)`))
	(i64x2.extract_lane 1 (struct.get $primitive `Codegen(accessor)`))
	`Codegen(v)`
);

// Codegen((SET.SET  `obj` `accessor` `v`));
// Codegen((MAP.SET  `obj` `accessor` `v`));

// Codegen((LIST.COPY `dest` `src`));
// Codegen((DICT.COPY `dest` `src`));
// Codegen((SET.COPY  `dest` `src`));
// Codegen((MAP.COPY  `dest` `src`));
