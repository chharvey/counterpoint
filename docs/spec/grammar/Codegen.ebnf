Codegen((TRAP)) := (unreachable);

Codegen((NULL.CONST null))  := (struct.new $Value (i32.const 1) (v128.const i16x8 0 0 0 0x0001 0 0 0 0) (ref.null eq));
Codegen((BOOL.CONST false)) := (struct.new $Value (i32.const 1) (v128.const i16x8 0 0 0 0x0002 0 0 0 0) (ref.null eq));
Codegen((BOOL.CONST true))  := (struct.new $Value (i32.const 1) (v128.const i16x8 0 0 0 0x0003 0 0 0 0) (ref.null eq));

Codegen((SYM.CONST   `v`)) := (struct.new $Value (i32.const 1) (i64x2.replace_lane 1 (v128.const i16x8 0 0 0 0x0028 0 0 0 0) (i64.const `v.id`))   (ref.null eq));
Codegen((INT.CONST   `v`)) := (struct.new $Value (i32.const 1) (i64x2.replace_lane 1 (v128.const i16x8 0 0 0 0x0018 0 0 0 0) (i64.const `v.data`)) (ref.null eq));
Codegen((NAT.CONST   `v`)) := (struct.new $Value (i32.const 1) (i64x2.replace_lane 1 (v128.const i16x8 0 0 0 0x0028 0 0 0 0) (i64.const `v.data`)) (ref.null eq));
Codegen((FLOAT.CONST `v`)) := (struct.new $Value (i32.const 1) (i64x2.replace_lane 1 (v128.const i16x8 0 0 0 0x0048 0 0 0 0) (i64.const `v.data`)) (ref.null eq));

Codegen((STR.CONST `v`)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(array.new_fixed $String `v.data.map("(i32.const `v.data[i]`)")`)
);

Codegen((STR.TEMPLATE `values`)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(block (result (ref $String))
		`values.map("(local.set $str_`i` (call $stringify `Codegen(values[i])`))")`
		(local.set $string
			(array.new_default $String `values.map("(array.len (local.get $str_`i`))").reduce("(i32.add `a` `b`)")`)
		)
		(local.set $offset (i32.const 0))
		`values.flatMap([
			"(array.COPY
				(local.get $string)
				(local.get $offset)
				(local.get $str_`i`)
				(i32.const 0)
				(array.len (local.get $str_`i`))
			)",
			"(local.set $offset (i32.add (local.get $offset) (array.len (local.get $str_`i`))))",
		]).slice(0, -1)`
		(local.get $string)
	)
);

Codegen((GET `id`)) := (local.get ‹index› `id.type`);

Codegen((TUPLE.NEW)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(array.new_fixed $Tuple 0)
);
Codegen((TUPLE.NEW `values`)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(array.new_fixed $Tuple `values.count` `values.map(Codegen)`)
);

Codegen((RECORD.NEW)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(array.new_fixed $Record 0)
);
Codegen((RECORD.NEW `pairs`)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(array.new_fixed $Record `pairs.count` `pairs.hashMap("(struct.new $Property (i64.const `pairs[i].0`) `Codegen(pairs[i].1)`)")`)
);

Codegen((LIST.NEW)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(struct.new $List
		(block (result i64)
			(global.set $obj-ctr (i64.add (global.get $obj-ctr) (i64.const 1)))
			(i64.sub (global.get $obj-ctr) (i64.const 1))
		)
		(i32.const 0)
		(array.new_default $ListInternal (i32.const 8))
	)
);
Codegen((LIST.NEW `values`)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(struct.new $List
		(block (result i64)
			(global.set $obj-ctr (i64.add (global.get $obj-ctr) (i64.const 1)))
			(i64.sub (global.get $obj-ctr) (i64.const 1))
		)
		(i32.const `values.count`)
		(array.new_fixed $ListInternal `CapacityNeeded(values.count)`
			`values.pad(CapacityNeeded(values.count), "(ref.null $Value)").map(Codegen)`
		)
	)
);

Codegen((DICT.NEW)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(struct.new $Dict
		(block (result i64)
			(global.set $obj-ctr (i64.add (global.get $obj-ctr) (i64.const 1)))
			(i64.sub (global.get $obj-ctr) (i64.const 1))
		)
		(i32.const 0)
		(array.new_default $DictInternal (i32.const 8))
	)
);
Codegen((DICT.NEW `pairs`)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(struct.new $Dict
		(block (result i64)
			(global.set $obj-ctr (i64.add (global.get $obj-ctr) (i64.const 1)))
			(i64.sub (global.get $obj-ctr) (i64.const 1))
		)
		(i32.const `pairs.count`)
		(array.new_fixed $DictInternal `CapacityNeeded(pairs.count)`
			`pairs.pad(CapacityNeeded(pairs.count), "(ref.null $Property)").hashMap("(struct.new $Property
				(i64.const `pairs[i].0`)
				`Codegen(pairs[i].1)`
			)")`
		)
	)
);

// `Set<T>`s are implemented as `Map<T, null>`s
Codegen((SET.NEW)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(struct.new $Map
		(block (result i64)
			(global.set $obj-ctr (i64.add (global.get $obj-ctr) (i64.const 1)))
			(i64.sub (global.get $obj-ctr) (i64.const 1))
		)
		(i32.const 0)
		(array.new_default $MapInternal (i32.const 8))
	)
);
Codegen((SET.NEW `values`)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(block (result (ref $Map))
		(local.set $map (struct.new $Map
			(block (result i64)
				(global.set $obj-ctr (i64.add (global.get $obj-ctr) (i64.const 1)))
				(i64.sub (global.get $obj-ctr) (i64.const 1))
			)
			(i32.const `values.count`)
			(array.new_default $MapInternal `CapacityNeeded(values.count)`)
		))
		`...values.map("(call $Map.set `Codegen(values[i])` `Codegen((NULL.CONST null))`)")`
		(local.get $map)
	)
);

Codegen((MAP.NEW)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(struct.new $Map
		(block (result i64)
			(global.set $obj-ctr (i64.add (global.get $obj-ctr) (i64.const 1)))
			(i64.sub (global.get $obj-ctr) (i64.const 1))
		)
		(i32.const 0)
		(array.new_default $MapInternal (i32.const 8))
	)
);
Codegen((MAP.NEW `pairs`)) := (struct.new $Value
	(i32.const 2)
	(v128.const i64x2 0 0)
	(block (result (ref $Map))
		(local.set $map (struct.new $Map
			(block (result i64)
				(global.set $obj-ctr (i64.add (global.get $obj-ctr) (i64.const 1)))
				(i64.sub (global.get $obj-ctr) (i64.const 1))
			)
			(i32.const `pairs.count`)
			(array.new_default $MapInternal `CapacityNeeded(pairs.count)`)
		))
		`...pairs.map("(call $Map.set `Codegen(pairs[i].0)` `Codegen(pairs[i].1)`)")`
		(local.get $map)
	)
);

Codegen((TUPLE.GET `index` `obj`)) := (array.get
	(ref.cast (ref $Tuple) (struct.get $Value $composite `Codegen(obj)`))
	(i32.const `index`)
);

Codegen((RECORD.GET `key` `obj`)) := (call $Record.get
	(ref.cast (ref $Record) (struct.get $Value $composite `Codegen(obj)`))
	(i64.const `key`)
);

Codegen((LIST.GET `obj` `accessor`)) := (block (result (ref $Value))
	(local.set $item (array.get
		(struct.get $List $internal (ref.cast (ref $List) (struct.get $Value $composite `Codegen(obj)`)))
		(i32.wrap_i64 (i64x2.extract_lane 1 (struct.get $Value $primitive `Codegen(accessor)`)))
	))
	(if (result (ref $Value))
		(ref.is_null (local.get $item))
		(then `Codegen((NULL.CONST null))`)
		(else (ref.as_non_null (local.get $item)))
	)
);

Codegen((DICT.GET `obj` `accessor`)) := (block (result (ref $Value))
	(drop
		(local.set $maybe-prop
			(call $Dict.find
				(ref.cast (ref $Dict) (struct.get $Value $composite `Codegen(obj)`))
				(i64x2.extract_lane 1 (struct.get $Value $primitive `Codegen(accessor)`))
			)
		)
	)
	(if (result (ref $Value))
		(i32.or
			(ref.is_null (local.get $maybe-prop))
			(call $Property.is-tombstone (local.get $maybe-prop))
		)
		(then `Codegen((NULL.CONST null))`)
		(else (struct.get $Property $val (local.get $maybe-prop)))
	)
);

Codegen((SET.GET `obj` `accessor`)) := (block (result (ref $Value))
	(drop
		(local.set $maybe-case
			(call $Map.find
				(ref.cast (ref $Map) (struct.get $Value $composite `Codegen(obj)`))
				`Codegen(accessor)`
			)
		)
	)
	(if (result (ref $Value))
		(i32.or
			(ref.is_null (local.get $maybe-case))
			(call $Case.is-tombstone (local.get $maybe-case))
		)
		(then `Codegen((BOOL.CONST false))`)
		(else `Codegen((BOOL.CONST true))`)
	)
);

Codegen((MAP.GET `obj` `accessor`)) := (block (result (ref $Value))
	(drop
		(local.set $maybe-case
			(call $Map.find
				(ref.cast (ref $Map) (struct.get $Value $composite `Codegen(obj)`))
				`Codegen(accessor)`
			)
		)
	)
	(if (result (ref $Value))
		(i32.or
			(ref.is_null (local.get $maybe-case))
			(call $Case.is-tombstone (local.get $maybe-case))
		)
		(then `Codegen((NULL.CONST null))`)
		(else (struct.get $Case $con (local.get $maybe-case)))
	)
);

// Codegen((CALL `values`));

Codegen((ISNULL `v`)) := (call $cpl:is-null `Codegen(v)`);

Codegen((NOT `v`)) := (call $cpl:not      `Codegen(v)`);
Codegen((EMP `v`)) := (call $cpl:is-empty `Codegen(v)`);
Codegen((NEG `v`)) := (call $cpl:negate   `Codegen(v)`);

Codegen((TOBOOL  `v`)) := (call $cpl:not (call $cpl:not `Codegen(v)`));
Codegen((TOINT   `v`)) := (call $cpl:to-int   `Codegen(v)`);
Codegen((TONAT   `v`)) := (call $cpl:to-nat   `Codegen(v)`);
Codegen((TOFLOAT `v`)) := (call $cpl:to-float `Codegen(v)`);

Codegen((LIST.COUNT `list`)) := (struct.new $Value
	(i32.const 1)
	(i64x2.replace_lane 1
		(v128.const i16x8 0 0 0 0x0028 0 0 0 0)
		(i64.extend_i32_u (call $List.count `Codegen(list)`))
	)
	(ref.null eq)
);
Codegen((DICT.COUNT `dict`)) := (struct.new $Value
	(i32.const 1)
	(i64x2.replace_lane 1
		(v128.const i16x8 0 0 0 0x0028 0 0 0 0)
		(i64.extend_i32_u (call $Dict.count `Codegen(dict)`))
	)
	(ref.null eq)
);
Codegen((SET.COUNT `set`)) := (struct.new $Value
	(i32.const 1)
	(i64x2.replace_lane 1
		(v128.const i16x8 0 0 0 0x0028 0 0 0 0)
		(i64.extend_i32_u (call $Map.count `Codegen(set)`))
	)
	(ref.null eq)
);
Codegen((MAP.COUNT `map`)) := (struct.new $Value
	(i32.const 1)
	(i64x2.replace_lane 1
		(v128.const i16x8 0 0 0 0x0028 0 0 0 0)
		(i64.extend_i32_u (call $Map.count `Codegen(map)`))
	)
	(ref.null eq)
);

Codegen((INT.ADD `v0` `v1`)) := (call $cpl:int-add `Codegen(v0)` `Codegen(v1)`);
Codegen((INT.SUB `v0` `v1`)) := (call $cpl:int-sub `Codegen(v0)` `Codegen(v1)`);
Codegen((INT.MUL `v0` `v1`)) := (call $cpl:int-mul `Codegen(v0)` `Codegen(v1)`);
Codegen((INT.DIV `v0` `v1`)) := (call $cpl:int-div `Codegen(v0)` `Codegen(v1)`);
Codegen((INT.EXP `v0` `v1`)) := (call $cpl:int-exp `Codegen(v0)` `Codegen(v1)`);

Codegen((NAT.ADD `v0` `v1`)) := (call $cpl:nat-add `Codegen(v0)` `Codegen(v1)`);
Codegen((NAT.SUB `v0` `v1`)) := (call $cpl:nat-sub `Codegen(v0)` `Codegen(v1)`);
Codegen((NAT.MUL `v0` `v1`)) := (call $cpl:nat-mul `Codegen(v0)` `Codegen(v1)`);
Codegen((NAT.DIV `v0` `v1`)) := (call $cpl:nat-div `Codegen(v0)` `Codegen(v1)`);
Codegen((NAT.EXP `v0` `v1`)) := (call $cpl-nat-exp `Codegen(v0)` `Codegen(v1)`);

Codegen((FLOAT.ADD `v0` `v1`)) := (call $cpl:float-add `Codegen(v0)` `Codegen(v1)`);
Codegen((FLOAT.SUB `v0` `v1`)) := (call $cpl:float-sub `Codegen(v0)` `Codegen(v1)`);
Codegen((FLOAT.MUL `v0` `v1`)) := (call $cpl:float-mul `Codegen(v0)` `Codegen(v1)`);
Codegen((FLOAT.DIV `v0` `v1`)) := (call $cpl:float-div `Codegen(v0)` `Codegen(v1)`);
Codegen((FLOAT.EXP `v0` `v1`)) := (call $cpl:float-exp `Codegen(v0)` `Codegen(v1)`);

Codegen((LT  `v0` `v1`)) := (call $cpl:lt `Codegen(v0)` `Codegen(v1)`);
Codegen((GT  `v0` `v1`)) := (call $cpl:gt `Codegen(v0)` `Codegen(v1)`);
Codegen((LE  `v0` `v1`)) := (call $cpl:le `Codegen(v0)` `Codegen(v1)`);
Codegen((GE  `v0` `v1`)) := (call $cpl:ge `Codegen(v0)` `Codegen(v1)`);
Codegen((NLT `v0` `v1`)) := (call $cpl:not (call $cpl:lt `Codegen(v0)` `Codegen(v1)`));
Codegen((NGT `v0` `v1`)) := (call $cpl:not (call $cpl:gt `Codegen(v0)` `Codegen(v1)`));

Codegen((ID  `v0` `v1`)) := (call $vid `Codegen(v0)` `Codegen(v1)`);
Codegen((EQ  `v0` `v1`)) := (call $veq `Codegen(v0)` `Codegen(v1)`);
Codegen((NID `v0` `v1`)) := `Codegen((NOT (ID `v0` `v1`)))`;
Codegen((NEQ `v0` `v1`)) := `Codegen((NOT (EQ `v0` `v1`)))`;

Codegen((DROP `v`)) := (drop `Codegen(v)`);

Codegen((DECL `id` `type` `v`)) := (local.set ‹index› `id` `Codegen(v)`);
Codegen((SET  `id`        `v`)) := (local.set ‹index› `id` `Codegen(v)`);

Codegen((LIST.SET `obj` `accessor` `v`)) := (call $List.set
	(ref.cast (ref $List) (struct.get $Value $composite `Codegen(obj)`))
	(i32.wrap_i64 (i64x2.extract_lane 1 (struct.get $Value $primitive `Codegen(accessor)`)))
	`Codegen(v)`
);

Codegen((DICT.SET `obj` `accessor` `v`)) := (call $Dict.set
	(ref.cast (ref $Dict) (struct.get $Value $composite `Codegen(obj)`))
	(i64x2.extract_lane 1 (struct.get $Value $primitive `Codegen(accessor)`))
	`Codegen(v)`
);

Codegen((SET.SET `obj` `accessor` `v`)) := (block
	(local.set $base     (ref.cast (ref $Map) (struct.get $Value $composite `Codegen(obj)`)))
	(local.set $accessor `Codegen(accessor)`)
	(if
		(i32.eq
			(i16x8.extract_lane_u 3 (struct.get $Value $primitive `Codegen(v)`))
			(i32.const 0x0003)
		)
		(call $Map.set
			(local.get $base)
			(local.get $accessor)
			`Codegen((NULL.CONST null))`
		)
		(drop (call $Map.delete
			(local.get $base)
			(local.get $accessor)
		))
	)
);

Codegen((MAP.SET `obj` `accessor` `v`)) := (call $Map.set
	(ref.cast (ref $Map) (struct.get $Value $composite `Codegen(obj)`))
	`Codegen(accessor)`
	`Codegen(v)`
);

Codegen((LIST.COPY `dest` `src:Tuple`)) := (block
	(local.set $destlist (ref.cast (ref $List)  (struct.get $Value $composite `Codegen(dest)`)))
	(local.set $srcref   (ref.cast (ref $Tuple) (struct.get $Value $composite `Codegen(src)`)))
	(call $List.adjust-capacity
		(local.get $destlist)
		(call $capacity-needed (array.len (local.get $srcref)))
	)
	(array.copy $ListInternal $Tuple
		(struct.get $List $internal (local.get $destlist))
		(i32.const 0)
		(local.get $srcref)
		(i32.const 0)
		(array.len (local.get $srcref))
	)
);
Codegen((LIST.COPY `dest` `src:List`)) := (block
	(local.set $destlist (ref.cast (ref $List) (struct.get $Value $composite `Codegen(dest)`)))
	(local.set $srcref   (struct.get $List $internal (ref.cast (ref $List) (struct.get $Value $composite `Codegen(src)`))))
	(call $List.adjust-capacity
		(local.get $destlist)
		(array.len (local.get $srcref))
	)
	(array.copy $ListInternal $ListInternal
		(struct.get $List $internal (local.get $destlist))
		(i32.const 0)
		(local.get $srcref)
		(i32.const 0)
		(array.len (local.get $srcref))
	)
);
Codegen((LIST.COPY `dest` `src:Set`)) := (block
	(local.set $list  (ref.cast (ref $List) (struct.get $Value $composite `Codegen(dest)`)))
	(local.set $cases (struct.get $Map $internal (ref.cast (ref $Map) (struct.get $Value $composite `Codegen(src)`))))
	(block $exit
		(local.set $i (i32.const 0))
		(local.set $j (i32.const 0))
		(loop $repeat
			(br_if $exit (i32.ge_u (local.get $i) (array.len (local.get $cases))))
			(local.set $case (array.get $MapInternal (local.get $cases) (local.get $i)))
			(if
				(i32.eqz (ref.is_null (local.get $case)))
				(then
					(call $List.set
						(local.get $list)
						(local.get $j)
						(struct.get $Case $ant (local.get $case))
					)
					(local.set $j (i32.add (local.get $j) (i32.const 1)))
				)
			)
			(local.set $i (i32.add (local.get $i) (i32.const 1)))
			(br $repeat)
		)
	)
);

Codegen((DICT.COPY `dest` `src:Tuple`)) := (block
	(local.set $dict  (ref.cast (ref $Dict)  (struct.get $Value $composite `Codegen(dest)`)))
	(local.set $pairs (ref.cast (ref $Tuple) (struct.get $Value $composite `Codegen(src)`)))
	(block $exit
		(local.set $i (i32.const 0))
		(loop $repeat
			(br_if $exit (i32.ge_u (local.get $i) (array.len (local.get $pairs))))
			(local.set $item (array.get $Tuple (local.get $pairs) (local.get $i)))
			(call $Dict.set
				(local.get $dict)
				(i64x2.extract_lane 1 (struct.get $Value $primitive
					(array.get $Tuple (local.tee $pair (ref.cast (ref $Tuple) (struct.get $Value $composite (local.get $item)))) (i32.const 0))
				))
				(array.get $Tuple (local.get $pair) (i32.const 1))
			)
			(local.set $i (i32.add (local.get $i) (i32.const 1)))
			(br $repeat)
		)
	)
);
Codegen((DICT.COPY `dest` `src:Record`)) := (block
	(local.set $destdict (ref.cast (ref $Dict)   (struct.get $Value $composite `Codegen(dest)`)))
	(local.set $srcref   (ref.cast (ref $Record) (struct.get $Value $composite `Codegen(src)`)))
	(call $Dict.adjust-capacity
		(local.get $destdict)
		(call $capacity-needed (array.len (local.get $srcref)))
	)
	(array.copy $DictInternal $Record
		(struct.get $Dict $internal (local.get $destdict))
		(i32.const 0)
		(local.get $srcref)
		(i32.const 0)
		(array.len (local.get $srcref))
	)
);
Codegen((DICT.COPY `dest` `src:List`)) := (block
	(local.set $dict  (ref.cast (ref $Dict) (struct.get $Value $composite `Codegen(dest)`)))
	(local.set $pairs (struct.get $List $internal (ref.cast (ref $List) (struct.get $Value $composite `Codegen(src)`))))
	(block $exit
		(local.set $i (i32.const 0))
		(loop $repeat
			(br_if $exit (i32.ge_u (local.get $i) (array.len (local.get $pairs))))
			(local.set $item (array.get $ListInternal (local.get $pairs) (local.get $i)))
			(if
				(i32.eqz (ref.is_null (local.get $item)))
				(then (call $Dict.set
					(local.get $dict)
					(i64x2.extract_lane 1 (struct.get $Value $primitive
						(array.get $Tuple (local.tee $pair (ref.cast (ref $Tuple) (struct.get $Value $composite (local.get $item)))) (i32.const 0))
					))
					(array.get $Tuple (local.get $pair) (i32.const 1))
				))
			)
			(local.set $i (i32.add (local.get $i) (i32.const 1)))
			(br $repeat)
