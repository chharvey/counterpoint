Decorate(ExpressionEquality<Block, Break, Return> ::= ExpressionComparative<?Block><?Break><?Return>) -> SemanticExpression
	:= Decorate(ExpressionComparative<?Block>);
Decorate(ExpressionEquality<Block, Break, Return> ::= ExpressionEquality<?Block><?Break><?Return> "===" ExpressionComparative<?Block><?Break><?Return>) -> SemanticExpressionOperation
	:= (SemanticExpressionOperation[operator=ID]
