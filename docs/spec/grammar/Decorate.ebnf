Decorate(ExpressionComparative<Block, Break, Return> ::= ExpressionComparative<?Block><?Break><?Return> "!<" ExpressionAdditive<?Block><?Break><?Return>) -> SemanticExpressionOperation
	:= (SemanticExpressionOperation[operator=NOT]
