	);
Decorate(DeclarationFunction ::= "func" IDENTIFIER "(" ")" ":" Type "=>" Expression<+Block><-Break><+Return> ";") -> SemanticDeclarationFunction
	:= (SemanticDeclarationFunction[id=TokenWorth(IDENTIFIER)]
		Decorate(Type)
		Decorate(Parse("{" "return" Expression<+Block><-Break><+Return> ";" "}"))
	);
Decorate(DeclarationFunction ::= "func" IDENTIFIER "(" ParametersFunction ")" ":" "void" Block<-Break><+Return>) -> SemanticDeclarationFunction
	:= (SemanticDeclarationFunction[id=TokenWorth(IDENTIFIER)]
		...Decorate(ParametersFunction)
		Decorate(Block<-Break><+Return>)
	);
Decorate(DeclarationFunction ::= "func" IDENTIFIER "(" ParametersFunction ")" ":" "void" "=>" Expression<+Block><-Break><+Return> ";") -> SemanticDeclarationFunction
	:= (SemanticDeclarationFunction[id=TokenWorth(IDENTIFIER)]
		...Decorate(ParametersFunction)
		Decorate(Parse("{" "return" Expression<+Block><-Break><+Return> ";" "}"))
	);
Decorate(DeclarationFunction ::= "func" IDENTIFIER "(" ParametersFunction ")" ":" Type Block<-Break><+Return>) -> SemanticDeclarationFunction
	:= (SemanticDeclarationFunction[id=TokenWorth(IDENTIFIER)]
		...Decorate(ParametersFunction)
		Decorate(Type)
		Decorate(Block<-Break><+Return>)
	);
Decorate(DeclarationFunction ::= "func" IDENTIFIER "(" ParametersFunction ")" ":" Type "=>" Expression<+Block><-Break><+Return> ";") -> SemanticDeclarationFunction
	:= (SemanticDeclarationFunction[id=TokenWorth(IDENTIFIER)]
		...Decorate(ParametersFunction)
		Decorate(Type)
		Decorate(Parse("{" "return" Expression<+Block><-Break><+Return> ";" "}"))
	);



Decorate(Declaration<Break, Return> ::= DeclarationType) -> SemanticDeclarationType
	:= Decorate(DeclarationType);
Decorate(Declaration<Break, Return> ::= DeclarationVariable<?Break><?Return>) -> SemanticDeclarationVariable
	:= Decorate(DeclarationVariable<?Break><?Return>);
Decorate(Declaration<Break, Return> ::= DeclarationFunction) -> SemanticDeclarationFunction
	:= Decorate(DeclarationFunction);



Decorate(SourceFile ::= #x02 #x03) -> SemanticGoal
	:= (SemanticGoal);
Decorate(SourceFile ::= #x02 Block<-Break><-Return> #x03) -> SemanticGoal
	:= (SemanticGoal
		Decorate(Block<-Break><-Return>)
	);



ParseList(ParseNode, AstNode)(ParseNode__List ::= ParseNode) -> Sequence<AstNode>
	:= [Decorate(ParseNode)];
ParseList(ParseNode, AstNode)(ParseNode__List ::= ParseNode__List ("," | "|")? ParseNode) -> Sequence<AstNode>
	:= [
		...Decorate(ParseNode__List),
		Decorate(ParseNode),
	];



TokenId(KeywordType  ::= "nothing")  -> TokenWorth("nothing");
TokenId(KeywordType  ::= "bool")     -> TokenWorth("bool");
TokenId(KeywordType  ::= "sym")      -> TokenWorth("sym");
TokenId(KeywordType  ::= "int")      -> TokenWorth("int");
TokenId(KeywordType  ::= "nat")      -> TokenWorth("nat");
TokenId(KeywordType  ::= "float")    -> TokenWorth("float");
TokenId(KeywordType  ::= "str")      -> TokenWorth("str");
TokenId(KeywordType  ::= "anything") -> TokenWorth("anything");
TokenId(KeywordValue ::= "null")     -> TokenWorth("null");
TokenId(KeywordValue ::= "false")    -> TokenWorth("false");
TokenId(KeywordValue ::= "true")     -> TokenWorth("true");



KeywordType(KeywordType ::= "nothing")  -> Type := Nothing;
KeywordType(KeywordType ::= "bool")     -> Type := Boolean;
KeywordType(KeywordType ::= "sym")      -> Type := Symbol;
KeywordType(KeywordType ::= "int")      -> Type := Integer;
KeywordType(KeywordType ::= "nat")      -> Type := Natural;
KeywordType(KeywordType ::= "float")    -> Type := Float;
KeywordType(KeywordType ::= "str")      -> Type := String;
KeywordType(KeywordType ::= "anything") -> Type := Anything;



KeywordValue(KeywordValue ::= "null")  -> Object := null;
KeywordValue(KeywordValue ::= "false") -> Object := false;
KeywordValue(KeywordValue ::= "true")  -> Object := true;
