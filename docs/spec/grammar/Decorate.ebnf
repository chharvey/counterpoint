Decorate(ExpressionDisjunctive<Block, Break, Return> ::= ExpressionConjunctive<?Block><?Break><?Return>) -> SemanticExpression
	:= Decorate(ExpressionConjunctive<?Block><?Break><?Return>);
Decorate(ExpressionDisjunctive<Block, Break, Return> ::= ExpressionDisjunctive<?Block><?Break><?Return> "||" ExpressionConjunctive<?Block><?Break><?Return>) -> SemanticExpressionOperation
