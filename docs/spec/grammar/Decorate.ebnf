Decorate(ExpressionConjunctive<Block, Break, Return> ::= ExpressionEquality<?Block><?Break><?Return>) -> SemanticExpression
	:= Decorate(ExpressionEquality<?Block><?Break><?Return>);
Decorate(ExpressionConjunctive<Block, Break, Return> ::= ExpressionConjunctive<?Block><?Break><?Return> "&&" ExpressionEquality<?Block><?Break><?Return>) -> SemanticExpressionOperation
