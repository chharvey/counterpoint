None! TypeCheck(Or<
	SemanticKey,
	SemanticPropertyType
	SemanticProperty,
	SemanticCase,
	SemanticStatementExpression,
	SemanticGoal,
> list) :=
	1. *For each* `it` in `list.children`:
		1. *Perform:* *Unwrap:* `TypeCheck(it)`.
;



None TypeCheck(SemanticType typexpr) :=
	1. *Perform:* *Unwrap:* `TypeValueOf(typexpr)`.
		1. *Note:* The result of this step is not used; it is only performed to rethrow any TypeErrors.
;



None! TypeCheck(SemanticExpression expr) :=
	1. *Perform:* *Unwrap:* `TypeOf(expr)`.
		1. *Note:* The result of this step is not used; it is only performed to rethrow any TypeErrors.
;



None! TypeCheck(SemanticDeclarationType decl) :=
	1. *Let* `typevalue` be *Unwrap:* `TypeValueOf(decl.children.0)`.
	2. *Assert:* The validator’s symbol table contains a SymbolSchema `symbol` whose `id` is `decl.id`.
	3. *Assert:* `symbol` is an instance of `SymbolSchemaType`.
	4. *Set* `symbol.typevalue` to `typevalue`.
;



None! TypeCheck(SemanticDeclarationVariable decl) :=
	1. *Let* `typenode` be an item `child` in `decl.children` such that `child` is a SemanticType.
	2. *Let* `assigned` be an item `child` in `decl.children` such that `child` is a SemanticExpression.
	3. *If* `typenode` is *none*:
		1. *Assert:* `assigned` is not *none*.
		2. *Set* `typenode` to an inferred type of `assigned`.
	4. *Else:*
		1. Fall through.
	5. *If* `assigned` is not *none*:
		1. *Perform:* *UnwrapAffirm:* `TypeCheck(assigned)`.
	6. *Else:*
		1. Fall through.
	7. *Let* `assignee_type` be *Unwrap:* `TypeValueOf(typenode)`.
	8. *If* `assigned` is not *none*:
		1. *Perform:* *Unwrap:* `TypeCheckAssign(assigned, assignee_type)`.
	9. *Else:*
		1. Fall through.
	10. *If* `decl.id` is not *none*:
		1. *Assert:* The validator’s symbol table contains a SymbolSchema `symbol` whose `id` is `decl.id`.
		2. *Assert:* `symbol` is an instance of `SymbolSchemaVar`.
		3. *Set* `symbol.type` to `assignee_type`.
	11. *Else:*
		1. *Return.*
;



Type! TypeCheck(SemanticStatementClaim claim) :=
	1. *Assert:* `claim.children.count` is 2.
	2. *Let* `assignee` be `claim.children.0`.
	3. *Let* `computed_type` be *Unwrap:* `TypeOf(assignee)`.
	4. *Let* `claimed_type` be *Unwrap:* `TypeValueOf(claim.children.1)`.
	5. *If* *UnwrapAffirm:* `Subtype(claimed_type, computed_type)` is `false`:
		1. *Throw:* a new TypeErrorNotNarrow.
	6. *If* `assignee` is a SemanticExpressionVariable:
		1. *If* the validator’s symbol table contains a SymbolSchema `symbol` whose `id` is `assignee.id`:
			1. *Assert:* `symbol` is an instance of `SymbolSchemaVar`.
			2. *Set* `symbol.type` to `claimed_type`.
	7. *Else:*
		1. *Assert:* `assignee` is a SemanticExpressionAccess.
		2. *Assert:* `assignee.children.count` is 2.
		3. *Let* `base_type` be *Unwrap:* `TypeOf(assignee.children.0)`.
		4. *Let* `accessor` be `assignee.children.1`.
		5. *If* `base_type` is a Tuple type:
			1. *Assert:* `accessor` is a SemanticIndex.
			2. *If* `accessor.index` is an index in `base_type`:
				1. *Let* `old_entry` be a the item accessed at index `accessor.index` in `base_type`.
				2. *Let* `new_entry` be a new EntryTypeSchema [
					type=     `claimed_type`,
					optional= `old_entry.optional`,
				].
				3. *Set* the item at index `accessor.index` in `base_type` to `new_entry`.
			3. *Else:*
				1. *Throw:* a new TypeErrorNoEntry.
		6. *Else If* `base_type` is a Record type:
			1. *Assert:* `accessor` is a SemanticKey.
			2. *If* `accessor.id` is a key in `base_type`:
				1. *Let* `old_entry` be the item accessed at key `accessor.id` in `base_type`.
				2. *Let* `new_entry` be a new EntryTypeSchema [
					type=     `claimed_type`,
					optional= `old_entry.optional`,
				].
				3. *Set* the item at key `accessor.id` in `base_type` to `new_entry`.
			3. *Else:*
				1. *Throw:* a new TypeErrorNoEntry.
		7. *Else:*
			1. *Assert:* `accessor` is a SemanticExpression.
			// TODO
;



None! TypeCheck(SemanticStatementReassignment stmt) :=
	1. *Let* `assignee` be `stmt.children.0`.
	2. *Perform:* *UnwrapAffirm:* `TypeCheck(assignee)`.
	3. *If* `stmt.children.count` is 2:
		1. *Set* `statement_kind` to *SET*.
		2. *Let* `assigned` be `stmt.children.1`.
		3. *Perform:* *UnwrapAffirm:* `TypeCheck(assigned)`.
	4. *Else:*
		1. *Set* `statement_kind` to *DELETE*.
	5. *If* `assignee` is a SemanticExpressionAccess:
		1. *Let* `base_type` be *Unwrap:* `TypeOf(assignee.children.0)`.
		2. *If* `base_type` is not mutable:
			1. *Throw:* a new MutabilityError01.
		3. *Else If* `statement_kind` is *DELETE*:
			1. *If* `base_type` is not an interface type:
				1. *Throw:* a new TypeError.
			2. *Else:*
				1. *Return.*
		4. *Else:*
			1. *Fall through.*
	6. *Else:*
		1. *Fall through.*
	7. *If* `assigned` is set:
		8. *Let* `assignee_type` be *Unwrap:* `WriteTypeOf(assignee)`.
		9. *Return:* `TypeCheckAssign(assigned, assignee_type)`.
	8. *Else:*
		1. *Return.*
;



None! TypeCheck(SemanticStatementConditional stmt) :=
	1. *For each* `it` in `stmt.children`:
		1. *Perform:* *Unwrap:* `TypeCheck(it)`.
	2. *Assert:* `stmt.children.count` is greater than 1.
	3. *Assert:* `stmt.children.0` is a SemanticExpression.
	4. *Let* `condition_type` be *Unwrap:* `TypeOf(stmt.children.0)`.
	5. *If* *UnwrapAffirm:* `Subtype(condition_type, Boolean)` is `true`:
		1. *Return.*
	6. *Else:*
		1. *Throw:* a new TypeErrorNotAssignable.
;



None! TypeCheck(SemanticStatementLoop stmt) :=
	1. *For each* `it` in `stmt.children`:
		1. *Perform:* *Unwrap:* `TypeCheck(it)`.
	2. *Let* `condition` be an item `child` in `stmt.children` such that `child` is a SemanticExpression.
	3. *Assert:* `condition` is not *none*.
	4. *Let* `condition_type` be *Unwrap:* `TypeOf(condition)`.
	5. *If* *UnwrapAffirm:* `Subtype(condition_type, Boolean)` is `true`:
		1. *Return.*
	6. *Else:*
		1. *Throw:* a new TypeErrorNotAssignable.
;



None! TypeCheck(SemanticStatementIteration stmt) :=
	1. *Let* `typenode` be an item `child` in `stmt.children` such that `child` is a SemanticType.
	2. *Let* `iterable` be an item `child` in `stmt.children` such that `child` is a SemanticExpression.
	3. *Let* `block`    be an item `child` in `stmt.children` such that `child` is a SemanticBlock.
	4. *Assert:* `typenode` is not *none*.
	5. *Let* `assignee_type` be *Unwrap:* `TypeValueOf(typenode)`.
	6. *Assert:* `iterable` is not *none*.
	7. *Let* `iterable_type` be *Unwrap:* `TypeOf(iterable)`.
	8. *If* `iterable_type` is not a List type:
		1. *Throw:* a new TypeErrorNotAssignable.
	9. *Let* `item_type` be the type argument over `iterable_type`.
	10. *If* *UnwrapAffirm:* `Subtype(item_type, assignee_type)` is `false`:
		1. *Throw:* a new TypeErrorNotNarrow.
	11. *Assert:* `block` is not *none*.
	12. *If* `assignee` is not *none*:
		1. *Let* `validator` be the validator of `block`.
		2. *Assert:* `validator`’s symbol table contains a SymbolSchema `symbol` whose `id` is `assignee.id`.
		3. *Assert:* `symbol` is an instance of `SymbolSchemaVar`.
		4. *Set* `symbol.type` to `assignee_type`.
	13. *Perform:* *Unwrap:* `TypeCheck(block)`.
;



None! TypeCheckAssign(SemanticExpression assigned, Type assignee_type) :=
	1. *Let* `assigned_type` be *Unwrap:* `TypeOf(assigned)`.
	2. *If* *UnwrapAffirm:* `Subtype(assigned_type, assignee_type)` is `false`:
		1. *If* `assigned` is a SemanticExpressionCollection:
			1. *Return:* `AssignTo(assigned, assignee_type)`.
		2. *Else:*
			1. *Throw:* a new TypeErrorNotAssignable.
;
