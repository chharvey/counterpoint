/*
# Conventions

- «Value» refers to an IR value (a value on the conceptual stack).
- «Number», «Integer», «Natural», «Float», etc. all refer to IR values that are of those respective types. Their types are given by semantic analysis on the AST.
- Types starting with «TYPE.» and «VALUE.» refer to Counterpoint Language types and values respectively.
- Native types are referred to by «native-number», «native-bigint», and «native-string».

IR functions may have zero or more static parameters and consume zero or more dynamic arguments from the stack.
They may return one value back to the stack, or none at all.

Every function signature takes the form «‹NAME›(‹static params› [‹dynamic params›]) -> ‹return›;», where:
- ‹NAME› is an uppercase function name, optionally containg dots
- ‹static params› is a space-separated list of types representing statically known values
- ‹dynamic params› is a space-separated list of types representing dynamic IR values on the stack
- consecutive multiples of the same type «T» can be written as «T*» in shorthand
- « -> ‹return›» is optional — it means the function does not return a value.
*/



TRAP();

NULL.CONST (VALUE.Null)    -> Value;
BOOL.CONST (VALUE.Boolean) -> Value;
SYM.CONST  (VALUE.Symbol)  -> Value;
INT.CONST  (VALUE.Integer) -> Value;
NAT.CONST  (VALUE.Natural) -> Value;
FLOAT.CONST(VALUE.Float)   -> Value;
STR.CONST  (VALUE.String)  -> Value;

STR.TEMPLATE([Value*]) -> String;

GET(SymbolSchemaVar|native-string) -> Value;

TUPLE.NEW([Value*])                       -> Tuple;
RECORD.NEW(Vector<native-bigint, Value>*) -> Record;
LIST.NEW([Value*])                        -> List;
DICT.NEW(Vector<VALUE.Symbol, Value>*)    -> Dict;
SET.NEW([Value*])                         -> Set;
MAP.NEW(Vector<Value, Value>*)            -> Map;

TUPLE.GET (native-bigint [Value]) -> Value;
RECORD.GET(native-bigint [Value]) -> Value;
LIST.GET([Value Value])           -> Value;
DICT.GET([Value Value])           -> Value;
SET.GET ([Value Value])           -> Value;
MAP.GET ([Value Value])           -> Value;

LIST.COUNT([Value]) -> Value;
DICT.COUNT([Value]) -> Value;
SET.COUNT([Value])  -> Value;
MAP.COUNT([Value])  -> Value;

CALL([Value*]) -> Value;

ISNULL([Value]) -> Boolean;

NOT([Value])   -> Boolean;
EMP([Value])   -> Boolean;
NEG([Integer]) -> Integer;
NEG([Natural]) -> Natural;
NEG([Float])   -> Float;
NEG([Number])  -> Number;

TOINT([Number])   -> Integer;
TONAT([Number])   -> Natural;
TOFLOAT([Number]) -> Float;

INT.ADD([Integer Integer]) -> Integer;
INT.SUB([Integer Integer]) -> Integer;
INT.MUL([Integer Integer]) -> Integer;
INT.DIV([Integer Integer]) -> Integer;
INT.EXP([Integer Integer]) -> Integer;

NAT.ADD([Natural Natural]) -> Natural;
NAT.SUB([Natural Natural]) -> Natural;
NAT.MUL([Natural Natural]) -> Natural;
NAT.DIV([Natural Natural]) -> Natural;
NAT.EXP([Natural Natural]) -> Natural;

FLOAT.ADD([Float Float]) -> Float;
FLOAT.SUB([Float Float]) -> Float;
FLOAT.MUL([Float Float]) -> Float;
FLOAT.DIV([Float Float]) -> Float;
FLOAT.EXP([Float Float]) -> Float;

LT ([Number Number]) -> Boolean;
GT ([Number Number]) -> Boolean;
LE ([Number Number]) -> Boolean;
GE ([Number Number]) -> Boolean;
NLT([Number Number]) -> Boolean;
NGT([Number Number]) -> Boolean;

ID ([Value Value]) -> Boolean;
EQ ([Value Value]) -> Boolean;
NID([Value Value]) -> Boolean;
NEQ([Value Value]) -> Boolean;

PHI(‹label› -> Value, ‹label› -> Value) -> Value;

DROP([Value]);

DECL(SymbolSchemaVar|native-string Type [Value]);
SET (SymbolSchemaVar|native-string      [Value]);

LIST.SET([Value Value Value]);
DICT.SET([Value Value Value]);
SET.SET ([Value Value Value]);
MAP.SET ([Value Value Value]);

LIST.COPY([Value Value]);
DICT.COPY([Value Value]);
SET.COPY ([Value Value]);
MAP.COPY ([Value Value]);






Lower(Null    n) := (NULL.CONST  n);
Lower(Boolean b) := (BOOL.CONST  b);
Lower(Symbol  s) := (SYM.CONST   s);
Lower(Integer i) := (INT.CONST   i);
Lower(Natural n) := (NAT.CONST   n);
Lower(Float   f) := (FLOAT.CONST f);
Lower(String  s) := (STR.CONST   s);

Lower(SemanticProperty prop) := Sequence [`Symbol(prop.0)`, `Lower(prop.1)`];
Lower(SemanticCase     case) := Sequence [`Lower(case.0)`, `Lower(case.1)`];

Lower(SemanticConstant[type=TYPE.Null]    const) := (NULL.CONST  `Lower(ValueOf(const)~!)`);
Lower(SemanticConstant[type=TYPE.Boolean] const) := (BOOL.CONST  `Lower(ValueOf(const)~!)`);
Lower(SemanticConstant[type=TYPE.Symbol]  const) := (SYM.CONST   `Lower(ValueOf(const)~!)`);
Lower(SemanticConstant[type=TYPE.Integer] const) := (INT.CONST   `Lower(ValueOf(const)~!)`);
Lower(SemanticConstant[type=TYPE.Natural] const) := (NAT.CONST   `Lower(ValueOf(const)~!)`);
Lower(SemanticConstant[type=TYPE.Float]   const) := (FLOAT.CONST `Lower(ValueOf(const)~!)`);
Lower(SemanticConstant[type=TYPE.String]  const) := (STR.CONST   `Lower(ValueOf(const)~!)`);

Lower(SemanticTemplate tpl) := (STR.TEMPLATE `...tpl.children.map(Lower)`);

Lower(SemanticVariable var) := (GET `GetSymbolSchema(var)`);

Lower(SemanticTuple tup)  := (TUPLE.NEW  [`...tup.children.map(Lower)`]);
Lower(SemanticRecord rec) := (RECORD.NEW `...rec.children.map(Sequence [prop.0.id, Lower(prop.1)])`);
Lower(SemanticList list)  := (LIST.NEW   [`...list.children.map(Lower)`]);
Lower(SemanticDict dict)  := (DICT.NEW   `...dict.children.flatMap(Lower)`);
Lower(SemanticSet set)    := (SET.NEW    [`...set.children.map(Lower)`]);
Lower(SemanticMap map)    := (MAP.NEW    `...map.children.map(Lower)`);

Lower(SemanticAccess[kind=NORMAL] ::= SemanticExpression SemanticIndex) := (TUPLE.GET  `SemanticIndex.index` [`Lower(SemanticExpression)`]);
Lower(SemanticAccess[kind=NORMAL] ::= SemanticExpression SemanticKey)   := (RECORD.GET `SemanticKey.id`      [`Lower(SemanticExpression)`]);
Lower(SemanticAccess[kind=NORMAL] ::= SemanticExpression__0[type: TYPE.List] SemanticExpression__1) := (LIST.GET [`Lower(SemanticExpression__0)` `Lower(SemanticExpression__1)`]);
Lower(SemanticAccess[kind=NORMAL] ::= SemanticExpression__0[type: TYPE.Dict] SemanticExpression__1) := (DICT.GET [`Lower(SemanticExpression__0)` `Lower(SemanticExpression__1)`]);
Lower(SemanticAccess[kind=NORMAL] ::= SemanticExpression__0[type: TYPE.SET]  SemanticExpression__1) := (SET.GET  [`Lower(SemanticExpression__0)` `Lower(SemanticExpression__1)`]);
Lower(SemanticAccess[kind=NORMAL] ::= SemanticExpression__0[type: TYPE.MAP]  SemanticExpression__1) := (MAP.GET  [`Lower(SemanticExpression__0)` `Lower(SemanticExpression__1)`]);

Lower(SemanticExpressionBlock blex) := [
	...`blex.0.SemanticStatement.slice(0, 1).map(Lower)`
	return `Lower(blex.0.-1.SemanticExpression)`.
];

Lower(SemanticAccess[kind=MAYBE] access) := [
	(DECL ‹type› $tuple `Lower(access.0)`)
	(DECL ‹type› $result)
	(GOTO.IF (ISNULL (GET $tuple)) "then" "else")
	"then":
	(SET $result (NULL.CONST null))
	(GOTO "endif")
	"else":
	(SET $result `Lower(access[kind=NORMAL])`)
	(GOTO "endif")
	"endif":
	return (GET $result).
];

Lower(SemanticCall:has(SemanticVariable ::= "List") call) := (LIST.NEW);
Lower(SemanticCall:has(SemanticVariable ::= "Dict") call) := (DICT.NEW);
Lower(SemanticCall:has(SemanticVariable ::= "Set")  call) := (SET.NEW);
Lower(SemanticCall:has(SemanticVariable ::= "Map")  call) := (MAP.NEW);
Lower(SemanticCall:has(SemanticVariable ::= "List"):has(SemanticExpression) call) := [
	(DECL <List> $destination (LIST.NEW))
	(DECL ‹type› $arg `Lower(call.SemanticExpression.0)`)
	(LIST.COPY (GET $destination) (GET $arg))
	return (GET $destination).
];
Lower(SemanticCall:has(SemanticVariable ::= "Dict"):has(SemanticExpression) call) := [
	(DECL <Dict> $destination (DICT.NEW))
	(DECL ‹type› $arg `Lower(call.SemanticExpression.0)`)
	(DICT.COPY (GET $destination) (GET $arg))
	return (GET $destination).
];
Lower(SemanticCall:has(SemanticVariable ::= "Set"):has(SemanticExpression) call) := [
	(DECL <Set> $destination (SET.NEW))
	(DECL ‹type› $arg `Lower(call.SemanticExpression.0)`)
	(SET.COPY (GET $destination) (GET $arg))
	return (GET $destination).
];
Lower(SemanticCall:has(SemanticVariable ::= "Map"):has(SemanticExpression) call) := [
	(DECL <Map> $destination (MAP.NEW))
	(DECL ‹type› $arg `Lower(call.SemanticExpression.0)`)
	(MAP.COPY (GET $destination) (GET $arg))
	return (GET $destination).
];
Lower(SemanticCall call) := (CALL [`Lower(call.0)` `...call.SemanticExpression*.map(Lower)`]);

Lower(SemanticClaim claim) := Lower(claim.0);

Lower(SemanticOperation[operator=NOT] ::= SemanticExpression)               := (NOT [`SemanticExpression`]);
Lower(SemanticOperation[operator=EMP] ::= SemanticExpression)               := (EMP [`SemanticExpression`]);
Lower(SemanticOperation[operator=NEG] ::= SemanticExpression[type: Number]) := (NEG [`SemanticExpression`]);

Lower(SemanticOperation[operator=ADD][0: Integer][1: Integer] op) := (INT.ADD [`op.0` `op.1`]);
Lower(SemanticOperation[operator=SUB][0: Integer][1: Integer] op) := (INT.SUB [`op.0` `op.1`]);
Lower(SemanticOperation[operator=MUL][0: Integer][1: Integer] op) := (INT.MUL [`op.0` `op.1`]);
Lower(SemanticOperation[operator=DIV][0: Integer][1: Integer] op) := (INT.DIV [`op.0` `op.1`]);
Lower(SemanticOperation[operator=EXP][0: Integer][1: Integer] op) := (INT.EXP [`op.0` `op.1`]);

Lower(SemanticOperation[operator=ADD][0: Natural][1: Natural] op) := (NAT.ADD [`op.0` `op.1`]);
Lower(SemanticOperation[operator=SUB][0: Natural][1: Natural] op) := (NAT.SUB [`op.0` `op.1`]);
Lower(SemanticOperation[operator=MUL][0: Natural][1: Natural] op) := (NAT.MUL [`op.0` `op.1`]);
Lower(SemanticOperation[operator=DIV][0: Natural][1: Natural] op) := (NAT.DIV [`op.0` `op.1`]);
Lower(SemanticOperation[operator=EXP][0: Natural][1: Natural] op) := (NAT.EXP [`op.0` `op.1`]);

Lower(SemanticOperation[operator=ADD][0: Float][1: Float] op) := (FLOAT.ADD [`op.0` `op.1`]);
Lower(SemanticOperation[operator=SUB][0: Float][1: Float] op) := (FLOAT.SUB [`op.0` `op.1`]);
Lower(SemanticOperation[operator=MUL][0: Float][1: Float] op) := (FLOAT.MUL [`op.0` `op.1`]);
Lower(SemanticOperation[operator=DIV][0: Float][1: Float] op) := (FLOAT.DIV [`op.0` `op.1`]);
Lower(SemanticOperation[operator=EXP][0: Float][1: Float] op) := (FLOAT.EXP [`op.0` `op.1`]);

Lower(SemanticOperation[operator=LT] [0: Number][1: Number] op) := (LT  [`op.0` `op.1`]);
Lower(SemanticOperation[operator=GT] [0: Number][1: Number] op) := (GT  [`op.0` `op.1`]);
Lower(SemanticOperation[operator=LE] [0: Number][1: Number] op) := (LE  [`op.0` `op.1`]);
Lower(SemanticOperation[operator=GE] [0: Number][1: Number] op) := (GE  [`op.0` `op.1`]);
Lower(SemanticOperation[operator=NLT][0: Number][1: Number] op) := (NLT [`op.0` `op.1`]);
Lower(SemanticOperation[operator=NGT][0: Number][1: Number] op) := (NGT [`op.0` `op.1`]);

Lower(SemanticOperation[operator=ID]  op) := (ID  [`op.0` `op.1`]);
Lower(SemanticOperation[operator=EQ]  op) := (EQ  [`op.0` `op.1`]);
Lower(SemanticOperation[operator=NID] op) := (NID [`op.0` `op.1`]);
Lower(SemanticOperation[operator=NEQ] op) := (NEQ [`op.0` `op.1`]);


Lower(SemanticOperation[operator=AND] op) := [
	(DECL ‹type› $left `Lower(op.0)`)
	(DECL ‹type› $result)
	(GOTO.IF (GET $left) "then" "else")
	"then":
	(SET $result `Lower(op.1)`)
	(GOTO "endif")
	"else":
	(SET $result (GET $left))
	(GOTO "endif")
	"endif":
	return (GET $result).
];

Lower(SemanticOperation[operator=OR] op) := [
	(DECL ‹type› $left `Lower(op.0)`)
	(DECL ‹type› $result)
	(GOTO.IF (GET $left) "then" "else")
	"then":
	(SET $result (GET $left))
	(GOTO "endif")
	"else":
	(SET $result `Lower(op.1)`)
	(GOTO "endif")
	"endif":
	return (GET $result).
];

Lower(SemanticOperation[operator=COND] op) := [
	(DECL ‹type› $result)
	(GOTO.IF `Lower(op.0)` "then" "else")
	"then":
	(SET $result `Lower(op.1)`)
	(GOTO "endif")
	"else":
	(SET $result `Lower(op.2)`)
	(GOTO "endif")
	"endif":
	return (GET $result).
];

Lower(SemanticDeclarationType decl) := [];

Lower(SemanticDeclarationVariable:has(SemanticVariable):has(SemanticExpression) decl) := [
	(DECL ‹type› `GetSymbolSchema(decl.0)` `Lower(decl.2)`)
];
Lower(SemanticDeclarationVariable:has(SemanticVariable) decl) := [
	(DECL <null> `GetSymbolSchema(decl.0)` (NULL.CONST null))
];
Lower(SemanticDeclarationVariable decl):has(SemanticVariable) := [
	(DROP `Lower(decl.1)`)
];

Lower(SemanticStatementExpression:has(SemanticExpression) stmt) := [
	(DROP `Lower(stmt.0)`)
];
Lower(SemanticStatementExpression stmt) := [];

Lower(SemanticStatementClaim stmt) := [
	(DROP `Lower(stmt.0)`)
];

Lower(SemanticStatementReassignment:has(SemanticVariable) stmt) := [
	(SET `GetSymbolSchema(stmt.0)` `Lower(stmt.1)`)
];
Lower(SemanticStatementReassignment ::= (SemanticAccess ::= SemanticExpression[type: TYPE.List] SemanticExpression) SemanticExpression) := (LIST.SET [`Lower(SemanticAccess.0)` `Lower(SemanticAccess.1)` `Lower(SemanticExpression)`]);
Lower(SemanticStatementReassignment ::= (SemanticAccess ::= SemanticExpression[type: TYPE.Dict] SemanticExpression) SemanticExpression) := (DICT.SET [`Lower(SemanticAccess.0)` `Lower(SemanticAccess.1)` `Lower(SemanticExpression)`]);
Lower(SemanticStatementReassignment ::= (SemanticAccess ::= SemanticExpression[type: TYPE.SET]  SemanticExpression) SemanticExpression) := (SET.SET  [`Lower(SemanticAccess.0)` `Lower(SemanticAccess.1)` `Lower(SemanticExpression)`]);
Lower(SemanticStatementReassignment ::= (SemanticAccess ::= SemanticExpression[type: TYPE.MAP]  SemanticExpression) SemanticExpression) := (MAP.SET  [`Lower(SemanticAccess.0)` `Lower(SemanticAccess.1)` `Lower(SemanticExpression)`]);

Lower(SemanticStatementConditional[unless=false] ::= SemanticExpression SemanticBlock) := [
	(GOTO.IF `Lower(SemanticExpression)` "then" "endif")
	"then":
	...`Lower(SemanticBlock)`
	(GOTO "endif")
	"endif":
];
Lower(SemanticStatementConditional[unless=true] ::= SemanticExpression SemanticBlock) := [
	(GOTO.IF (NOT `Lower(SemanticExpression)`) "then" "endif")
	"then":
	...`Lower(SemanticBlock)`
	(GOTO "endif")
	"endif":
];
Lower(SemanticStatementConditional[unless=false] ::= SemanticExpression SemanticBlock__0 SemanticBlock__1) := [
	(GOTO.IF `Lower(SemanticExpression)` "then" "else")
	"then":
	...`Lower(SemanticBlock__0)`
	(GOTO "endif")
	"else":
	...`Lower(SemanticBlock__1)`
	(GOTO "endif")
	"endif":
];
Lower(SemanticStatementConditional[unless=false] ::= SemanticExpression SemanticBlock SemanticStatementConditional) := [
	(GOTO.IF `Lower(SemanticExpression)` "then" "else")
	"then":
	...`Lower(SemanticBlock)`
	(GOTO "endif")
	"else":
	...`Lower(SemanticStatementConditional)`
	(GOTO "endif")
	"endif":
];

Lower(SemanticStatementLoop[doFirst=false][until=false] ::= SemanticExpression SemanticBlock) := [
	(GOTO "while")
	"while":
	(GOTO.IF `Lower(SemanticExpression)` "do" "endwhile")
	"do":
	...`Lower(SemanticBlock)`
	(GOTO "while")
	"endwhile":
];
Lower(SemanticStatementLoop[doFirst=false][until=true] ::= SemanticExpression SemanticBlock) := [
	(GOTO "while")
	"while":
	(GOTO.IF (NOT `Lower(SemanticExpression)`) "do" "endwhile")
	"do":
	...`Lower(SemanticBlock)`
	(GOTO "while")
	"endwhile":
];
Lower(SemanticStatementLoop[doFirst=true][until=false] ::= SemanticExpression SemanticBlock) := [
	(GOTO "do")
	"do":
	...`Lower(SemanticBlock)`
	(GOTO "while")
	"while":
	(GOTO.IF `Lower(SemanticExpression)` "do" "endwhile")
	"endwhile":
];
Lower(SemanticStatementLoop[doFirst=true][until=true] ::= SemanticExpression SemanticBlock) := [
	(GOTO "do")
	"do":
	...`Lower(SemanticBlock)`
	(GOTO "while")
	"while":
	(GOTO.IF (NOT `Lower(SemanticExpression)`) "do" "endwhile")
	"endwhile":
];

Lower(SemanticStatementIteration ::= SemanticVariable SemanticType SemanticExpression SemanticBlock) := [
	(DECL <List> $iterable `Lower(SemanticExpression)`)
	(DECL <nat> $index (NAT.CONST +0))
	(GOTO "while")
	"while":
	(GOTO.IF (LT (GET $index) (LIST.COUNT (GET $iterable))) "do" "endwhile")
	"do":
	(DECL ‹type› `GetSymbolSchema(SemanticVariable)` (LIST.GET (GET $iterable) (GET $index)))
	...`Lower(SemanticBlock)`
	(SET $index (NAT.ADD (GET $index) (NAT.CONST +1)))
	(GOTO "while")
	"endwhile":
];
Lower(SemanticStatementIteration ::= SemanticType SemanticExpression SemanticBlock) := [
	(DECL <List> $iterable `Lower(SemanticExpression)`)
	(DECL <nat> $index (NAT.CONST +0))
	(GOTO "while")
	"while":
	(GOTO.IF (LT (GET $index) (LIST.COUNT (GET $iterable))) "do" "endwhile")
	"do":
	...`Lower(SemanticBlock)`
	(SET $index (NAT.ADD (GET $index) (NAT.CONST +1)))
	(GOTO "while")
	"endwhile":
];

Lower(SemanticStatementBreak[skip=false] stmt) := [ (GOTO "endwhile") ];
Lower(SemanticStatementBreak[skip=true]  stmt) := [ (GOTO "while") ];

Lower(SemanticBlock block) := block.children.map(Lower);

Lower(SemanticGoal goal) := [
	"start":
	`Lower(goal.0)`
];



SymbolSchemaVar GetSymbolSchema(SemanticVariable var) :=
	1. *Assert:* the validator’s symbol table contains a SymbolSchemaVar `symbol` whose `id` is `var.id`.
	2. *Return:* `symbol`.
;
