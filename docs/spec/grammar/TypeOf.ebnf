Type TypeOf(SemanticConstant const) :=
	1. *Let* `interpreterValue` be `const.value`.
	2. *Return:* `ToType(interpreterValue)`.
;



Type TypeOf(SemanticExpressionTemplate template) :=
	1. *Return:* `String`.
;



Type TypeOf(SemanticExpressionVariable var) :=
	1. *Assert:* The validator’s symbol table contains a SymbolSchema `symbol` whose `id` is `var.id`.
	2. *Assert:* `symbol` is an instance of `SymbolSchemaVar`.
	3. *If* `symbol.isUninitialized` is `true`:
		1. *Return:* `Maybe(symbol.type)`.
	4. *Else:*
		1. *Return:* `symbol.type`.
;



Type! TypeOf(SemanticExpressionTuple tuple) :=
	1. *Let* `data` be a new Sequence.
	2. *For each* `item` in `tuple`:
		1. *Let* `typedatum` be a new EntryTypeSchema [
			type=     *Unwrap:* `TypeOf(item)`,
			optional= `false`,
		].
		2. *If* *UnwrapAffirm:* `IsBottomType(typedatum.type)` is `true`:
			1. *Return:* `Nothing`.
		3. Push `typedatum` to `data`.
	3. *Return:* a new Tuple type containing the items in `data`.
;



Type! TypeOf(SemanticExpressionRecord record) :=
	1. *Let* `data` be a new Schema.
	2. *For each* `property` in `record`:
		1. *Assert:* `property.children.count` is 2.
		2. *Let* `typedatum` be a new EntryTypeSchema [
			type=     *Unwrap:* `TypeOf(property.children.1)`,
			optional= `false`,
		].
		3. *If* *UnwrapAffirm:* `IsBottomType(typedatum.type)` is `true`:
			1. *Return:* `Nothing`.
		4. Set the property `property.children.0.id` on `data` to the value `typedatum`.
	3. *Return:* a new Record type containing the properties in `data`.
;



Type! TypeOf(SemanticExpressionList list) :=
	1. *Let* `types` be a mapping of `list` for each `it` to *Unwrap:* `TypeOf(it)`.
	2. *If* `types` contains `Nothing`:
		1. *Return:* `Nothing`.
	3. *Let* `t` be `Union(...types)`.
	4. *Return:* a new mutable List type whose types are `t`.
;



Type! TypeOf(SemanticExpressionDict dict) :=
	1. *Let* `types` be a mapping of `dict` for each `prop` to *Unwrap:* `TypeOf(prop.children.1)`.
	2. *If* `types` contains `Nothing`:
		1. *Return:* `Nothing`.
	3. *Let* `t` be `Union(...types)`.
	4. *Return:* a new mutable Dict type whose types are `t`.
;



Type! TypeOf(SemanticExpressionSet set) :=
	1. *Let* `types` be a mapping of `set` for each `el` to *Unwrap:* `TypeOf(el)`.
	2. *If* `types` contains `Nothing`:
		1. *Return:* `Nothing`.
	3. *Let* `t` be *UnwrapAffirm:* `Union(...types)`.
	4. *Return:* a new mutable Set type whose types are `t`.
;



Type! TypeOf(SemanticExpressionMap map) :=
	1. *Let* `ant_types` be a mapping of `map` for each `case` to *Unwrap:* `TypeOf(case.children.0)`.
	2. *Let* `con_types` be a mapping of `map` for each `case` to *Unwrap:* `TypeOf(case.children.1)`.
	3. *If* `ant_types` contains `Nothing`:
		1. *Return:* `Nothing`.
	4. *If* `con_types` contains `Nothing`:
		1. *Return:* `Nothing`.
	5. *Let* `k` be *UnwrapAffirm:* `Union(...ant_types)`.
	6. *Let* `v` be *UnwrapAffirm:* `Union(...con_types)`.
	7. *Return:* a new mutable Map type whose antecedent types are `k` and whose consequent types are `v`.
;



Type! TypeOf(SemanticExpressionBlock ::= SemanticBlock) :=
	1. *If* *UnwrapAffirm:* `CompletionOf(SemanticBlock)` is not *NORMAL*:
		1. *Return:* `Nothing`.
	2. *Else:*
		1. Fall through.
	3. *Assert:* `SemanticBlock.children.count` is greater than 0.
	4. *Let* `last_stmt` be `SemanticBlock.children.-1`.
	5. *If* `last_stmt` is not a SemanticStatementExpression:
		1. *Throw:* a new Error.
	6. *If* `last_stmt.children.count` is less than 1:
		1. *Throw:* a new Error.
	7. *Let* `expr` be `last_stmt.children.0`.
	8. *Assert:* `expr` is a SemanticExpression.
	9. *Return:* `TypeOf(expr)`.
;



Type! TypeOf(SemanticExpressionAccess[kind=NORMAL] ::= SemanticExpression__0 (SemanticIndex | SemanticKey | SemanticExpression__1)) :=
	1. *Let* `base_type` be *Unwrap:* `TypeOf(SemanticExpression__0)`.
	2. *If* *UnwrapAffirm:* `IsBottomType(base_type)` is `true`:
		1. *Return:* `Nothing`.
	3. *Else:*
		1. Fall through.
	4. *Let* `entry` be *Unwrap:* `GetEntryInfo(base_type, SemanticExpressionAccess, false)`.
	5. *If* `entry.optional` is `true`:
		1. *Set* `SemanticExpressionAccess.isEntryOptional` to `true`.
		2. *Set* `entry.type` to `Maybe(entry.type)`.
	6. *Else:*
		1. *Set* `SemanticExpressionAccess.isEntryOptional` to `false`.
	7. *Return:* `entry.type`.
;
Type! TypeOf(SemanticExpressionAccess[kind=MAYBE] ::= SemanticExpression__0 (SemanticIndex | SemanticKey | SemanticExpression__1)) :=
	1. *Let* `base_type` be *Unwrap:* `TypeOf(SemanticExpression__0)`.
	2. *If* *UnwrapAffirm:* `IsBottomType(base_type)` is `true`:
		1. *Return:* `Nothing`.
	3. *Else:*
		1. Fall through.
	4. *If* `base_type` is a Maybe type:
		1. *Let* `entry` be *Unwrap:* `GetEntryInfo(base_type.typearg, SemanticExpressionAccess, false)`.
		2. *If* `entry.optional` is `true`:
			1. *Set* `SemanticExpressionAccess.isEntryOptional` to `true`.
			2. *Set* `entry.type` to `Maybe(entry.type)`.
		3. *Else:*
			1. *Set* `SemanticExpressionAccess.isEntryOptional` to `false`.
		4. *Return:* `Maybe(entry.type)`.
	5. *Else:*
		1. *Throw:* a new TypeErrorInvalidOperation.
;
Type! TypeOf(SemanticExpressionAccess[kind=RESULT] ::= SemanticExpression__0 (SemanticIndex | SemanticKey | SemanticExpression__1)) :=
	1. *Let* `base_type` be *Unwrap:* `TypeOf(SemanticExpression__0)`.
	2. *If* *UnwrapAffirm:* `IsBottomType(base_type)` is `true`:
		1. *Return:* `Nothing`.
	3. *Else:*
		1. Fall through.
	4. *If* `base_type` is a Result type:
		1. *Let* `entry` be *Unwrap:* `GetEntryInfo(base_type.typeargSuccess, SemanticExpressionAccess, false)`.
		2. *If* `entry.optional` is `true`:
			1. *Set* `SemanticExpressionAccess.isEntryOptional` to `true`.
			2. *Set* `entry.type` to `Maybe(entry.type)`.
		3. *Else:*
			1. *Set* `SemanticExpressionAccess.isEntryOptional` to `false`.
		4. *Return:* `Result(entry.type)`.
	5. *Else:*
		1. *Throw:* a new TypeErrorInvalidOperation.
;



Type! TypeOf(SemanticExpressionCall ::= SemanticExpression__0 SemanticType* SemanticExpression__1* SemanticProperty*) :=
	1. *Let* `base_types` be an empty Sequence.
	2. *Let* `schema` be *nil*.
	3. *If* `SemanticExpression__0` is a SemanticExpressionVariable:
		1. *Assert:* The validator’s symbol table contains a SymbolSchema `symbol` whose `id` is `SemanticExpression__0.id`.
		2. *Set* `schema` to `symbol`.
	4. *Else:*
		1. Fall through.
	5. *If* `schema` is an instance of `SymbolSchemaFunc`:
		1. *Set* `base_types` to `schema.types`.
	6. *Else:*
		1. *Let* `basetype` be *Unwrap:* `TypeOf(SemanticExpression__0)`.
		2. *Set* `base_types` to a new Sequence [`basetype`].
	7. *For each* `type` in `base_types`:
		1. *If* *UnwrapAffirm:* `IsBottomType(type)` is `true`:
			1. *Return:* `Nothing`.
		2. *Else:*
			1. Fall through.
	8. *For each* `it` in `SemanticExpression__1*`:
		1. *Let* `arg_type` be *Unwrap:* `TypeOf(it)`.
		2. *If* *UnwrapAffirm:* `IsBottomType(arg_type)` is `true`:
			1. *Return:* `Nothing`.
		3. *Else:*
			1. Fall through.
	9. *For each* `it ::= SemanticKey SemanticExpression__2` in `SemanticProperty*`:
		1. *Let* `arg_type` be *Unwrap:* `TypeOf(SemanticExpression__2)`.
		2. *If* *UnwrapAffirm:* `IsBottomType(arg_type)` is `true`:
			1. *Return:* `Nothing`.
		3. *Else:*
			1. Fall through.
	10. *Assert:* `base_types.count` is greater than *0*.
	11. *Let* `successes` be an empty Sequence.
	12. *Let* `failures` be an empty Sequence.
	13. *For each* `type` in `base_types`:
		1. *Perform:* the following substeps and save the result:
			1. *If* `type` is not a Function type:
				1. *Throw:* a new TypeErrorNotCallable.
			2. *Else:*
				1. Fall through.
			3. *Let* `paramsPosit` be a Sequence of the positional parameter types in `type`.
			4. *Let* `paramsNamed` be a Schema of the named parameter types in `type`.
			5. *If* `SemanticExpression__1*.count` is less than the number of required positional parameters:
				1. *Throw:* a new TypeErrorArgCount.
			6. *Else If* `SemanticExpression__1*.count` is greater than the number of total positional parameters:
				1. *Throw:* a new TypeErrorArgCount.
			7. *Else:*
				1. Fall through.
			8. *Let* `argsPosit` be a new SemanticExpressionTuple containing `SemanticExpression__1*`.
			9. *Let* `tupleType` be a new Tuple type containing `paramsPosit`.
			10. *Perform:* *Unwrap:* `AssignTo(argsPosit, tupleType)`.
			11. *Let* `argsNamed` be a new SemanticExpressionRecord containing `SemanticProperty*`.
			12. *Let* `recordType` be a new Record type containing `paramsNamed`.
			13. *Perform:* *Unwrap:* `AssignTo(argsNamed, recordType)`.
			14. *If* `type` has a return type:
				1. *Return:* the return type of `type`.
			15. *Else:*
				1. *Throw:* a new Error "Void function return types are not yet supported.".
		2. *If* the result of the above substeps is a normal completion:
			1. Push the result to `successes`.
		3. *Else:*
			1. Push the result to `failures`.
	14. *If* `successes.count` is greater than *0*:
		1. *Let* `maximal` be the unique maximally specific overload, if it exists.
		2. *If* `maximal` is not *nil*:
			1. *Return:* the corresponding item in `successes`.
		3. *Else:*
			1. *Throw:* a new TypeErrorAmbiguousOverload.
	15. *Else If* `failures.count` is greater than *1*:
		1. *Throw:* a new TypeErrorAmbiguousOverload.
	16. *Else:*
		1. *Assert*: `failures.count` is *1*.
		2. *Throw:* `failures.0`.
;



Type! TypeOf(SemanticExpressionClaim claim) :=
	1. *Note:* This algorithm overrides `TypeOf(SemanticExpression)`.
	2. *Assert:* `claim.children.count` is 2.
	3. *Let* `computed_type` be *Unwrap:* `TypeOf(claim.children.0)`.
	4. *Let* `claimed_type` be *Unwrap:* `TypeValueOf(claim.children.1)`.
	5. *If* `claim.force` is `false` *and* *UnwrapAffirm:* `AreDisjoint(computed_type, claimed_type)` is `true` *and* *UnwrapAffirm:* `IsBottomType(computed_type)` is `false` *and* *UnwrapAffirm:* `IsBottomType(claimed_type)` is `false`:
		1. *Throw:* a new TypeErrorNotAssignable.
	6. *Return:* `claimed_type`.
;



Type! TypeOf(SemanticExpressionOperation[operator=UN_MAYBE] ::= SemanticExpression) :=
	1. *Let* `operand` be *Unwrap:* `TypeOf(SemanticExpression)`.
	2. *If* `operand` is not a Maybe type:
		1. *Throw:* a new TypeErrorInvalidOperation.
	3. *Let* `valuetype` be the type argument to `operand`.
	4. *Return:* `valuetype`.
;

Type! TypeOf(SemanticExpressionOperation[operator=UN_RESULT] ::= SemanticExpression) :=
	1. *Let* `operand` be *Unwrap:* `TypeOf(SemanticExpression)`.
	2. *If* `operand` is not a Result type:
		1. *Throw:* a new TypeErrorInvalidOperation.
	3. *Let* `valuetype` be the first type argument to `operand`.
	4. *Return:* `valuetype`.
;

Type! TypeOf(SemanticExpressionOperation[operator: NOT] expr) :=
	1. *Assert:* `expr.children.count` is 1.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	4. *If* *UnwrapAffirm:* `IsDefinitelyFalsy(t0)` is `true`:
		1. *Return:* `ToType(true)`.
	5. *Else If* *UnwrapAffirm:* `IsDefinitelyTruthy(t0)` is `true`:
		1. *Return:* `ToType(false)`.
	6. *Else:*
		1. *Return:* `Boolean`.
;

Type! TypeOf(SemanticExpressionOperation[operator: EMP] expr) :=
	1. *Assert:* `expr.children.count` is 1.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	4. *Else If* *UnwrapAffirm:* `IsDefinitelyFalsy(t0)` is `true`:
		1. *Return:* `ToType(true)`.
	5. *Else:*
		1. *Return:* `Boolean`.
;

Type! TypeOf(SemanticExpressionOperation[operator: NEG] expr) :=
	1. *Assert:* `expr.children.count` is 1.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	4. *Else If* *UnwrapAffirm:* `Subtype(t0, Union(Integer, Float))` is `true`:
		1. *Return:* `t0`.
	5. *Else:*
		1. *Throw:* a new TypeErrorInvalidOperation.
;

Type! TypeOf(SemanticExpressionOperation[operator: IS] ::= SemanticExpression__0 SemanticExpression__1[type: Class]) :=
	1. *Let* `t0` be *Unwrap:* `TypeOf(SemanticExpression__0)`.
	2. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	3. *Return:* `Boolean`.
;

Type! TypeOf(SemanticExpressionOperation[operator: CAST] ::= SemanticExpression__0 SemanticExpression__1[type: Class]) :=
	1. *Let* `t0` be *Unwrap:* `TypeOf(SemanticExpression__0)`.
	2. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	3. *Let* `t1` be the class identified by `SemanticExpression__1`.
	4. *If* `Subtype(t1, t0)` is `true`:
		1. *Return:* `t1`.
	5. *Else:*
		1. *Throw:* a new TypeErrorNotNarrow.
;

Type! TypeOf(SemanticExpressionOperation[operator: MAYBE] ::= SemanticExpression__0 SemanticExpression__1[type: Class]) :=
	1. *Let* `t0` be *Unwrap:* `TypeOf(SemanticExpression__0)`.
	2. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	3. *Let* `t1` be the class identified by `SemanticExpression__1`.
	4. *If* `Subtype(t1, t0)` is `true`:
		1. *Return:* `Maybe(t1)`.
	5. *Else:*
		1. *Throw:* a new TypeErrorNotNarrow.
;

Type! TypeOf(SemanticExpressionOperation[operator: EXP | MUL | DIV | ADD | SUB] expr) :=
	1. *Assert:* `expr.children.count` is 2.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *Let* `t1` be *Unwrap:* `TypeOf(expr.children.1)`.
	4. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true` *or* *UnwrapAffirm:* `IsBottomType(t1)` is `true`:
		1. *Return:* `Nothing`.
	5. *Else If* *UnwrapAffirm:* `Subtype(t0, Integer)` is `true` *and* *UnwrapAffirm:* `Subtype(t1, Integer)` is `true`:
		1. *Return:* `Integer`.
	6. *Else If* *UnwrapAffirm:* `Subtype(t0, Natural)` is `true` *and* *UnwrapAffirm:* `Subtype(t1, Natural)` is `true`:
		1. *Return:* `Natural`.
	7. *Else If* *UnwrapAffirm:* `Subtype(t0, Float)` is `true` *and* *UnwrapAffirm:* `Subtype(t1, Float)` is `true`:
		1. *Return:* `Float`.
	8. *Else:*
		1. *Throw:* a new TypeErrorInvalidOperation.
;

Type! TypeOf(SemanticExpressionOperation[operator: LT | GT | LE | GE] expr) :=
	1. *Assert:* `expr.children.count` is 2.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *Let* `t1` be *Unwrap:* `TypeOf(expr.children.1)`.
	4. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true` *or* *UnwrapAffirm:* `IsBottomType(t1)` is `true`:
		1. *Return:* `Nothing`.
	5. *Else If* *UnwrapAffirm:* `Subtype(t0, Number)` is `true` *and* *UnwrapAffirm:* `Subtype(t1, Number)` is `true`:
		1. *Return:* `Boolean`.
	6. *Else:*
		1. *Throw:* a new TypeErrorInvalidOperation.
;

Type! TypeOf(SemanticExpressionOperation[operator: ID | EQ] expr) :=
	1. *Assert:* `expr.children.count` is 2.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *Let* `t1` be *Unwrap:* `TypeOf(expr.children.1)`.
	4. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true` *or* *UnwrapAffirm:* `IsBottomType(t1)` is `true`:
		1. *Return:* `Nothing`.
	5. *If* *UnwrapAffirm:* `AreDisjoint(t0, t1)` is `true`:
		1. *If* `operator` is `ID`:
			1. *Return:* `ToType(false)`.
		2. *If* *UnwrapAffirm:* `AreDisjoint(t0, Number)` is `true` *or* *UnwrapAffirm:* `AreDisjoint(t1, Number)` is `true`:
			1. *Return:* `ToType(false)`.
	6. *Return:* `Boolean`.
;

Type! TypeOf(SemanticExpressionOperation[operator: AND] expr) :=
	1. *Assert:* `expr.children.count` is 2.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *Let* `t1` be *Unwrap:* `TypeOf(expr.children.1)`.
	4. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	5. *If* *UnwrapAffirm:* `IsDefinitelyFalsy(t0)` is `true`:
		1. *Return:* `t0`.
	6. *Else If* *UnwrapAffirm:* `IsDefinitelyTruthy(t0)` is `true`:
		1. *Return:* `t1`.
	7. *Else:*
		1. *Return:* `Union(FalsySide(t0), t1)`.
;

Type! TypeOf(SemanticExpressionOperation[operator: OR] expr) :=
	1. *Assert:* `expr.children.count` is 2.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *Let* `t1` be *Unwrap:* `TypeOf(expr.children.1)`.
	4. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	5. *If* *UnwrapAffirm:* `IsDefinitelyFalsy(t0)` is `true`:
		1. *Return:* `t1`.
	6. *Else If* *UnwrapAffirm:* `IsDefinitelyTruthy(t0)` is `true`:
		1. *Return:* `t0`.
	7. *Else:*
		1. *Return:* `Union(TruthySide(t0), t1)`.
;

Type! TypeOf(SemanticExpressionOperation[operator: COND] expr) :=
	1. *Assert:* `expr.children.count` is 3.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *Let* `t1` be *Unwrap:* `TypeOf(expr.children.1)`.
	4. *Let* `t2` be *Unwrap:* `TypeOf(expr.children.2)`.
	5. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	6. *If* *UnwrapAffirm:* `Subtype(t0, Boolean)` is `true`:
		1. *If* `t0` is `ToType(false)`:
			1. *Return:* `t2`.
		2. *If* `t0` is `ToType(true)`:
			1. *Return:* `t1`.
		3. *Return:* `Union(t1, t2)`.
	7. *Else:*
		1. *Throw:* a new TypeErrorInvalidOperation.
;



Type! TypeOf(SemanticExpressionSwitch ::= SemanticExpression__0 SemanticCase* SemanticExpression__1) :=
	1. *Let* `t_value` be *Unwrap:* `TypeOf(SemanticExpression__0)`.
	2. *If* *UnwrapAffirm:* `IsBottomType(t_value)` is `true`:
		1. *Return:* `Nothing`.
	3. *Let* `union` be `Nothing`.
	4. *For each* `case` in `SemanticCase*`:
		1. *Assert:* `case` matches `SemanticCase ::= SemanticExpression__2+ SemanticExpression__3`.
		2. *For each* `ant` in `SemanticExpression__2+`:
			1. *Perform:* *Unwrap:* `TypeOf(ant)`;
		3. *Let* `t_con` be *Unwrap:* `TypeOf(SemanticExpression__3)`.
		4. *Set* `union` to *UnwrapAffirm:* `Union(union, t_con)`.
	5. *Let* `t_default` be *Unwrap:* `TypeOf(SemanticExpression__1)`.
	6. *Set* `union` to *UnwrapAffirm:* `Union(union, t_default)`.
	7. *Return:* `union`.
;



Type! TypeOf(SemanticExpressionFunction fn) :=
	1. *Let* `parameters` be a filtering of `fn.children` for each `child` such that `child` is a SemanticParameterFunction.
	2. *Let* `positional_params` be a filtering of `parameters` for each `param` such that `param.named` is `false`.
	3. *Let* `positional_param_types` be a new Sequence.
	4. *For each* `param` in `positional_params`:
		1. *Assert:* `param.children.count` is *1*.
		2. *Let* `typedatum` be a new EntryTypeSchema [
			type=     *Unwrap:* `TypeValueOf(param.children.0)`,
			optional= `param.optional`,
		].
		3. Push `typedatum` to `positional_param_types`.
	5. *Let* `named_params` be a filtering of `parameters` for each `param` such that `param.named` is `true`.
	6. *Let* `named_param_types` be a new Schema.
	7. *For each* `param` in `named_params`:
		1. *If* `param.children.count` is *2*:
			1. *Let* `key_id` be `param.children.0.id`.
			2. *Let* `param_type` be *Unwrap:* `TypeValueOf(param.children.1)`.
		2. *Else:*
			1. *Assert:* `param.children.count` is *1*.
			2. *Assert:* `param.id` is set.
			3. *Let* `key_id` be `param.id`.
			4. *Let* `param_type` be *Unwrap:* `TypeValueOf(param.children.0)`.
		3. *Let* `typedatum` be a new EntryTypeSchema [
			type=     `param_type`,
			optional= `param.optional`,
		].
		4. Set the property `key_id` on `named_param_types` to the value `typedatum`.
	8. *Let* `return_type` be an item `child` in `fn.children` such that `child` is a SemanticType.
	9. *Return:* a new Function type whose positional parameter types are `positional_param_types`,
		whose named parameter types are `named_param_types`,
		and, if `return_type` is set, whose return type is `return_type`,
		otherwise, who does not contain a return type.
;



Type ToType(Or<Null, Boolean, Symbol, Number, String> v) :=
	1. *Return:* a new Type containing only the value `v`.
;
