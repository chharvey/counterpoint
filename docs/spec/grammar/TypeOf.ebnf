Type TypeOf(SemanticConstant const) :=
	1. *Let* `interpreterValue` be `const.value`.
	2. *Return:* `ToType(interpreterValue)`.
;



Type TypeOf(SemanticExpressionTemplate template) :=
	1. *Return:* `String`.
;



Type TypeOf(SemanticExpressionVariable var) :=
	1. *Assert:* The validator’s symbol table contains a SymbolSchema `symbol` whose `id` is `var.id`.
	2. *Assert:* `symbol` is an instance of `SymbolSchemaVar`.
	3. *If* `symbol.isUninitialized` is `true`:
		1. *Return:* `Maybe(symbol.type)`.
	4. *Else:*
		1. *Return:* `symbol.type`.
;



Type! TypeOf(SemanticExpressionTuple tuple) :=
	1. *Let* `data` be a new Sequence.
	2. *For each* `item` in `tuple`:
		1. *Let* `typedatum` be a new EntryTypeSchema [
			type=     *Unwrap:* `TypeOf(item)`,
			optional= `false`,
		].
		2. *If* *UnwrapAffirm:* `IsBottomType(typedatum.type)` is `true`:
			1. *Return:* `Nothing`.
		3. Push `typedatum` to `data`.
	3. *Return:* a new Tuple type containing the items in `data`.
;



Type! TypeOf(SemanticExpressionRecord record) :=
	1. *Let* `data` be a new Schema.
	2. *For each* `property` in `record`:
		1. *Assert:* `property.children.count` is 2.
		2. *Let* `typedatum` be a new EntryTypeSchema [
			type=     *Unwrap:* `TypeOf(property.children.1)`,
			optional= `false`,
		].
		3. *If* *UnwrapAffirm:* `IsBottomType(typedatum.type)` is `true`:
			1. *Return:* `Nothing`.
		4. Set the property `property.children.0.id` on `data` to the value `typedatum`.
	3. *Return:* a new Record type containing the properties in `data`.
;



Type! TypeOf(SemanticExpressionList list) :=
	1. *Let* `types` be a mapping of `list` for each `it` to *Unwrap:* `TypeOf(it)`.
	2. *If* `types` contains `Nothing`:
		1. *Return:* `Nothing`.
	3. *Let* `t` be `Union(...types)`.
	4. *Return:* a new mutable List type whose types are `t`.
;



Type! TypeOf(SemanticExpressionDict dict) :=
	1. *Let* `types` be a mapping of `dict` for each `prop` to *Unwrap:* `TypeOf(prop.children.1)`.
	2. *If* `types` contains `Nothing`:
		1. *Return:* `Nothing`.
	3. *Let* `t` be `Union(...types)`.
	4. *Return:* a new mutable Dict type whose types are `t`.
;



Type! TypeOf(SemanticExpressionSet set) :=
	1. *Let* `types` be a mapping of `set` for each `el` to *Unwrap:* `TypeOf(el)`.
	2. *If* `types` contains `Nothing`:
		1. *Return:* `Nothing`.
	3. *Let* `t` be *UnwrapAffirm:* `Union(...types)`.
	4. *Return:* a new mutable Set type whose types are `t`.
;



Type! TypeOf(SemanticExpressionMap map) :=
	1. *Let* `ant_types` be a mapping of `map` for each `case` to *Unwrap:* `TypeOf(case.children.0)`.
	2. *Let* `con_types` be a mapping of `map` for each `case` to *Unwrap:* `TypeOf(case.children.1)`.
	3. *If* `ant_types` contains `Nothing`:
		1. *Return:* `Nothing`.
	4. *If* `con_types` contains `Nothing`:
		1. *Return:* `Nothing`.
	5. *Let* `k` be *UnwrapAffirm:* `Union(...ant_types)`.
	6. *Let* `v` be *UnwrapAffirm:* `Union(...con_types)`.
	7. *Return:* a new mutable Map type whose antecedent types are `k` and whose consequent types are `v`.
;



Type! TypeOf(SemanticExpressionBlock block) :=
	1. *If* `block.children` contains any statement that contains any expression `expr` for which *UnwrapAffirm:* `IsBottomType(expr)` is `true`:
		1. *Return:* `Nothing`.
	2. *Assert:* `block.children.count` is greater than 0.
	3. *Let* `last_stmt` be `block.children.-1`.
	4. *If* `last_stmt` is not a SemanticStatementExpression:
		1. *Throw:* a new Error.
	5. *If* `last_stmt.children.count` is less than 1:
		1. *Throw:* a new Error.
	6. *Let* `expr` be `last_stmt.children.0`.
	7. *Assert:* `expr` is a SemanticExpression.
	8. *Return:* `TypeOf(expr)`.
;



Type! TypeOf(SemanticExpressionAccess[kind: RESULT] access) :=
	// TODO: implement
;

Type! TypeOf(SemanticExpressionAccess[kind: NORMAL | MAYBE] access) :=
	1. *Assert:* `access.children.count` is 2.
	2. *Let* `base` be `access.children.0`.
	3. *Let* `base_type` be *Unwrap:* `TypeOf(base)`.
	4. *If* *UnwrapAffirm:* `IsBottomType(base_type)` is `true`:
		1. *Return:* `Nothing`.
	5. *Let* `entry` be *Unwrap:* `GetEntryInfo(base_type, access, false)`.
	6. *If* `entry.type` is a Maybe type:
		1. *Set* `use_maybe` to `true`.
	7. *Else:*
		1. *Set* `use_maybe` to `false`.
	8. *Return:* `AccessType(access.kind, base_type, entry)`.
;



Type! TypeOf(SemanticExpressionCall call) :=
	1. *Assert:* `call.children.count` is greater than or equal to 1.
	2. *Let* `base` be `call.children.0`.
	3. *If* `base` is not a SemanticExpressionVariable:
		1. *Note:* Currently, the only allowed generics are `List.<T>(arg)`, `Dict.<T>(arg)`, `Set.<T>(arg)`, `Map.<K, V>(arg)`.
		2. *Throw:* a new TypeErrorNotCallable.
	4. *Let* `args` be a filtering of `call.children.slice(1)` for each `arg` such that `arg` is a SemanticExpression.
	5. *For each* `arg` in `args`:
		1. *Let* `t` be `t_arg`.
		2. *If* *UnwrapAffirm:* `IsBottomType(base_type)` is `true`:
			1. *Return:* `Nothing`.
	6. *If* `base.source` is one of "Integer", "Natural", "Float", or "String":
		1. *If* `call.children.count` is 2:
			1. *Let* `arg` be `call.children.1`.
			2. *If* `arg` is a SemanticExpression:
				1. *Let* `argtype` be *Unwrap:* `TypeOf(arg)`.
				2. *If* `base.source` is one of "Integer", "Natural", or "Float":
					1. *Perform:* *Unwrap:* `TypeCheckAssign(arg, Number)`.
				3. *If* `base.source` is "Integer":
					1. *Return:* `Integer`.
				4. *Else If* `base.source` is "Natural":
					1. *Return:* `Natural`.
				5. *Else If* `base.source` is "Float":
					1. *Return:* `Float`.
				6. *Else:*
					1. *Assert:* `base.source` is "String".
					2. *Return:* `String`.
			3. *Else:*
				1. *Throw:* a new TypeErrorArgCount.
		2. *Else:*
			1. *Throw:* a new TypeErrorArgCount.
	7. *Else If* `base.source` is one of "List", "Dict", or "Set":
		1. *If* `call.children.count` is 2 or 3:
			1. *If* `call.children.1` is a SemanticType:
				1. *Let* `genericarg` be *Unwrap:* `TypeValueOf(call.children.1)`.
				2. *If* `base.source` is "List":
					1. *Let* `returntype` be a List type under the type argument `genericarg`.
				3. *Else If* `base.source` is "Dict":
					1. *Let* `returntype` be a Dict type under the type argument `genericarg`.
				4. *Else If* `base.source` is "Set":
					1. *Let* `returntype` be a Set type under the type argument `genericarg`.
				5. *If* `call.children.count` is 3:
					1. *Let* `arg` be `call.children.2`.
					2. *If* `arg` is a SemanticExpression:
						1. *Let* `argtype` be *Unwrap:* `TypeOf(arg)`.
						2. *If* `base.source` is "List":
							1. *Let* `is_assignable` be `TypeCheckAssign(arg, returntype)`.
							2. *If* `is_assignable` is an abrupt completion:
								1. *If* `arg` is a SemanticExpressionTuple:
									1. *For each* `item` in `arg`:
										1. *Perform:* *Unwrap:* `TypeCheckAssign(item, genericarg)`.
								2. *Else If* `argtype` is a Tuple type:
									1. *Let* `items` be the union of all item types in `argtype`.
									2. *If* *UnwrapAffirm:* `Subtype(items, genericarg)` is `false`:
										1. *Throw:* a new TypeErrorNotNarrow.
								3. *Else:*
									1. *Throw:* a new TypeErrorNotAssignable.
							3. *Else:*
								1. Fall through.
						3. *Else If* `base.source` is "Dict":
							1. *Let* `is_assignable` be `TypeCheckAssign(arg, returntype)`.
							2. *If* `is_assignable` is an abrupt completion:
								1. *If* `arg` is a SemanticExpressionRecord:
									1. *For each* `prop` in `arg`:
										1. *Assert:* `prop.children.count` is 2.
										2. *Perform:* *Unwrap:* `TypeCheckAssign(prop.children.1, genericarg)`.
								2. *Else If* `argtype` is a Record type:
									1. *Let* `values` be the union of all value types in `argtype`.
									2. *If* *UnwrapAffirm:* `Subtype(values, genericarg)` is `false`:
										1. *Throw:* a new TypeErrorNotNarrow.
								3. *Else:*
									1. *Throw:* a new TypeErrorNotAssignable.
							3. *Else:*
								1. Fall through.
						4. *Else If* `base.source` is "Set":
							1. *Let* `listtype` be a List type under the type argument `genericarg`.
							2. *Let* `is_assignable` be `TypeCheckAssign(arg, listtype)`.
							3. *If* `is_assignable` is an abrupt completion:
								1. *If* `arg` is a SemanticExpressionTuple:
									1. *For each* `item` in `arg`:
										1. *Perform:* *Unwrap:* `TypeCheckAssign(item, genericarg)`.
								2. *Else If* `argtype` is a Tuple type:
									1. *Let* `items` be the union of all item types in `argtype`.
									2. *If* *UnwrapAffirm:* `Subtype(items, genericarg)` is `false`:
										1. *Throw:* a new TypeErrorNotNarrow.
								3. *Else:*
									1. *Throw:* a new TypeErrorNotAssignable.
							4. *Else:*
								1. Fall through.
					3. *Else:*
						1. *Throw:* a new TypeErrorArgCount.
				6. *Return:* a mutable copy of `returntype`.
			2. *Else:*
				1. Fall through.
		2. *Throw:* a new TypeErrorArgCount.
	8. *Else If* `base.source` is "Map":
		1. *If* `call.children.count` is 2 or 3 or 4:
			1. *If* `call.children.1` is a SemanticType:
				1. *Let* `antecedenttype` be *Unwrap:* `TypeValueOf(call.children.1)`.
				2. *If* `call.children.count` is 2:
					1. *Note:* The call looks like "Map.<K>()".
					2. *Let* `consequenttype` be `antecedenttype`.
				3. *Else If* `call.children.count` is 3:
					1. *If* `call.children.2` is a SemanticType:
						1. *Note:* The call looks like "Map.<K, V>()".
						2. *Let* `consequenttype` be *Unwrap:* `TypeValueOf(call.children.2)`.
					2. *Else:*
						1. *Assert:* `call.children.2` is a SemanticExpression.
						2. *Note:* The call looks like "Map.<K>(arg)".
						3. *Let* `consequenttype` be `antecedenttype`.
						4. *Let* `arg` be `call.children.2`.
						5. *Let* `argtype` be *Unwrap:* `TypeOf(arg)`.
				4. *Else:*
					1. *Assert:* `call.children.count` is 4.
					2. *If* `call.children.2` is a SemanticType *and* `call.children.3` is a SemanticExpression:
						1. *Note:* The call looks like "Map.<K, V>(arg)".
						2. *Let* `consequenttype` be *Unwrap:* `TypeValueOf(call.children.2)`.
						3. *Let* `arg` be `call.children.3`.
						4. *Let* `argtype` be *Unwrap:* `TypeOf(arg)`.
					3. *Else:*
						1. *Throw:* a new TypeErrorArgCount.
				5. *Let* `entrytype` be a Tuple type containing the items in the Sequence [
					EntryTypeSchema [type= `antecedenttype`, optional= `false`],
					EntryTypeSchema [type= `consequenttype`, optional= `false`],
				].
				6. *Let* `paramtype` be a List type under the type argument `entrytype`.
				7. *If* `arg` is set:
					1. *Let* `is_assignable` be `TypeCheckAssign(arg, paramtype)`.
					2. *If* `is_assignable` is an abrupt completion:
						1. *If* `arg` is a SemanticExpressionTuple:
							1. *For each* `item` in `arg`:
								1. *Perform:* *Unwrap:* `TypeCheckAssign(item, entrytype)`.
						2. *Else If* `argtype` is a Tuple type:
							1. *Let* `items` be the union of all item types in `argtype`.
							2. *If* *UnwrapAffirm:* `Subtype(items, entrytype)` is `false`:
								1. *Throw:* a new TypeErrorNotNarrow.
						3. *Else:*
							1. *Throw:* a new TypeErrorNotAssignable.
					3. *Else:*
						1. Fall through.
				8. *Return:* a mutable Map type under an antecedent type argument `antecedenttype`
					and a consequent type argument `consequenttype`.
			2. *Else:*
				1. Fall through.
		2. *Throw:* a new TypeErrorArgCount.
	9. *Else:*
		// TODO: see Class API
;



Type! TypeOf(SemanticExpressionClaim claim) :=
	1. *Note:* This algorithm overrides `TypeOf(SemanticExpression)`.
	2. *Assert:* `claim.children.count` is 2.
	3. *Let* `computed_type` be *Unwrap:* `TypeOf(claim.children.0)`.
	4. *Let* `claimed_type` be *Unwrap:* `TypeValueOf(claim.children.1)`.
	5. *If* *UnwrapAffirm:* `AreDisjoint(computed_type, claimed_type)` is `true` *and* *UnwrapAffirm:* `IsBottomType(computed_type)` is `false` *and* *UnwrapAffirm:* `IsBottomType(claimed_type)` is `false`:
		1. *Throw:* a new TypeErrorNotAssignable.
	6. *Return:* `claimed_type`.
;



Type! TypeOf(SemanticExpressionIsset expr) :=
	1. *Assert:* `expr.children.count` is 1.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	4. *Else:*
		1. *Return:* `Boolean`.
;



Type! TypeOf(SemanticExpressionOperation[operator: UN_MAYBE] ::= SemanticExpression) :=
	1. *Let* `operand` be *Unwrap:* `TypeOf(SemanticExpression)`.
	2. *If* `operand` is not a Maybe type:
		1. *Throw:* a new TypeErrorInvalidOperation.
	3. *Let* `valuetype` be the type argument to `operand`.
	4. *Return:* `valuetype`.
;

Type! TypeOf(SemanticExpressionOperation[operator: UN_MAYBE] ::= SemanticExpression) :=
	// TODO:
;

Type! TypeOf(SemanticExpressionOperation[operator: NOT] expr) :=
	1. *Assert:* `expr.children.count` is 1.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	4. *If* *UnwrapAffirm:* `IsDefinitelyFalsy(t0)` is `true`:
		1. *Return:* `ToType(true)`.
	5. *Else If* *UnwrapAffirm:* `IsDefinitelyTruthy(t0)` is `true`:
		1. *Return:* `ToType(false)`.
	6. *Else:*
		1. *Return:* `Boolean`.
;

Type! TypeOf(SemanticExpressionOperation[operator: EMP] expr) :=
	1. *Assert:* `expr.children.count` is 1.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	4. *Else If* *UnwrapAffirm:* `IsDefinitelyFalsy(t0)` is `true`:
		1. *Return:* `ToType(true)`.
	5. *Else:*
		1. *Return:* `Boolean`.
;

Type! TypeOf(SemanticExpressionOperation[operator: NEG] expr) :=
	1. *Assert:* `expr.children.count` is 1.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	4. *Else If* *UnwrapAffirm:* `Subtype(t0, Union(Integer, Float))` is `true`:
		1. *Return:* `t0`.
	5. *Else:*
		1. *Throw:* a new TypeErrorInvalidOperation.
;

Type! TypeOf(SemanticExpressionOperation[operator: IS] ::= SemanticExpression__0 SemanticExpression__1[type: Class]) :=
	1. *Let* `t0` be *Unwrap:* `TypeOf(SemanticExpression__0)`.
	2. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	3. *Return:* `Boolean`.
;

Type! TypeOf(SemanticExpressionOperation[operator: EXP | MUL | DIV | ADD | SUB] expr) :=
	1. *Assert:* `expr.children.count` is 2.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *Let* `t1` be *Unwrap:* `TypeOf(expr.children.1)`.
	4. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true` *or* *UnwrapAffirm:* `IsBottomType(t1)` is `true`:
		1. *Return:* `Nothing`.
	5. *Else If* *UnwrapAffirm:* `Subtype(t0, Integer)` is `true` *and* *UnwrapAffirm:* `Subtype(t1, Integer)` is `true`:
		1. *Return:* `Integer`.
	6. *Else If* *UnwrapAffirm:* `Subtype(t0, Natural)` is `true` *and* *UnwrapAffirm:* `Subtype(t1, Natural)` is `true`:
		1. *Return:* `Natural`.
	7. *Else If* *UnwrapAffirm:* `Subtype(t0, Float)` is `true` *and* *UnwrapAffirm:* `Subtype(t1, Float)` is `true`:
		1. *Return:* `Float`.
	8. *Else:*
		1. *Throw:* a new TypeErrorInvalidOperation.
;

Type! TypeOf(SemanticExpressionOperation[operator: LT | GT | LE | GE] expr) :=
	1. *Assert:* `expr.children.count` is 2.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *Let* `t1` be *Unwrap:* `TypeOf(expr.children.1)`.
	4. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true` *or* *UnwrapAffirm:* `IsBottomType(t1)` is `true`:
		1. *Return:* `Nothing`.
	5. *Else If* *UnwrapAffirm:* `Subtype(t0, Number)` is `true` *and* *UnwrapAffirm:* `Subtype(t1, Number)` is `true`:
		1. *Return:* `Boolean`.
	6. *Else:*
		1. *Throw:* a new TypeErrorInvalidOperation.
;

Type! TypeOf(SemanticExpressionOperation[operator: IS] expr) :=
	// TODO: implement
;

Type! TypeOf(SemanticExpressionOperation[operator: ID | EQ] expr) :=
	1. *Assert:* `expr.children.count` is 2.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *Let* `t1` be *Unwrap:* `TypeOf(expr.children.1)`.
	4. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true` *or* *UnwrapAffirm:* `IsBottomType(t1)` is `true`:
		1. *Return:* `Nothing`.
	5. *If* *UnwrapAffirm:* `AreDisjoint(t0, t1)` is `true`:
		1. *If* `operator` is `ID`:
			1. *Return:* `ToType(false)`.
		2. *If* *UnwrapAffirm:* `AreDisjoint(t0, Number)` is `true` *or* *UnwrapAffirm:* `AreDisjoint(t1, Number)` is `true`:
			1. *Return:* `ToType(false)`.
	6. *Return:* `Boolean`.
;

Type! TypeOf(SemanticExpressionOperation[operator: AND] expr) :=
	1. *Assert:* `expr.children.count` is 2.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *Let* `t1` be *Unwrap:* `TypeOf(expr.children.1)`.
	4. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	5. *If* *UnwrapAffirm:* `IsDefinitelyFalsy(t0)` is `true`:
		1. *Return:* `t0`.
	6. *Else If* *UnwrapAffirm:* `IsDefinitelyTruthy(t0)` is `true`:
		1. *Return:* `t1`.
	7. *Else:*
		1. *Return:* `Union(FalsySide(t0), t1)`.
;

Type! TypeOf(SemanticExpressionOperation[operator: OR] expr) :=
	1. *Assert:* `expr.children.count` is 2.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *Let* `t1` be *Unwrap:* `TypeOf(expr.children.1)`.
	4. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	5. *If* *UnwrapAffirm:* `IsDefinitelyFalsy(t0)` is `true`:
		1. *Return:* `t1`.
	6. *Else If* *UnwrapAffirm:* `IsDefinitelyTruthy(t0)` is `true`:
		1. *Return:* `t0`.
	7. *Else:*
		1. *Return:* `Union(TruthySide(t0), t1)`.
;

Type! TypeOf(SemanticExpressionOperation[operator: COND] expr) :=
	1. *Assert:* `expr.children.count` is 3.
	2. *Let* `t0` be *Unwrap:* `TypeOf(expr.children.0)`.
	3. *Let* `t1` be *Unwrap:* `TypeOf(expr.children.1)`.
	4. *Let* `t2` be *Unwrap:* `TypeOf(expr.children.2)`.
	5. *If* *UnwrapAffirm:* `IsBottomType(t0)` is `true`:
		1. *Return:* `Nothing`.
	6. *If* *UnwrapAffirm:* `Subtype(t0, Boolean)` is `true`:
		1. *If* `t0` is `ToType(false)`:
			1. *Return:* `t2`.
		2. *If* `t0` is `ToType(true)`:
			1. *Return:* `t1`.
		3. *Return:* `Union(t1, t2)`.
	7. *Else:*
		1. *Throw:* a new TypeErrorInvalidOperation.
;



Type! TypeOf(SemanticExpressionSwitch ::= SemanticExpression__0 SemanticCase* SemanticExpression__1) :=
	1. *Let* `t_value` be *Unwrap:* `TypeOf(SemanticExpression__0)`.
	2. *If* *UnwrapAffirm:* `IsBottomType(t_value)` is `true`:
		1. *Return:* `Nothing`.
	3. *Let* `union` be `Nothing`.
	4. *For each* `case` in `SemanticCase*`:
		1. *Assert:* `case` matches `SemanticCase ::= SemanticExpression__2+ SemanticExpression__3`.
		2. *For each* `ant` in `SemanticExpression__2+`:
			1. *Perform:* *Unwrap:* `TypeOf(ant)`;
		3. *Let* `t_con` be *Unwrap:* `TypeOf(SemanticExpression__3)`.
		4. *Set* `union` to *UnwrapAffirm:* `Union(union, t_con)`.
	5. *Let* `t_default` be *Unwrap:* `TypeOf(SemanticExpression__1)`.
	6. *Set* `union` to *UnwrapAffirm:* `Union(union, t_default)`.
	7. *Return:* `union`.
;



Type ToType(Or<Null, Boolean, Symbol, Number, String> v) :=
	1. *Return:* a new Type containing only the value `v`.
;
