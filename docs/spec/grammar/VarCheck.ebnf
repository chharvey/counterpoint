Nil! VarCheck(Or<
	SemanticKey,
	SemanticPropertyType,
	SemanticProperty,
	SemanticCase,
	SemanticType,
	SemanticExpression,
	SemanticStatementExpression,
	SemanticStatementClaim,
	SemanticStatementConditional,
	SemanticGoal,
> list) :=
	1. *For each* `it` in `list.children`:
		1. *Perform:* *Unwrap:* `VarCheck(it)`.
;



Nil! VarCheck(Or<SemanticTypeRecord, SemanticExpressionRecord, SemanticExpressionDict> assoc) :=
	1. *Note:* In keyed collection literals, all keys are var-checked before all values.
	2. *For each* `prop` in `assoc.children`:
		1. *Let* `key` be `prop.children.0`.
		2. *Perform:* *Unwrap:* `VarCheck(key)`.
		3. *If* `assoc.children` already contains a property `prop_dupe` such that `prop_dupe.children.0.id` is `key.id`:
			1. *Throw:* a new AssignmentErrorDuplicateKey.
	3. *For each* `prop` in `assoc.children`:
		1. *Peform:* *Unwrap:* `VarCheck(prop.children.1)`.
;



Nil! VarCheck(SemanticTypeAlias var) :=
	1. *Note:* Skip var-checking of `var` for now if source is "Object", as semantics is determined by syntax.
	2. *If* `var.source` is "Object":
		1. *Return.*
	3. *If* the validator’s symbol table does not contain a SymbolSchema `symbol` whose `id` is `var.id`:
		1. *Throw:* a new ReferenceErrorUndeclared.
	// TODO: Throw a ReferenceErrorDeadZone if the variable is declared further down in source.
	4. *If* `symbol` is not an instance of `SymbolSchemaType`:
		1. *Throw:* a new ReferenceErrorKind.
;



Nil! VarCheck(SemanticTypeCall call) :=
	1. *Note:* Skip var-checking of `call.children.0` for now, as semantics is determined by syntax.
	2. *If* `call.children.0.source` is not one of "List", "Dict", "Set", or "Map":
		1. *Throw:* a new SyntaxError.
	3. *For each* `it` in `call.children[1..]`:
		1. *Perform:* *Unwrap:* `VarCheck(it)`.
;



Nil! VarCheck(SemanticExpressionVariable var) :=
	1. *If* the validator’s symbol table does not contain a SymbolSchema `symbol` whose `id` is `var.id`:
		1. *Throw:* a new ReferenceErrorUndeclared.
	// TODO: Throw a ReferenceErrorDeadZone if the variable is declared further down in source.
	2. *If* `symbol` is not an instance of `SymbolSchemaVar`:
		1. *Throw:* a new ReferenceErrorKind.
;



Nil! VarCheck(SemanticExpressionCall call) :=
	1. *Note:* Skip var-checking of `call.children.0` for now, as semantics is determined by syntax.
	2. *If* `call.children.0.source` is not one of "List", "Dict", "Set", or "Map":
		1. *Throw:* a new SyntaxError.
	3. *For each* `it` in `call.children[1..]`:
		1. *Perform:* *Unwrap:* `VarCheck(it)`.
;



Nil! VarCheck(SemanticDeclarationType decl) :=
	1. *Perform:* *Unwrap:* `VarCheck(decl.children.0)`.
	2. *If* the validator’s symbol table contains a SymbolSchema whose `id` is `decl.id`:
		1. *Throw:* a new AssignmentErrorDuplicateDeclaration.
	3. *Else:*
		1. *Let* `symbol` be a new SymbolSchemaType [
			id=        `decl.id`,
			typevalue= `Anything`,
		].
		2. Add `symbol` as a record for `id` to the validator.
;



Nil! VarCheck(SemanticDeclarationVariable decl) :=
	1. *Let* `uninitialized` be `true`.
	2. *Let* `typenode` be an item `child` in `decl.children` such that `child` is a SemanticType.
	3. *Let* `assigned` be an item `child` in `decl.children` such that `child` is a SemanticExpression.
	4. *If* `decl.writable` is `false`:
		1. *Assert:* `assigned` is not *nil*.
		2. *Note:* We can make this assertion due to the language syntax.
	5. *Else:*
		1. Fall through.
	6. *Assert:* `typenode` is not *nil*.
	7. *Perform:* *Unwrap:* `VarCheck(typenode)`.
	8. *If* `assigned` is not *nil*:
		1. *Set* `uninitialized` to `false`.
		2. *Perform:* *Unwrap:* `VarCheck(assigned)`.
	9. *Else:*
		1. Fall through.
	10. *If* `decl.id` is not *nil*:
		1. *If* the validator’s symbol table contains a SymbolSchema whose `id` is `decl.id`:
			1. *Throw:* a new AssignmentErrorDuplicateDeclaration.
		2. *Else:*
			1. *Let* `symbol` be a new SymbolSchemaVar [
				id=              `decl.id`,
				isWritable=      `decl.writable`,
				isUninitialized= `uninitialized`,
				type=            `Anything`,
			].
			2. Add `symbol` as a record for `decl.id` to the validator.
	11. *Else:*
		1. *Return.*
;



Nil! VarCheck(SemanticStatementReassignment ::= SemanticExpressionVariable) :=
	1. *Perform:* *Unwrap:* `VarCheck(SemanticExpressionVariable)`.
	2. *Assert:* The validator’s symbol table contains a SymbolSchema `symbol` whose `id` is `assignee.id`.
	3. *Assert:* `symbol` is an instance of `SymbolSchemaVar`.
	4. *If* `symbol.isUninitialized` is `false`:
		1. *Throw:* a new AssignmentErrorDeletion.
	5. *Else:*
		1. Fall through.
	6. *Return.*
;
Nil! VarCheck(SemanticStatementReassignment ::= SemanticExpressionVariable SemanticExpression) :=
	1. *Perform:* *Unwrap:* `VarCheck(SemanticExpressionVariable)`.
	2. *Perform:* *Unwrap:* `VarCheck(SemanticExpression)`.
	3. *Assert:* The validator’s symbol table contains a SymbolSchema `symbol` whose `id` is `assignee.id`.
	4. *Assert:* `symbol` is an instance of `SymbolSchemaVar`.
	5. *If* `symbol.isWritable` is `false`:
		1. *Throw:* a new AssignmentErrorReassignment.
	6. *Else:*
		1. Fall through.
	7. *Return.*
;
Nil! VarCheck(SemanticStatementReassignment ::= SemanticExpressionAccess) :=
	1. *Perform:* *Unwrap:* `VarCheck(SemanticExpressionAccess)`.
	2. *Return.*
;
Nil! VarCheck(SemanticStatementReassignment ::= SemanticExpressionAccess SemanticExpression) :=
	1. *Perform:* *Unwrap:* `VarCheck(SemanticExpressionAccess)`.
	2. *Perform:* *Unwrap:* `VarCheck(SemanticExpression)`.
	3. *Return.*
;



Nil! VarCheck(SemanticStatementLoop stmt) :=
	1. *Let* `condition` be an item `child` in `stmt.children` such that `child` is a SemanticExpression.
	2. *Let* `block`     be an item `child` in `stmt.children` such that `child` is a SemanticBlock.
	3. *Assert:* `condition` is not *nil*.
	4. *Assert:* `block`     is not *nil*.
	5. *If* `stmt.doFirst` is `true`:
		1. *Perform:* *Unwrap:* `VarCheck(block)`.
		2. *Perform:* *Unwrap:* `VarCheck(condition)`.
	6. *Else:*
		1. *Perform:* *Unwrap:* `VarCheck(condition)`.
		2. *Perform:* *Unwrap:* `VarCheck(block)`.
;



Nil! VarCheck(SemanticStatementIteration stmt) :=
	1. *Let* `typenode` be an item `child` in `stmt.children` such that `child` is a SemanticType.
	2. *Let* `iterable` be an item `child` in `stmt.children` such that `child` is a SemanticExpression.
	3. *Let* `block`    be an item `child` in `stmt.children` such that `child` is a SemanticBlock.
	4. *Assert:* `typenode` is not *nil*.
	5. *Perform:* *Unwrap:* `VarCheck(typenode)`.
	6. *Assert:* `iterable` is not *nil*.
	7. *Perform:* *Unwrap:* `VarCheck(iterable)`.
	8. *Assert:* `block` is not *nil*.
	9. *If* `stmt.id` is not *nil*:
		1. *Let* `validator` be the validator of `block`.
		2. *If* `validator`’s symbol table contains a SymbolSchema whose `id` is `stmt.id`:
			1. *Throw:* a new AssignmentErrorDuplicateDeclaration.
		3. *Else:*
			1. *Let* `symbol` be a new SymbolSchemaVar [
				id=              `stmt.id`,
				isWritable=      `false`,
				isUninitialized= `false`,
				type=            `Anything`,
			].
			2. Add `symbol` as a record for `stmt.id` to `validator`.
	10. *Else:*
		1. Fall through.
	11. *Perform:* *Unwrap:* `VarCheck(block)`.
;
